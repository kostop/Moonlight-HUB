+  // owner/x/y：要恢复的本机及物理像素位置；投影到最近的有效显示器，避开多屏空洞。
+  std::optional<Destination> nearestPosition(const std::string &owner, int32_t x, int32_t y)
+  {
+    refresh();
+    std::optional<Destination> nearest;
+    double distance = std::numeric_limits<double>::max();
+    for (const auto &monitor : m_monitors) {
+      if (monitor.owner != owner) continue;
+      const double px = std::clamp(static_cast<double>(x), monitor.nativeX, monitor.nativeX + monitor.w - 1);
+      const double py = std::clamp(static_cast<double>(y), monitor.nativeY, monitor.nativeY + monitor.h - 1);
+      const double dx = px - x, dy = py - y;
+      const double candidate = dx * dx + dy * dy;
+      if (candidate < distance) {
+        nearest = Destination{owner, static_cast<int32_t>(px), static_cast<int32_t>(py)};
+        distance = candidate;
+      }
+    }
+    return nearest;
+  }
+
 private:
   struct Monitor {
     std::string owner;
