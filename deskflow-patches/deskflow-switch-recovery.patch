+// 执行当前生产 Server 方法；只模拟客户端/配置/计时器边界，不安装钩子或注入输入。
+#define LOG_DEBUG1(...) ((void)0)
+#define LOG_DEBUG2(...) ((void)0)
+#define LOG_DEBUG(...) ((void)0)
+#define LOG_INFO(...) ((void)0)
+#define LOG_WARN(...) ((void)0)
+#define LOG_NOTE(...) ((void)0)
+#define LOG_ERR(...) std::fprintf(stderr, __VA_ARGS__)
+#define LOG(...) ((void)0)
+
+namespace {
+int checks = 0;
+using ClipboardID = uint8_t;
+void check(bool success, const char *message)
+{
+  ++checks;
+  if (!success) { std::fprintf(stderr, "FAIL: %s\n", message); std::exit(1); }
+}
+struct Point { int32_t x, y; };
+struct FakeClipboard { std::string marshall() const { return {}; } };
+struct BaseClientProxy {
+  std::string name;
+  std::vector<Point> positions;
+  std::vector<ButtonID> pressed, released;
+  int enters = 0;
+  bool leaveAllowed = true;
+  mutable int leaves = 0;
+  int32_t left=0, top=0, shapeWidth=300, shapeHeight=100;
+  Point bookmark{70,40};
+  explicit BaseClientProxy(const char *value) : name(value) {}
+  const std::string &getName() const { return name; }
+  void getShape(int32_t &x, int32_t &y, int32_t &width, int32_t &height) const
+  { x = left; y = top; width = shapeWidth; height = shapeHeight; }
+  void mouseDown(ButtonID button) { pressed.push_back(button); }
+  void mouseUp(ButtonID button) { released.push_back(button); }
+  void mouseMove(int32_t x, int32_t y) { positions.push_back({x, y}); }
+  void mouseRelativeMove(int32_t, int32_t) { std::abort(); }
+  bool leave() const { ++leaves; return leaveAllowed; }
+  void setJumpCursorPos(int32_t x,int32_t y) {bookmark={x,y};}
+  void getJumpCursorPos(int32_t &x,int32_t &y) const {x=bookmark.x;y=bookmark.y;}
+  void enter(int32_t x, int32_t y, uint32_t, KeyModifierMask, bool)
+  { ++enters; positions.push_back({x, y}); }
+  void setClipboard(int, const FakeClipboard *) {}
+  void screensaver(bool) {}
+};
+struct PrimaryClient : BaseClientProxy {
+  bool platformHeld = false;
+  mutable int centers = 0;
+  PrimaryClient() : BaseClientProxy("A") {}
+  bool isLockedToScreen() const { return platformHeld; }
+  int32_t getJumpZoneSize() const { return 1; }
+  KeyModifierMask getToggleMask() const { return 0; }
+  void getCursorCenter(int32_t &x, int32_t &y) const { ++centers; x = y = 50; }
+  void reconfigure(uint32_t) {}
+};
+struct Config {
+  using ScreenOptions = std::map<int, int>;
+  const ScreenOptions *getOptions(const std::string &) const { return nullptr; }
+};
+constexpr int kOptionScreenSwitchCorners = 1, kOptionScreenSwitchCornerSize = 2;
+constexpr int kClipboardEnd = 2;
+enum class EventTypes { ServerScreenSwitched };
+struct Event {
+  template<class T> Event(EventTypes, void *, T *info) { delete info; }
+};
+struct EventQueue { void addEvent(Event) {} };
+}
+
+class Server {
+public:
+  using ClientList = std::map<std::string, BaseClientProxy *>;
+  struct SwitchToScreenInfo { explicit SwitchToScreenInfo(const std::string &) {} };
+  struct ClipboardInfo { FakeClipboard m_clipboard; std::string m_clipboardOwner; uint32_t m_clipboardSeqNum = 0; };
+  PrimaryClient *m_primaryClient;
+  BaseClientProxy *m_active;
+  BaseClientProxy *m_activeSaver = nullptr;
+  BaseClientProxy *m_switchScreen = nullptr;
+  std::map<std::string, BaseClientProxy *> m_clients;
+  MonitorTopologyRouter m_monitorRouter;
+  std::bitset<NumButtonIDs> m_pressedMouseButtons;
+  BaseClientProxy *legacyDestination = nullptr;
+  Config config;
+  Config *m_config = &config;
+  EventQueue events;
+  EventQueue *m_events = &events;
+  bool m_lockedToScreen = false, m_disableLockToScreen = false, m_defaultLockToScreenState = false;
+  bool m_relativeMoves = false, m_enableClipboard = false;
+  bool m_switchNeedsShift = false, m_switchNeedsControl = false, m_switchNeedsAlt = false;
+  double m_switchTwoTapDelay = 0, m_switchWaitDelay = 0;
+  Direction m_switchDir = Direction::NoDirection;
+  bool timer = false;
+  int startedTimers = 0;
+  int32_t m_x = 50, m_y = 50, m_xDelta = 0, m_yDelta = 0, m_xDelta2 = 0, m_yDelta2 = 0;
+  struct PrimaryCursorPosition { int32_t x = 0, y = 0; bool valid = false; };
+  PrimaryCursorPosition m_primaryCursorPosition;
+  int32_t m_switchWaitX = 0, m_switchWaitY = 0;
+  int32_t m_xSaver = 0, m_ySaver = 0;
+  uint32_t m_seqNum = 0;
+  int m_maximumClipboardSize = 1024;
+  ClipboardInfo m_clipboards[kClipboardEnd];
+
+  Server(PrimaryClient &primary, BaseClientProxy &remote) : m_primaryClient(&primary), m_active(&primary)
+  { m_clients.emplace(primary.name, &primary); m_clients.emplace(remote.name, &remote); }
+  std::string getName(const BaseClientProxy *client) const { return client->name; }
+  int32_t getJumpZoneSize(const BaseClientProxy *client) const { return client == m_primaryClient ? 1 : 0; }
+  int getCorner(const BaseClientProxy *, int32_t, int32_t, int32_t) const { return 0; }
+  uint32_t getActivePrimarySides() const { return 0; }
+  bool isSwitchTwoTapStarted() const { return false; }
+  bool shouldSwitchTwoTap() const { return false; }
+  void startSwitchTwoTap() {}
+  void stopSwitchTwoTap() {}
+  bool isSwitchWaitStarted() const { return timer; }
+  void startSwitchWait(int32_t x, int32_t y) { timer = true; ++startedTimers; m_switchWaitX = x; m_switchWaitY = y; }
+  void stopSwitchWait() { timer = false; }
+  void noSwitch(int32_t, int32_t) { stopSwitchWait(); }
+  void onClipboardChanged(const BaseClientProxy *, int, uint32_t) {}
+
+  // 参数 client/dir/x/y：只提供旧布局的相邻电脑，真实切屏守卫由生产方法执行。
+  BaseClientProxy *mapToNeighbor(BaseClientProxy *client, Direction dir, int32_t &x, int32_t &y)
+  {
+    (void)y;
+    if (legacyDestination != nullptr) { if(dir==Direction::Right) x-=300; else if(dir==Direction::Left) x+=300; return legacyDestination; }
+    const auto destination = client == m_primaryClient ? m_clients.find("B") : m_clients.find("A");
+    if (destination == m_clients.end()) return nullptr;
+    if (dir == Direction::Right) x -= 300;
+    else if (dir == Direction::Left) x += 300;
+    return destination->second;
+  }
+  bool isLockedToScreenServer() const;
+  bool isLockedToScreen() const;
+  bool isMouseButtonHeld() const;
+  bool isSwitchOkay(BaseClientProxy *, Direction, int32_t, int32_t, int32_t, int32_t);
+  void stopSwitch();
+  void handleSwitchWaitTimeout();
+  void onMouseDown(ButtonID);
+  void onMouseUp(ButtonID);
+  bool onMouseMovePrimary(int32_t, int32_t);
+  void onMouseMoveSecondary(int32_t, int32_t);
+  void switchScreen(BaseClientProxy *, int32_t, int32_t, bool);
+  void rememberPrimaryPosition(int32_t, int32_t);
+  void getPrimaryRecoveryPosition(int32_t &, int32_t &);
+  void forceLeaveClient(const BaseClientProxy *);
+  void jumpToScreen(BaseClientProxy *);
+  void onScreensaver(bool);
+};
+
+// 脚本从当前源文件提取完整方法体，禁止手工维护待测逻辑副本。
+#include "mouse-recovery-production.inc"
+
+// 参数 owner/nativeX/canvasX：所属电脑、本机像素原点及共享画布原点。
+QJsonObject monitor(const char *owner, int nativeX, int canvasX)
+{
+  return {{"owner", owner}, {"id", QString::number(nativeX)}, {"nativeX", nativeX}, {"nativeY", 0},
+          {"x", canvasX}, {"y", 0}, {"width", 100}, {"height", 100},
+          {"canvasWidth", 100}, {"canvasHeight", 100}, {"active", true}};
+}
+
+int main(int argc, char **argv)
+{
+  QCoreApplication application(argc, argv);
+  QTemporaryFile layout;
+  check(layout.open(), "recovery topology fixture opens");
+  const auto writeLayout = [&](const QJsonArray &monitors) {
+    layout.resize(0); layout.seek(0);
+    layout.write(QJsonDocument(QJsonObject{{"monitors",monitors}}).toJson()); layout.flush();
+  };
+  const QJsonArray original{monitor("A",0,0),monitor("A",200,100),monitor("B",0,200)};
+  writeLayout(original);
+  qputenv("DESKFLOW_MONITOR_TOPOLOGY",layout.fileName().toUtf8());
