+          "each valid press cancels an older pending cross-screen timer");
+    // 平台已提前读到松开，队列中先前的拖动仍应由服务端 FIFO 按钮记录保护。
+    check(!primary.platformHeld, "fixture exercises FIFO ownership without a current platform press");
+    check(!server.onMouseMovePrimary(304, 50) && server.m_active == &primary && server.m_x == 299,
+          "held primary motion cannot cross and remains on the current monitor edge");
+    check(remote.enters == 0 && remote.pressed.empty(), "blocked primary crossing never enters or clicks the peer");
+    server.onMouseUp(button);
+    check(!server.isMouseButtonHeld() && server.m_active == &primary && !server.timer,
+          "release removes ownership without starting a delayed or automatic crossing");
+    server.handleSwitchWaitTimeout();
+    check(server.m_active == &primary, "a stale timer after release has no destination to switch to");
+    check(server.onMouseMovePrimary(304, 50) && server.m_active == &remote,
+          "a new primary movement after release crosses normally");
+    check(primary.pressed == std::vector<ButtonID>{button} && primary.released == std::vector<ButtonID>{button},
+          "press and release both stay on the original computer");
+
+    PrimaryClient source; BaseClientProxy target("B"); Server reverse(source, target);
+    reverse.m_active = &target; reverse.m_x = 0; reverse.m_y = 50;
+    reverse.onMouseDown(button);
+    reverse.onMouseMoveSecondary(-5, 0);
+    check(reverse.m_active == &target && reverse.m_x == 0 && source.enters == 0,
+          "held remote motion cannot return to the source or move beyond the current monitor edge");
+    reverse.onMouseUp(button);
+    check(reverse.m_active == &target, "remote release alone does not cross back");
+    reverse.onMouseMoveSecondary(-5, 0);
+    check(reverse.m_active == &source, "new remote movement after release can return normally");
+    check(target.pressed == std::vector<ButtonID>{button} && target.released == std::vector<ButtonID>{button},
+          "remote drag press and release are delivered to the same peer");
+  }
+
+  PrimaryClient primary; BaseClientProxy remote("B"); Server combined(primary, remote);
+  combined.m_x = 299;
