+  int32_t getJumpZoneSize(const BaseClientProxy *client) const { return client == m_primaryClient ? 1 : 0; }
+  int getCorner(const BaseClientProxy *, int32_t, int32_t, int32_t) const { return 0; }
+  uint32_t getActivePrimarySides() const { return 0; }
