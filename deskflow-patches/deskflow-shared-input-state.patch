+
+  PrimaryClient saverSource; BaseClientProxy saverPeer("B"); Server safetyReturn(saverSource, saverPeer);
+  safetyReturn.m_active = &saverPeer; safetyReturn.onMouseDown(kButtonLeft); saverSource.platformHeld = true;
