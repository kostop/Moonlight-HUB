diff --git a/tools/test-key-refresh.cpp b/tools/test-key-refresh.cpp
new file mode 100644
--- /dev/null
+++ b/tools/test-key-refresh.cpp
@@ -0,0 +1,199 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception */
+#include "deskflow/KeyState.h"
+#include "base/Log.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+namespace {
+struct Modifier
+{
+  KeyID id;
+  KeyButton button;
+  KeyModifierMask mask;
+  uint32_t client;
+};
+constexpr std::array modifiers{
+    Modifier{kKeyControl_L, 0x1d, KeyModifierControl, 0xa2},
+    Modifier{kKeyControl_R, 0x11d, KeyModifierControl, 0xa3},
+    Modifier{kKeyAlt_L, 0x38, KeyModifierAlt, 0xa4},
+    Modifier{kKeyAlt_R, 0x138, KeyModifierAlt | KeyModifierAltGr, 0xa5},
+    Modifier{kKeyShift_L, 0x2a, KeyModifierShift, 0xa0},
+    Modifier{kKeyShift_R, 0x36, KeyModifierShift, 0xa1},
+    Modifier{kKeySuper_L, 0x15b, KeyModifierSuper, 0x5b},
+    Modifier{kKeySuper_R, 0x15c, KeyModifierSuper, 0x5c},
+};
+int checks = 0;
+
+// 参数 success：断言结果；message：失败时输出的行为说明。
+void check(bool success, const char *message)
+{
+  ++checks;
+  if (!success) {
+    std::fprintf(stderr, "FAIL: %s\n", message);
+    std::exit(1);
+  }
+}
+
+// 使用实际 KeyMap 查找、修饰状态映射和事件生成，不覆盖 mapKey。
+// 参数 map：填入真实左右修饰键映射，供生产 KeyMap 直接执行。
+void populateMap(deskflow::KeyMap &map)
+{
+  for (const auto &modifier : modifiers) {
+    deskflow::KeyMap::KeyItem item{};
+    item.m_id = modifier.id;
+    item.m_button = modifier.button;
+    item.m_generates = modifier.mask;
+    item.m_client = modifier.client;
+    map.addKeyEntry(item);
+  }
+  map.finish();
+}
+
+class RefreshState : public KeyState
+{
+public:
+  explicit RefreshState(deskflow::KeyMap &map) : KeyState(nullptr, map, {"en"}, false) {}
+  KeyButtonSet systemDown;
+  std::vector<deskflow::KeyMap::Keystroke::Button> emitted;
+
+  int32_t pollActiveGroup() const override { return 0; }
+  KeyModifierMask pollActiveModifiers() const override
+  {
+    KeyModifierMask mask = 0;
+    for (const auto &modifier : modifiers) {
+      if (getKeyState(modifier.button) > 0) mask |= modifier.mask;
+    }
+    return mask;
+  }
+  bool fakeCtrlAltDel() override { return false; }
+  void pollPressedKeys(KeyButtonSet &keys) const override { keys = systemDown; }
+
+  // 参数 button/down：模拟已由操作系统接收的真实实体事件，不注入桌面。
+  void physical(KeyButton button, bool down)
+  {
+    if (down) systemDown.insert(button);
+    else systemDown.erase(button);
+    onKey(button, down, pollActiveModifiers());
+  }
+
+  // 参数 button：需要统计释放次数的本地扫描码。
+  size_t upCount(KeyButton button) const
+  {
+    return std::count_if(emitted.begin(), emitted.end(), [button](const auto &event) {
+      return event.m_button == button && !event.m_press;
+    });
+  }
+
+protected:
+  void getKeyMap(deskflow::KeyMap &) override {}
+  void fakeKey(const Keystroke &key) override
+  {
+    if (key.m_type != Keystroke::KeyType::Button) return;
+    emitted.push_back(key.m_data.m_button);
+    if (key.m_data.m_button.m_press) systemDown.insert(key.m_data.m_button.m_button);
+    else systemDown.erase(key.m_data.m_button.m_button);
+  }
+};
+}
+
+int main()
+{
+  Log log;
+  deskflow::KeyMap map;
+  populateMap(map);
+  for (const auto &modifier : modifiers) {
+    // 来源扫描码刻意不等于本地扫描码，验证映射按来源索引保留。
+    constexpr KeyButton source = 0x70;
+    RefreshState state(map);
+    state.fakeKeyDown(modifier.id, modifier.mask, source, "en");
+    check(state.systemDown.contains(modifier.button), "real KeyMap emits the expected modifier down");
+    const auto eventsBefore = state.emitted.size();
+    state.updateKeyState();
+    check(state.emitted.size() == eventsBefore && state.systemDown.contains(modifier.button),
+          "refresh preserves a held remote key without injecting a release or another down");
+    check(state.fakeKeyUp(source), "source mapping survives refresh and accepts its explicit key-up");
+    check(!state.systemDown.contains(modifier.button) && !state.isKeyDown(modifier.button),
+          "explicit key-up clears both OS boundary and shadow state");
+    check(state.upCount(modifier.button) == 1 && state.emitted.back().m_client == modifier.client,
+          "refresh preserves release metadata and emits exactly one up");
+    check(!state.fakeKeyUp(source) && state.upCount(modifier.button) == 1,
+          "duplicate source key-up cannot release the key a second time");
+
+    RefreshState leave(map);
+    leave.fakeKeyDown(modifier.id, modifier.mask, source, "en");
+    leave.updateKeyState();
+    leave.fakeAllKeysUp();
+    check(!leave.systemDown.contains(modifier.button) && leave.upCount(modifier.button) == 1,
+          "screen leave still releases the owned modifier after a refresh");
+    check(!leave.fakeKeyUp(source) && leave.upCount(modifier.button) == 1,
+          "late source release after leave cannot replay an up");
+
+    RefreshState released(map);
+    released.fakeKeyDown(modifier.id, modifier.mask, source, "en");
+    released.systemDown.erase(modifier.button);
+    const auto releasedBefore = released.emitted.size();
+    released.updateKeyState();
+    check(!released.isKeyDown(modifier.button) && !released.fakeKeyUp(source),
+          "a key reported up by the OS is not resurrected or remapped");
+    released.fakeAllKeysUp();
+    check(released.emitted.size() == releasedBefore,
+          "refresh does not inject for an already released key");
+
+    RefreshState takeover(map);
+    takeover.fakeKeyDown(modifier.id, modifier.mask, source, "en");
+    takeover.physical(modifier.button, true);
+    const auto takeoverBefore = takeover.emitted.size();
+    takeover.updateKeyState();
+    check(takeover.isKeyDown(modifier.button) && !takeover.fakeKeyUp(source),
+          "an observed physical takeover is not restored to relay ownership");
+    takeover.reconcileKeyRelease(modifier.id, 0);
+    takeover.fakeAllKeysUp();
+    check(takeover.systemDown.contains(modifier.button) && takeover.emitted.size() == takeoverBefore,
+          "remote release and leave preserve the refreshed physical key");
+  }
+
+  RefreshState pair(map);
+  pair.fakeKeyDown(kKeyControl_L, KeyModifierControl, 0x70, "en");
+  pair.physical(0x2a, true);
+  const auto shiftUps = pair.upCount(0x2a);
+  pair.updateKeyState();
+  check(pair.fakeKeyUp(0x70) && !pair.systemDown.contains(0x1d), "mapped Ctrl releases after refresh");
+  check(pair.systemDown.contains(0x2a) && pair.upCount(0x2a) == shiftUps,
+        "releasing remote Ctrl preserves a separately held physical Shift");
+
+  RefreshState repeated(map);
+  repeated.fakeKeyDown(kKeyAlt_L, KeyModifierAlt, 0x70, "en");
+  for (int i = 0; i < 4; ++i) repeated.updateKeyState();
+  check(repeated.fakeKeyUp(0x70) && repeated.upCount(0x38) == 1,
+        "successive refreshes retain one release rather than accumulating key-down counts");
+
+  RefreshState aliases(map);
+  aliases.fakeKeyDown(kKeyControl_L, KeyModifierControl, 0x70, "en");
+  aliases.fakeKeyDown(kKeyControl_R, KeyModifierControl, 0x170, "en");
+  aliases.updateKeyState();
+  check(aliases.fakeKeyUp(0x70) && !aliases.systemDown.contains(0x1d) && aliases.systemDown.contains(0x11d),
+        "left source alias releases only the left key and retains the right companion");
+  check(aliases.fakeKeyUp(0x170) && !aliases.systemDown.contains(0x11d) &&
+        aliases.upCount(0x1d) == 1 && aliases.upCount(0x11d) == 1,
+        "both independent source aliases survive refresh and release once");
+  check(!aliases.fakeKeyUp(0x70) && !aliases.fakeKeyUp(0x170),
+        "duplicate alias releases cannot replay either side");
+
+  RefreshState takeoverAfterRefresh(map);
+  takeoverAfterRefresh.fakeKeyDown(kKeyControl_L, KeyModifierControl, 0x70, "en");
+  takeoverAfterRefresh.updateKeyState();
+  takeoverAfterRefresh.physical(0x1d, true);
+  takeoverAfterRefresh.updateKeyState();
+  const auto afterTakeover = takeoverAfterRefresh.emitted.size();
+  check(!takeoverAfterRefresh.fakeKeyUp(0x70), "a later refresh also honors physical takeover of a previously restored key");
+  takeoverAfterRefresh.reconcileKeyRelease(kKeyControl_L, 0);
+  takeoverAfterRefresh.fakeAllKeysUp();
+  check(takeoverAfterRefresh.systemDown.contains(0x1d) && takeoverAfterRefresh.emitted.size() == afterTakeover,
+        "restoring a remote key once never permanently grants ownership over future physical events");
+
+  std::printf("PASS: %d real KeyMap/KeyState ownership refresh checks; no desktop input injected.\n", checks);
+}
