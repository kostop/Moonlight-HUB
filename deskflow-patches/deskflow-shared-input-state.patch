@@ -0,0 +1,38 @@
+﻿[CmdletBinding()]
+param(
+    # QtRoot：构建核心所用的 MSVC x64 Qt SDK。
+    [Parameter(Mandatory = $true)][string]$QtRoot,
+    # CoreBuildDir：核心静态库目录，提供未改动的日志等依赖。
+    [Parameter(Mandatory = $true)][string]$CoreBuildDir,
+    # BuildDir：只接收离线测试产物，不安装钩子或注入按键。
+    [string]$BuildDir = "$env:TEMP\moonlight-key-refresh-tests",
+    # KeyStateSource：可选的待测实现，用于对旧实现做失败验证；默认编译当前生产文件。
+    [string]$KeyStateSource
+)
+$ErrorActionPreference = 'Stop'
+$sourceRoot = Split-Path -Parent $PSScriptRoot
+$vsRoot = 'C:\Program Files\Microsoft Visual Studio\2022\Community'
+$msvcRoot = (Get-ChildItem -LiteralPath "$vsRoot\VC\Tools\MSVC" -Directory |
+    Sort-Object Name -Descending | Select-Object -First 1).FullName
+$sdkRoot = 'C:\Program Files (x86)\Windows Kits\10'
+$sdkVersion = (Get-ChildItem -LiteralPath "$sdkRoot\Include" -Directory |
+    Where-Object { Test-Path -LiteralPath "$($_.FullName)\um\Windows.h" } |
+    Sort-Object Name -Descending | Select-Object -First 1).Name
+if (!$msvcRoot -or !$sdkVersion) { throw 'MSVC or Windows SDK is missing.' }
+$env:INCLUDE = "$msvcRoot\include;$sdkRoot\Include\$sdkVersion\ucrt;$sdkRoot\Include\$sdkVersion\shared;$sdkRoot\Include\$sdkVersion\um"
+$env:LIB = "$msvcRoot\lib\x64;$sdkRoot\Lib\$sdkVersion\ucrt\x64;$sdkRoot\Lib\$sdkVersion\um\x64"
+$env:PATH = "$QtRoot\bin;$env:PATH"
+New-Item -ItemType Directory -Force -Path $BuildDir | Out-Null
+$support = Get-ChildItem -LiteralPath "$CoreBuildDir\src\lib" -Filter '*.lib' -Recurse | Select-Object -ExpandProperty FullName
+if (!$KeyStateSource) { $KeyStateSource = Join-Path $sourceRoot 'src\lib\deskflow\KeyState.cpp' }
+$sources = @($KeyStateSource) + @('KeyMap.cpp', 'IKeyState.cpp', 'KeyTypes.cpp' | ForEach-Object {
+    "$sourceRoot\src\lib\deskflow\$_"
+})
