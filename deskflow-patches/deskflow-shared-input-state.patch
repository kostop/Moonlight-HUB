+
+  PrimaryClient sameOwnerSource; BaseClientProxy sameOwnerPeer("B"); Server sameOwnerWarp(sameOwnerSource, sameOwnerPeer);
+  sameOwnerWarp.onMouseDown(kButtonRight);
