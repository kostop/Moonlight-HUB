+    "/Fe:$BuildDir\test-key-handoff.exe" "/Fo:$BuildDir\test-key-handoff.obj"
+if ($LASTEXITCODE -ne 0) { throw 'Key handoff tests did not compile.' }
+& "$BuildDir\test-key-handoff.exe"
