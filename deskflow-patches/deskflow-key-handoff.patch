diff --git a/tools/test-key-handoff.cpp b/tools/test-key-handoff.cpp
new file mode 100644
index 0000000..fedd5f7
--- /dev/null
+++ b/tools/test-key-handoff.cpp
@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception */
+#include "platform/MSWindowsLocalKeyRelease.h"
+#include <cstdio>
+#include <cstdlib>
+
+// 编译当前生产 onKey 方法体；仅模拟其平台边界，不安装键盘钩子或发送真实输入。
+using KeyButton = uint16_t;
+using KeyID = uint32_t;
+using KeyModifierMask = uint32_t;
+constexpr KeyModifierMask KeyModifierControl = 2, KeyModifierAlt = 4;
+constexpr KeyID kKeyNone = 0, kKeyDelete = 0xffff;
+#define LOG_DEBUG(...) ((void)0)
+#define LOG_DEBUG1(...) ((void)0)
+
+namespace {
+int checks = 0;
+int syntheticReleases = 0;
+int forwardedUps = 0;
+bool releaseSucceeded = true;
+bool hotkey = false;
+WPARAM mappedKey = 0;
+WPARAM hotkeyKey = 0;
+void check(bool success, const char *message)
+{
+  ++checks;
+  if (!success) { std::fprintf(stderr, "FAIL: %s\n", message); std::exit(1); }
+}
+struct KeyState {
+  bool down = false;
+  bool testAutoRepeat(bool, bool, KeyButton) { return false; }
+  KeyButton virtualKeyToButton(UINT) { return 0x1e; }
+  void onKey(KeyButton, bool press, KeyModifierMask) { down = press; }
+  KeyID mapKeyFromEvent(WPARAM key, LPARAM, KeyModifierMask *mask) { mappedKey = key; *mask = 0; return 'a'; }
+  void sendKeyEvent(void *, bool press, bool, KeyID, KeyModifierMask, int32_t, KeyButton)
+  {
+    if (!press) ++forwardedUps;
+  }
+};
+}
+
+class MSWindowsScreen {
+public:
+  bool m_isPrimary = true;
+  bool ignored = false;
+  KeyState *m_keyState;
+  deskflow::win32::LocalKeyReleaseState m_primaryKeyReleases;
+  bool onKey(WPARAM wParam, LPARAM lParam);
+  bool isKeyDown(KeyButton) const { return m_keyState->down; }
+  KeyModifierMask pollActiveModifiers() const { return 0; }
+  bool onHotKey(WPARAM key, LPARAM) const { hotkeyKey = key; return hotkey; }
+  bool isModifierRepeat(KeyModifierMask, KeyModifierMask, WPARAM) const { return false; }
+  bool ignore() const { return ignored; }
+  void *getEventTarget() { return this; }
+  bool releaseLocalKey(KeyButton) const { ++syntheticReleases; return releaseSucceeded; }
+};
+
+// 由脚本从当前生产源提取，禁止手工维护待测逻辑副本。
+#include "key-handoff-production.inc"
+
+int main()
+{
+  KeyState keys;
+  MSWindowsScreen screen;
+  screen.m_keyState = &keys;
+  const WPARAM ordinaryKey = static_cast<WPARAM>('A') << 16;
+  const LPARAM down = 1 | (0x1e << 16);
+  const LPARAM up = down | static_cast<LPARAM>(0x80000000u);
+
+  for (bool ignored : {false, true}) {
+    for (bool consumedByHotkey : {false, true}) {
+      screen.ignored = ignored; hotkey = consumedByHotkey;
+      screen.m_primaryKeyReleases.capture(0x1e);
+      const int releasesBefore = syntheticReleases, upsBefore = forwardedUps;
+      screen.onKey(ordinaryKey | deskflow::win32::kLocalKeyReleasePassed, up);
+      check(!keys.down, "real key-up updates internal state across mark and hotkey boundaries");
+      check(syntheticReleases == releasesBefore, "already passed physical key-up is never synthesized again");
+      screen.m_primaryKeyReleases.retry([&](uint16_t) { ++syntheticReleases; return true; });
+      check(syntheticReleases == releasesBefore, "native key-up clears any fallback retry exactly once");
+      check(forwardedUps == upsBefore + (!ignored && !consumedByHotkey ? 1 : 0),
+            "remote routing preserves existing mark and hotkey behavior");
+    }
+  }
+
+  screen.ignored = true; hotkey = true;
+  screen.m_primaryKeyReleases.capture(0x1e);
+  releaseSucceeded = false;
+  const int failedBefore = syntheticReleases;
+  screen.onKey(ordinaryKey, up);
+  check(syntheticReleases == failedBefore + 1, "legacy missed native release still uses exact fallback repair");
+  screen.onKey(ordinaryKey | deskflow::win32::kLocalKeyReleasePassed, up);
+  screen.m_primaryKeyReleases.retry([&](uint16_t) { ++syntheticReleases; return true; });
+  check(syntheticReleases == failedBefore + 1, "later native key-up cancels a failed fallback without another injection");
+
+  releaseSucceeded = true; screen.ignored = false; hotkey = false;
+  screen.m_primaryKeyReleases.capture(0x1e);
+  const int heldBefore = syntheticReleases;
+  screen.onKey(ordinaryKey, down);
+  screen.m_primaryKeyReleases.retry([&](uint16_t) { ++syntheticReleases; return true; });
+  check(keys.down && syntheticReleases == heldBefore, "crossing with a held key does not force it up");
+  screen.onKey(ordinaryKey | deskflow::win32::kLocalKeyReleasePassed, up);
+  check(!keys.down && syntheticReleases == heldBefore, "physical release ends the held key without an extra key press");
+  check(mappedKey == ordinaryKey && hotkeyKey == ordinaryKey,
+        "native release metadata never enters hotkey or AltGr key mapping");
+  const WPARAM noAltGr = ordinaryKey | 0x01000000u;
+  screen.onKey(noAltGr | deskflow::win32::kLocalKeyReleasePassed, up);
+  check(mappedKey == noAltGr && hotkeyKey == noAltGr,
+        "removing native release metadata preserves the original no-AltGr flag");
+
+  std::printf("PASS: %d extracted production key handoff checks; no desktop input injected.\n", checks);
+}
