--- a/src/lib/platform/MSWindowsLocalKeyRelease.h
+++ b/src/lib/platform/MSWindowsLocalKeyRelease.h
@@ -11,6 +11,8 @@
 #include <Windows.h>
 
 #include <algorithm>
+#include <array>
+#include <atomic>
 #include <cstdint>
 #include <vector>
 
@@ -18,6 +20,39 @@ namespace deskflow::win32 {
 
 // 仅标记“本机按下、离开后物理松开”的补发释放，不能把全部注入输入放行。
 inline constexpr ULONG_PTR kLocalKeyReleaseTag = 0x4d484c55u;
+// 线程消息内的来源标记，不属于发送给 Windows 的虚拟键或扫描码。
+inline constexpr WPARAM kLocalKeyReleasePassed = 0x02000000u;
+
+class LocalKeyOwnership
+{
+public:
+  // 参数 button：低级钩子的扫描码（含扩展位）；virtualKey：扫描码缺失时的备用键值。
+  void capture(uint16_t button, uint16_t virtualKey)
+  {
+    m_keys[index(button, virtualKey)] = true;
+  }
+
+  // 参数 button/virtualKey：真实松开的按键；只归还曾经放行给本机的那次按下。
+  bool release(uint16_t button, uint16_t virtualKey)
+  {
+    return m_keys[index(button, virtualKey)].exchange(false);
+  }
+
+  void clear()
+  {
+    for (auto &key : m_keys) {
+      key = false;
+    }
+  }
+
+private:
+  // 参数 button/virtualKey：与 capture 一致；普通扫描码与无扫描码键使用独立槽位。
+  static size_t index(uint16_t button, uint16_t virtualKey)
+  {
+    return button != 0 ? button & 0x1ffu : 0x200u + (virtualKey & 0xffu);
+  }
+  std::array<std::atomic<bool>, 0x300> m_keys{};
+};
 
 // 参数 virtualKey：左右独立的虚拟键；button：低 8 位扫描码，0x100 为扩展键。
 inline INPUT makeLocalKeyRelease(WORD virtualKey, uint16_t button)
