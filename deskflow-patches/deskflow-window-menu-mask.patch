+++ b/tools/test-menu-handoff.cpp
@@ -0,0 +1,254 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception */
+#include "platform/MSWindowsHook.h"
+#include "platform/MSWindowsMenuMask.h"
+#include "platform/MSWindowsLocalKeyRelease.h"
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+namespace {
+struct Posted { UINT message; WPARAM w; LPARAM l; };
+struct NativeKey { WORD vk, scan; bool down, extended; ULONG_PTR tag; };
+std::array<bool, 256> nativeDown{}, menuUsed{};
+std::vector<Posted> posted;
+std::vector<NativeKey> nativeKeys;
+std::vector<std::vector<INPUT>> attempts;
+std::vector<UINT> acceptedPlan;
+size_t acceptedIndex = 0;
+int menuActivations = 0, checks = 0;
+LRESULT deliverInjected(const INPUT &input);
+bool menuKey(WORD key) { return key == VK_LMENU || key == VK_RMENU || key == VK_LWIN || key == VK_RWIN; }
+void receive(WORD vk, WORD scan, bool down, bool extended, ULONG_PTR tag) {
+  nativeKeys.push_back({vk, scan, down, extended, tag});
+  if (down) {
+    if (menuKey(vk) && !nativeDown[vk]) menuUsed[vk] = false;
+    if (!menuKey(vk)) {
+      for (int key : {VK_LMENU, VK_RMENU, VK_LWIN, VK_RWIN}) if (nativeDown[key]) menuUsed[key] = true;
+    }
+  } else if (menuKey(vk) && nativeDown[vk] && !menuUsed[vk]) {
+    ++menuActivations;
+  }
+  nativeDown[vk] = down;
+}
+BOOL WINAPI post(DWORD, UINT message, WPARAM w, LPARAM l) { posted.push_back({message,w,l}); return TRUE; }
+LRESULT WINAPI pass(HHOOK, int, WPARAM, LPARAM) { return 0; }
+SHORT WINAPI keyState(int vk) { return nativeDown[static_cast<unsigned>(vk) & 255u] ? SHORT{static_cast<SHORT>(0x8000u)} : 0; }
+int WINAPI translate(UINT, UINT, const BYTE *, LPWSTR, int, UINT) { return 0; }
+BOOL WINAPI unhook(HHOOK) { return TRUE; }
+DWORD WINAPI threadId() { return 7; }
+UINT WINAPI sendInputs(UINT count, LPINPUT input, int size) {
+  if (size != sizeof(INPUT)) return 0;
+  attempts.emplace_back(input, input + count);
+  const UINT accepted = acceptedIndex < acceptedPlan.size() ? acceptedPlan[acceptedIndex++] : count;
+  for (UINT index = 0; index < accepted && index < count; ++index) deliverInjected(input[index]);
+  return accepted;
+}
+void check(bool success, const char *message) {
+  ++checks;
+  if (!success) { std::fprintf(stderr,"FAIL: %s\n",message); std::exit(1); }
+}
+}
+
+#undef PostThreadMessage
+#define PostThreadMessage post
+#define CallNextHookEx pass
+#define GetAsyncKeyState keyState
+#define ToUnicode translate
+#define UnhookWindowsHookEx unhook
+#define GetCurrentThreadId threadId
+#define SendInput sendInputs
+#pragma warning(push)
+#pragma warning(disable: 4457)
+#pragma warning(disable: 4702) // 未调用的加载错误路径在本测试的 abort 日志边界后不可达。
+#include "../src/lib/platform/MSWindowsHook.cpp"
+#pragma warning(pop)
+
+namespace {
+LRESULT deliverInjected(const INPUT &input) {
+  check(input.type == INPUT_KEYBOARD, "source menu masking injects keyboard events only");
+  KBDLLHOOKSTRUCT key{};
+  key.vkCode=input.ki.wVk; key.scanCode=input.ki.wScan; key.dwExtraInfo=input.ki.dwExtraInfo;
+  key.flags=LLKHF_INJECTED | ((input.ki.dwFlags & KEYEVENTF_KEYUP) ? LLKHF_UP : 0) |
+      ((input.ki.dwFlags & KEYEVENTF_EXTENDEDKEY) ? LLKHF_EXTENDED : 0);
+  const auto result=keyboardLLHook(HC_ACTION, (key.flags & LLKHF_UP) ? WM_KEYUP : WM_KEYDOWN,
+                                  reinterpret_cast<LPARAM>(&key));
+  if (result == 0) receive(input.ki.wVk,input.ki.wScan,(key.flags & LLKHF_UP)==0,
+                           (key.flags & LLKHF_EXTENDED)!=0,input.ki.dwExtraInfo);
+  return result;
+}
+LRESULT physical(WORD vk, uint16_t scan, bool down) {
+  KBDLLHOOKSTRUCT key{};
+  key.vkCode=vk; key.scanCode=scan & 255u;
+  key.flags=(down ? 0 : LLKHF_UP) | ((scan & 0x100u) ? LLKHF_EXTENDED : 0);
+  const auto result=keyboardLLHook(HC_ACTION,down ? WM_KEYDOWN : WM_KEYUP,reinterpret_cast<LPARAM>(&key));
+  if (result == 0) receive(vk,static_cast<WORD>(key.scanCode),down,(key.flags & LLKHF_EXTENDED)!=0,0);
+  return result;
+}
+void reset(MSWindowsHook &hook, EHookMode mode) {
+  hook.init(7); g_isPrimary=TRUE; g_hookThread=7;
+  g_keyboardLL=reinterpret_cast<HHOOK>(1); g_mouseLL=reinterpret_cast<HHOOK>(1);
+  hook.setMode(mode); nativeDown={};menuUsed={};posted.clear();nativeKeys.clear();attempts.clear();
+  acceptedPlan.clear();acceptedIndex=0;menuActivations=0;
+}
+size_t nativeUps(WORD vk) {
+  size_t count=0;for(const auto &key:nativeKeys) if(key.vk==vk && !key.down) ++count; return count;
+}
+size_t postedUps(WORD vk, bool handled) {
+  size_t count=0;
+  for(const auto &entry:posted) if(entry.message==DESKFLOW_MSG_KEY && ((entry.w>>16)&255u)==vk &&
+      (entry.l & static_cast<LPARAM>(0x80000000u))!=0 &&
+      ((entry.w & deskflow::win32::kLocalKeyReleasePassed)!=0)==handled) ++count;
+  return count;
+}
+}
+Log *Log::getInstance() { std::abort(); }
+void Log::print(const char *,int,const char *,...) { std::abort(); }
+BaseException::BaseException():std::runtime_error("") {}
+const char *BaseException::what() const noexcept { std::abort(); }
+std::string BaseException::format(const char *,const char *,...) const noexcept { std::abort(); }
+std::string ScreenOpenFailureException::getWhat() const noexcept { std::abort(); }
+
+int main() {
+  MSWindowsHook hook;
+  struct Case {WORD vk;uint16_t scan;};
+  const Case keys[]={{VK_LMENU,0x38},{VK_RMENU,0x138},{VK_LWIN,0x15b},{VK_RWIN,0x15c}};
+  for(const auto &key:keys) {
+    reset(hook,kHOOK_WATCH_JUMP_ZONE);
+    check(physical(key.vk,key.scan,true)==0 && physical(key.vk,key.scan,false)==0,
+          "normal same-screen Alt/Win tap remains native");
+    check(attempts.empty() && menuActivations==1 && nativeUps(key.vk)==1,
+          "normal tap activates its native menu without an E8 mask");
+
+    reset(hook,kHOOK_WATCH_JUMP_ZONE);
+    physical(key.vk,key.scan,true);physical(VK_TAB,0x0f,true);physical(VK_TAB,0x0f,false);physical(key.vk,key.scan,false);
+    check(attempts.empty() && menuActivations==0 && nativeUps(key.vk)==1,
+          "normal same-screen Alt/Win combination is not intercepted or masked");
+
+    reset(hook,kHOOK_WATCH_JUMP_ZONE);
+    physical(key.vk,key.scan,true);hook.setMode(kHOOK_WATCH_JUMP_ZONE);
+    check(physical(key.vk,key.scan,false)==0 && attempts.empty() && menuActivations==1,
+          "resetting the same local mode never turns a normal Alt tap into a cross-screen mask");
+
+    reset(hook,kHOOK_WATCH_JUMP_ZONE);
+    physical(key.vk,key.scan,true);++g_menuKeyOwnership.epoch;
+    check(physical(key.vk,key.scan,false)==1 && menuActivations==0 && nativeUps(key.vk)==1,
+          "an in-progress odd epoch is handled conservatively without waiting for the main thread");
+
+    reset(hook,kHOOK_WATCH_JUMP_ZONE);
+    ++g_menuKeyOwnership.epoch;physical(key.vk,key.scan,true);
+    check(physical(key.vk,key.scan,false)==1 && nativeUps(key.vk)==1,
+          "a down first observed during mode publication retains its conservative crossing mark");
+
+    reset(hook,kHOOK_WATCH_JUMP_ZONE);
+    physical(key.vk,key.scan,true);hook.beginMouseHandoff();
+    check(physical(key.vk,key.scan,false)==1 && nativeUps(key.vk)==1 && menuActivations==0,
+          "mouse handoff marks Alt held before the formal keyboard relay mode changes");
+
+    reset(hook,kHOOK_WATCH_JUMP_ZONE);
+    physical(key.vk,key.scan,true);hook.beginMouseHandoff();hook.setMode(kHOOK_RELAY_EVENTS);
+    check(physical(key.vk,key.scan,false)==1,"cross-screen local-owned up consumes only the replaced physical event");
+    check(attempts.size()==1 && attempts[0].size()==3 && nativeUps(key.vk)==1 && !nativeDown[key.vk] && menuActivations==0,
+          "masked local return emits E8 pair then exactly one real native modifier up");
+    check(postedUps(key.vk,true)==1 && postedUps(deskflow::win32::kMenuMaskVirtualKey,false)==0,
+          "the physical up still reaches Main once and E8 never becomes relayed input");
+    check(nativeKeys.back().scan==(key.scan & 255u) && nativeKeys.back().extended==((key.scan & 0x100u)!=0) &&
+          nativeKeys.back().tag==deskflow::win32::kLocalKeyReleaseTag,
+          "masked modifier release preserves its side, extended scan and exact native release tag");
+
+    reset(hook,kHOOK_RELAY_EVENTS);
+    check(physical(key.vk,key.scan,true)==1,"remote-origin down never reaches the local OS");
+    hook.setMode(kHOOK_WATCH_JUMP_ZONE);
+    check(physical(key.vk,key.scan,false)==1 && nativeUps(key.vk)==0 && attempts.empty() && postedUps(key.vk,true)==1,
+          "a remote-origin up returning home is routed but cannot become an unmatched native menu up");
+
+    reset(hook,kHOOK_WATCH_JUMP_ZONE);
+    physical(key.vk,key.scan,true);hook.setMode(kHOOK_RELAY_EVENTS);hook.setMode(kHOOK_WATCH_JUMP_ZONE);
+    physical(key.vk,key.scan,true);
+    check(physical(key.vk,key.scan,false)==1 && attempts.size()==1 && nativeUps(key.vk)==1 && menuActivations==0,
+          "local-origin roundtrip and repeat retain the crossing mark until native up");
+
+    reset(hook,kHOOK_RELAY_EVENTS);
+    physical(key.vk,key.scan,true);hook.setMode(kHOOK_WATCH_JUMP_ZONE);
+    check(physical(key.vk,key.scan,true)==0,"a repeated down returned home is still passed according to the original mode");
+    check(physical(key.vk,key.scan,false)==1 && attempts.size()==1 && nativeUps(key.vk)==1 && !nativeDown[key.vk],
+          "returned remote repeat upgrades actual native ownership without losing the crossing mark");
+
+    for(UINT accepted:{0u,1u,2u}) {
+      reset(hook,kHOOK_WATCH_JUMP_ZONE);
+      physical(key.vk,key.scan,true);hook.setMode(kHOOK_RELAY_EVENTS);acceptedPlan={accepted};
+      check(physical(key.vk,key.scan,false)==0 && nativeUps(key.vk)==1 && !nativeDown[key.vk],
+            "partial or failed replacement always falls through the real modifier up exactly once");
+      check(!nativeDown[deskflow::win32::kMenuMaskVirtualKey],"a partial E8 down is paired with cleanup up");
+      check(attempts.size()==(accepted==1 ? 2u:1u) && postedUps(key.vk,true)==1,
+            "partial replacement retries only E8 cleanup and preserves the normal Main release");
+    }
+
+    reset(hook,kHOOK_WATCH_JUMP_ZONE);
+    physical(key.vk,key.scan,true);hook.setMode(kHOOK_RELAY_EVENTS);acceptedPlan={1,0};
+    check(physical(key.vk,key.scan,false)==0 && nativeUps(key.vk)==1 && !nativeDown[key.vk],
+          "failure of the E8 cleanup request still cannot consume the real modifier up");
+    check(attempts.size()==2 && attempts[1].size()==1 && attempts[1][0].ki.wVk==deskflow::win32::kMenuMaskVirtualKey &&
+          attempts[1][0].ki.dwExtraInfo==deskflow::win32::kMenuMaskTag && (attempts[1][0].ki.dwFlags&KEYEVENTF_KEYUP)!=0,
+          "partial cleanup attempts only the tagged E8 up and never releases unrelated modifiers");
+
+    reset(hook,kHOOK_RELAY_EVENTS);
+    physical(key.vk,key.scan,true);hook.uninstall();hook.setMode(kHOOK_WATCH_JUMP_ZONE);
+    g_keyboardLL=reinterpret_cast<HHOOK>(1);g_mouseLL=reinterpret_cast<HHOOK>(1);
+    physical(key.vk,key.scan,true);
+    check(physical(key.vk,key.scan,false)==0 && attempts.empty() && menuActivations==1 && !nativeDown[key.vk],
+          "an unobserved remote up across uninstall cannot capture a new normal local tap forever");
+
+    reset(hook,kHOOK_WATCH_JUMP_ZONE);
+    physical(key.vk,key.scan,true);hook.setMode(kHOOK_RELAY_EVENTS);hook.uninstall();hook.setMode(kHOOK_WATCH_JUMP_ZONE);
+    g_keyboardLL=reinterpret_cast<HHOOK>(1);g_mouseLL=reinterpret_cast<HHOOK>(1);
+    physical(key.vk,key.scan,true);
+    check(physical(key.vk,key.scan,false)==1 && nativeUps(key.vk)==1 && menuActivations==0,
+          "a native modifier still held across reinstall keeps its crossing repair after a repeat");
+  }
+
+  for(EHookMode mode:{kHOOK_WATCH_JUMP_ZONE,kHOOK_RELAY_EVENTS}) {
+    reset(hook,mode);
+    check(physical(VK_LMENU,0x38,false)==(mode==kHOOK_RELAY_EVENTS?1:0) && attempts.empty(),
+          "unknown modifier up preserves the original local or relay behavior");
+  }
+  for(const auto &key:keys) {
+    reset(hook,kHOOK_WATCH_JUMP_ZONE);
+    INPUT injection{};injection.type=INPUT_KEYBOARD;injection.ki.wVk=key.vk;
+    injection.ki.wScan=static_cast<WORD>(key.scan&255u);
+    deliverInjected(injection);
+    check(g_menuKeyOwnership.release(key.vk,key.scan).origin==MenuKeyOwnership::Unknown,
+          "injected down cannot claim physical menu ownership");
+
+    reset(hook,kHOOK_RELAY_EVENTS);
+    physical(key.vk,key.scan,true);injection.ki.dwFlags=KEYEVENTF_KEYUP;
+    deliverInjected(injection);hook.setMode(kHOOK_WATCH_JUMP_ZONE);
+    check(physical(key.vk,key.scan,false)==1 && nativeUps(key.vk)==0,
+          "an injected up cannot consume the original physical remote-down ownership");
+  }
+  for(const Case key:std::vector<Case>{{VK_LCONTROL,0x1d},{VK_RCONTROL,0x11d},{VK_LSHIFT,0x2a},{VK_RSHIFT,0x36}}) {
+    reset(hook,kHOOK_WATCH_JUMP_ZONE);
+    physical(key.vk,key.scan,true);hook.setMode(kHOOK_RELAY_EVENTS);
+    check(physical(key.vk,key.scan,false)==0 && nativeUps(key.vk)==1 && attempts.empty(),
+          "menu masking does not alter Ctrl or Shift handoff release behavior");
+  }
+  reset(hook,kHOOK_RELAY_EVENTS);
+  for(bool down:{false,true}) {
+    auto input=deskflow::win32::makeMenuMaskKey(down);
+    const auto before=posted.size();
+    check(deliverInjected(input)==0 && posted.size()==before,"only exact own E8 injection bypasses relay without posting a key");
+  }
+  for(int variant:{0,1,2,3}) {
+    KBDLLHOOKSTRUCT event{};event.vkCode=deskflow::win32::kMenuMaskVirtualKey;
+    event.dwExtraInfo=deskflow::win32::kMenuMaskTag;event.flags=LLKHF_INJECTED;
+    if(variant==0) event.vkCode=VK_LMENU;
+    if(variant==1) event.scanCode=1;
+    if(variant==2) event.flags=0;
+    if(variant==3) event.dwExtraInfo=0;
+    check(!deskflow::win32::isTaggedMenuMask(event),"menu mask recognition rejects other keys, scans, hardware and ordinary injections");
+    const auto before=posted.size();
+    check(keyboardLLHook(HC_ACTION,WM_KEYDOWN,reinterpret_cast<LPARAM>(&event))==1 && posted.size()>before,
+          "invalid mask tags actually follow production relay instead of bypassing the hook");
+  }
+  std::printf("PASS: %d production source menu-handoff checks; no real hooks or desktop input.\n",checks);
+}
