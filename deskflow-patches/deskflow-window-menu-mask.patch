+#include "deskflow/KeyState.h"
+#include "base/Log.h"
+#include "platform/MSWindowsHook.h"
+#include "platform/MSWindowsMenuMask.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+
+namespace {
+struct Modifier { KeyID id; KeyButton button; KeyModifierMask mask; WORD virtualKey = 0; };
+constexpr std::array menuModifiers{
+    Modifier{kKeyAlt_L, 0x38, KeyModifierAlt, VK_LMENU},
+    Modifier{kKeyAlt_R, 0x138, KeyModifierAlt | KeyModifierAltGr, VK_RMENU},
+    Modifier{kKeyAltGr, 0x139, KeyModifierAltGr, VK_RMENU},
+    Modifier{kKeySuper_L, 0x15b, KeyModifierSuper, VK_LWIN},
+    Modifier{kKeySuper_R, 0x15c, KeyModifierSuper, VK_RWIN},
+    Modifier{kKeyMeta_L, 0x160, KeyModifierMeta, VK_LWIN},
+    Modifier{kKeyMeta_R, 0x161, KeyModifierMeta, VK_RWIN},
+};
+}
+#include "menu-emulation-scope.inc"
+namespace {
+struct NativeKey
+{
+  WORD vk;
+  WORD scan;
+  DWORD flags;
+  bool repeat;
+  bool operator==(const NativeKey &) const = default;
+};
+struct Trace
+{
+  bool mask;
+  WORD vk;
+  DWORD flags;
+};
+struct Boundary
+{
+  UINT inserted = 2;
+  UINT cleanupInserted = 1;
+  int warnings = 0;
+  int masks = 0;
+  int cleanups = 0;
+  int updates = 0;
+  unsigned maxDepth = 0;
+  bool desktopThread = false;
+  bool throwMask = false;
+  std::vector<std::string> order;
+  std::vector<INPUT> input;
+  std::vector<NativeKey> keys;
+  std::vector<Trace> trace;
+} boundary;
+int checks = 0;
+
+// 参数 success：断言结果；message：失败行为描述。
+void check(bool success, const char *message)
+{
+  ++checks;
+  if (!success) { std::fprintf(stderr, "FAIL: %s\n", message); std::exit(1); }
+}
+
+// 参数 count/input/size：实际桌面分支要注入的批次；仅记录，不调用 Windows 输入。
+UINT WINAPI recordInput(UINT count, LPINPUT input, int size)
+{
+  if (count == 1) {
+    ++boundary.cleanups;
+    boundary.order.emplace_back("cleanup");
+    check(boundary.desktopThread && size == sizeof(INPUT) && input[0].type == INPUT_KEYBOARD &&
+          input[0].ki.wVk == deskflow::win32::kMenuMaskVirtualKey && input[0].ki.wScan == 0 &&
+          input[0].ki.dwFlags == KEYEVENTF_KEYUP && input[0].ki.dwExtraInfo == deskflow::win32::kMenuMaskTag,
+          "partial mask cleanup retries only the same tagged E8 release");
+    return boundary.cleanupInserted;
+  }
+  check(boundary.desktopThread && count == 2 && size == sizeof(INPUT),
+        "receiver mask is one paired batch in the active desktop dispatch");
+  ++boundary.masks;
+  boundary.maxDepth = std::max(boundary.maxDepth, g_menuReleaseMaskDepth);
+  if (boundary.throwMask) throw std::runtime_error("simulated mask boundary failure");
+  boundary.order.emplace_back("mask");
+  boundary.trace.push_back({true, deskflow::win32::kMenuMaskVirtualKey, 0});
+  boundary.input.assign(input, input + count);
+  for (UINT i = 0; i < count; ++i) {
+    check(input[i].type == INPUT_KEYBOARD && input[i].ki.wVk == deskflow::win32::kMenuMaskVirtualKey &&
+          input[i].ki.wScan == 0 && input[i].ki.time == 0 &&
+          input[i].ki.dwExtraInfo == deskflow::win32::kMenuMaskTag &&
+          input[i].ki.dwFlags == (i == 0 ? 0u : KEYEVENTF_KEYUP),
+          "receiver sends only zero-initialized E8 down/up with the dedicated tag");
+  }
+  return boundary.inserted;
+}
+void WINAPI recordError(DWORD) {}
+DWORD WINAPI readError() { return ERROR_ACCESS_DENIED; }
+
+// 参数 map：真实键盘映射，不替换生产 KeyMap::mapKey。
+void populateMap(deskflow::KeyMap &map)
+{
+  for (const auto &modifier : menuModifiers) {
+    deskflow::KeyMap::KeyItem item{};
+    item.m_id = modifier.id; item.m_button = modifier.button;
+    item.m_generates = modifier.mask; item.m_client = modifier.virtualKey;
+    map.addKeyEntry(item);
+  }
+  for (const auto &modifier : std::array{
+      Modifier{kKeyControl_L, 0x1d, KeyModifierControl, VK_LCONTROL},
+      Modifier{kKeyShift_L, 0x2a, KeyModifierShift, VK_LSHIFT}}) {
+    deskflow::KeyMap::KeyItem item{};
+    item.m_id = modifier.id; item.m_button = modifier.button;
+    item.m_generates = modifier.mask; item.m_client = modifier.virtualKey;
+    map.addKeyEntry(item);
+  }
+  for (const auto &ordinary : std::array{Modifier{kKeyTab, 0x0f, 0, VK_TAB}, Modifier{'f', 0x21, 0, 'F'}}) {
+    deskflow::KeyMap::KeyItem item{};
+    item.m_id = ordinary.id; item.m_button = ordinary.button; item.m_client = ordinary.virtualKey;
+    map.addKeyEntry(item);
+  }
+  map.finish();
+}
+
+class ReceiverState : public KeyState
+{
+public:
+  explicit ReceiverState(deskflow::KeyMap &map) : KeyState(nullptr, map, {"en"}, false) {}
+  KeyButtonSet systemDown;
+  int released = 0;
+  int32_t pollActiveGroup() const override { return 0; }
+  KeyModifierMask pollActiveModifiers() const override
+  {
+    KeyModifierMask mask = 0;
+    for (const auto &modifier : menuModifiers) {
+      if (getKeyState(modifier.button) > 0) mask |= modifier.mask;
+    }
+    if (getKeyState(0x1d) > 0) mask |= KeyModifierControl;
+    if (getKeyState(0x2a) > 0) mask |= KeyModifierShift;
+    return mask;
+  }
+  bool fakeCtrlAltDel() override { return false; }
+  void pollPressedKeys(KeyButtonSet &keys) const override { keys = systemDown; }
+  void physical(KeyButton button)
+  {
+    systemDown.insert(button);
+    onKey(button, true, pollActiveModifiers());
+  }
+protected:
+  void getKeyMap(deskflow::KeyMap &) override {}
+  void fakeKey(const Keystroke &key) override
+  {
+    if (key.m_type != Keystroke::KeyType::Button) return;
+    if (key.m_data.m_button.m_press) systemDown.insert(key.m_data.m_button.m_button);
+    else { systemDown.erase(key.m_data.m_button.m_button); ++released; boundary.order.emplace_back("up"); }
+  }
+};
+}
+
+class MSWindowsDesks
+{
+public:
+  void maskMenuActivation() const;
+  void sendMessage(UINT message, WPARAM w, LPARAM l) const;
+  void fakeKeyEvent(WORD vk, WORD scan, DWORD flags, bool repeat) const
+  {
+    boundary.maxDepth = std::max(boundary.maxDepth, g_menuReleaseMaskDepth);
+    boundary.keys.push_back({vk, scan, flags, repeat});
+    boundary.trace.push_back({false, vk, flags});
+  }
+};
+class MSWindowsKeyState : public KeyState
+{
+public:
+  MSWindowsKeyState(deskflow::KeyMap &map, MSWindowsDesks &desks) : KeyState(nullptr, map, {"en"}, false), m_desks(&desks) {}
+  void fakeKeyDown(KeyID id, KeyModifierMask mask, KeyButton button, const std::string &lang) override;
+  bool fakeKeyRepeat(KeyID id, KeyModifierMask mask, int32_t count, KeyButton button, const std::string &lang) override;
+  void reconcileKeyRelease(KeyID id, KeyModifierMask mask) override;
+  bool fakeCtrlAltDel() override { return false; }
+  int32_t pollActiveGroup() const override { return 0; }
+  KeyModifierMask pollActiveModifiers() const override { return getActiveModifiers(); }
+  void pollPressedKeys(KeyButtonSet &) const override {}
+protected:
+  void getKeyMap(deskflow::KeyMap &) override {}
+  void fakeKey(const Keystroke &keystroke) override;
+private:
+  void setWindowGroup(int32_t) {}
+  MSWindowsDesks *m_desks;
+};
+class PlatformScreen
+{
+public:
+  KeyState *m_keyState;
+  void fakeAllKeysUp() { boundary.order.emplace_back("release"); m_keyState->fakeAllKeysUp(); }
+  bool fakeKeyUp(KeyButton button) { return m_keyState->fakeKeyUp(button); }
+};
+class MSWindowsScreen : public PlatformScreen
+{
+public:
+  bool m_isPrimary = false;
+  MSWindowsDesks *m_desks;
+  void fakeAllKeysUp();
+  bool fakeKeyUp(KeyButton button);
+  void updateMouseKeys() { ++boundary.updates; }
+};
+
+// 提取生产方法和实际桌面消息分支，仅替换其操作系统边界。
+#undef LOG_WARN
+#define LOG_WARN(...) (++boundary.warnings)
+#undef LOG
+#define LOG(...) ((void)0)
+#undef LOG_DEBUG1
+#define LOG_DEBUG1(...) ((void)0)
+#define SendInput recordInput
+#define SetLastError recordError
+#define GetLastError readError
+#include "receiver-menu-production.inc"
+
+int main()
+{
+  Log log;
+  deskflow::KeyMap map;
+  populateMap(map);
+  MSWindowsDesks desks;
+  for (const auto &modifier : menuModifiers) {
+    for (UINT result : {0u, 1u, 2u}) {
+      boundary = {}; boundary.inserted = result;
+      ReceiverState state(map);
+      state.fakeKeyDown(modifier.id, modifier.mask, 0x70, "en");
+      check(state.hasRelayMenuModifier(), "owned nonlocking menu modifier requires receiver handoff masking");
+      boundary.order.clear();
+      MSWindowsScreen screen; screen.m_keyState = &state; screen.m_desks = &desks;
+      screen.fakeAllKeysUp();
+      const auto release = std::find(boundary.order.begin(), boundary.order.end(), "release");
+      check(boundary.masks == 1 && boundary.order[0] == "mask" && release != boundary.order.end() &&
+            release + 1 != boundary.order.end() && *(release + 1) == "up",
+            "receiver masks before releasing its modifier, including failed or partial injection");
+      check(state.released == 1 && !state.systemDown.contains(modifier.button) && !state.hasRelayMenuModifier(),
+            "normal release proceeds after every mask attempt and clears relay menu ownership");
+      check(boundary.warnings == (result == 2 ? 0 : 1), "mask failure is reported without abandoning modifier cleanup");
+      check(boundary.cleanups == (result == 1 ? 1 : 0), "only a partial mask batch needs neutral-key release cleanup");
+      screen.fakeAllKeysUp();
+      check(boundary.masks == 1 && state.released == 1, "duplicate receiver cleanup cannot repeat mask or key-up");
+    }
+
+    boundary = {};
+    ReceiverState normal(map);
+    normal.fakeKeyDown(modifier.id, modifier.mask, 0x70, "en");
+    MSWindowsScreen normalScreen; normalScreen.m_keyState = &normal; normalScreen.m_desks = &desks;
+    check(normalScreen.fakeKeyUp(0x70) && boundary.masks == 0,
+          "same-screen Alt or Win tap uses the original release path and is not masked");
+
+    boundary = {};
+    ReceiverState primary(map);
+    primary.fakeKeyDown(modifier.id, modifier.mask, 0x70, "en");
+    MSWindowsScreen primaryScreen; primaryScreen.m_keyState = &primary; primaryScreen.m_desks = &desks;
+    primaryScreen.m_isPrimary = true;
+    primaryScreen.fakeAllKeysUp();
+    check(boundary.masks == 0 && primary.released == 1, "primary cleanup cannot activate the receiver mask path");
+
+    ReceiverState physical(map);
+    physical.fakeKeyDown(modifier.id, modifier.mask, 0x70, "en");
+    physical.physical(modifier.button);
+    check(!physical.hasRelayMenuModifier(), "observed physical takeover never requires a relay menu mask");
+
+    ReceiverState refreshed(map);
+    refreshed.fakeKeyDown(modifier.id, modifier.mask, 0x70, "en");
+    refreshed.updateKeyState();
+    check(refreshed.hasRelayMenuModifier(), "ownership refresh retains an outstanding receiver menu modifier");
+  }
+  for (const auto &modifier : std::array{
+      Modifier{kKeyControl_L, 0x1d, KeyModifierControl}, Modifier{kKeyShift_L, 0x2a, KeyModifierShift}}) {
+    boundary = {};
+    ReceiverState ordinary(map);
+    ordinary.fakeKeyDown(modifier.id, modifier.mask, 0x70, "en");
+    MSWindowsScreen screen; screen.m_keyState = &ordinary; screen.m_desks = &desks;
+    screen.fakeAllKeysUp();
+    check(boundary.masks == 0 && ordinary.released == 1, "Ctrl-only or Shift-only cleanup is not menu masking");
+  }
+
+  deskflow::KeyMap lockedMap;
+  deskflow::KeyMap::KeyItem lock{};
+  lock.m_id = kKeyAlt_L; lock.m_button = 0x38; lock.m_generates = KeyModifierAlt;
+  lock.m_lock = true; lock.m_client = 0x38;
+  lockedMap.addKeyEntry(lock); lockedMap.finish();
+  ReceiverState locked(lockedMap);
+  locked.fakeKeyDown(kKeyAlt_L, KeyModifierAlt, 0x70, "en");
+  check(locked.systemDown.contains(0x38) && locked.isKeyDown(0x38),
+        "locking modifier fixture still establishes a mapped relay key-down");
+  check(!locked.hasRelayMenuModifier(), "a locking modifier is excluded even when it generates the Alt bit");
+
+  ReceiverState alreadyPhysical(map);
+  alreadyPhysical.physical(0x38);
+  alreadyPhysical.fakeKeyDown(kKeyAlt_L, KeyModifierAlt, 0x70, "en");
+  check(!alreadyPhysical.hasRelayMenuModifier(),
+        "a remote shortcut cannot gain menu masking ownership of an already physical Alt");
+
+  boundary = {}; boundary.inserted = 1; boundary.cleanupInserted = 0;
+  ReceiverState failedCleanup(map);
+  failedCleanup.fakeKeyDown(kKeyAlt_L, KeyModifierAlt, 0x70, "en");
+  MSWindowsScreen failureScreen; failureScreen.m_keyState = &failedCleanup; failureScreen.m_desks = &desks;
+  failureScreen.fakeAllKeysUp();
+  check(boundary.cleanups == 1 && boundary.warnings == 2 && failedCleanup.released == 1,
+        "failed partial-batch neutral cleanup is logged and cannot swallow the real modifier release");
+
+  // 下列场景执行真实 KeyMap 及提取的 Windows wrappers/fakeKey，不复制转换算法。
+  boundary = {};
+  {
+    MSWindowsKeyState unmasked(map, desks);
+    unmasked.KeyState::fakeKeyDown(kKeyControl_L, 0, 0x70, "en");
+    unmasked.KeyState::fakeKeyDown(kKeyShift_L, KeyModifierAlt | KeyModifierShift, 0x71, "en");
+  }
+  const auto originalShiftSequence = boundary.keys;
+  check(std::any_of(originalShiftSequence.begin(), originalShiftSequence.end(), [](const auto &key) {
+          return key.vk == VK_LMENU && (key.flags & KEYEVENTF_KEYUP) != 0;
+        }), "real KeyMap Shift-with-Alt mapping contains the temporary Alt release reported in the field");
+  boundary = {};
+  {
+    MSWindowsKeyState scoped(map, desks);
+    scoped.fakeKeyDown(kKeyControl_L, 0, 0x70, "en");
+    scoped.fakeKeyDown(kKeyShift_L, KeyModifierAlt | KeyModifierShift, 0x71, "en");
+  }
+  check(boundary.keys == originalShiftSequence, "temporary masking preserves the complete generated native key sequence");
+  int temporaryUps = 0;
+  for (size_t i = 0; i < boundary.trace.size(); ++i) {
+    const auto &event = boundary.trace[i];
+    if (!event.mask && event.vk == VK_LMENU && (event.flags & KEYEVENTF_KEYUP) != 0) {
+      ++temporaryUps;
+      check(i != 0 && boundary.trace[i - 1].mask, "every internally generated Alt-up is immediately preceded by neutral masking");
+    }
+  }
+  check(temporaryUps > 0 && boundary.masks == temporaryUps && g_menuReleaseMaskDepth == 0,
+        "only temporary Alt releases are masked and the wrapper scope is restored");
+
+  boundary = {};
+  MSWindowsKeyState repeated(map, desks);
+  repeated.fakeKeyDown(kKeyShift_L, KeyModifierAlt | KeyModifierShift, 0x70, "en");
+  const int beforeRepeat = boundary.masks;
+  check(repeated.fakeKeyRepeat(kKeyShift_L, KeyModifierAlt | KeyModifierShift, 2, 0x70, "en"),
+        "Windows repeat wrapper keeps the real repeat mapping");
+  check(boundary.masks > beforeRepeat && g_menuReleaseMaskDepth == 0,
+        "repeat-generated temporary Alt-up is masked without leaving its scope active");
+  boundary.maxDepth = 0;
+  repeated.fakeKeyDown(kKeyShift_L, KeyModifierAlt | KeyModifierShift, 0x70, "en");
+  check(boundary.maxDepth >= 2 && g_menuReleaseMaskDepth == 0,
+        "duplicate down can nest through the virtual repeat wrapper and still restores scope depth");
+
+  boundary = {};
+  MSWindowsKeyState implicit(map, desks);
+  implicit.fakeKeyDown(kKeyAlt_L, KeyModifierAlt, 0x70, "en");
+  boundary.keys.clear(); boundary.trace.clear();
+  implicit.reconcileKeyRelease(kKeyAlt_L, 0);
+  check(boundary.masks == 1 && !boundary.keys.empty() && boundary.keys.back().vk == VK_LMENU &&
+        (boundary.keys.back().flags & KEYEVENTF_KEYUP) != 0 && g_menuReleaseMaskDepth == 0,
+        "implicit modifier reconciliation masks its synthesized Alt release");
+
+  for (const auto &modifier : menuModifiers) {
+    boundary = {};
+    MSWindowsKeyState tap(map, desks);
+    tap.fakeKeyDown(modifier.id, modifier.mask, 0x70, "en");
+    check(tap.fakeKeyUp(0x70) && boundary.masks == 0,
+          "explicit same-screen Windows Alt or Win tap is never within the temporary-release scope");
+    tap.reconcileKeyRelease(modifier.id, 0);
+    check(boundary.masks == 0, "reconciliation after an explicit tap does not add a second menu mask");
+  }
+
+  for (const auto &shortcut : std::array{Modifier{kKeyTab, 0x0f, 0, VK_TAB}, Modifier{'f', 0x21, 0, 'F'}}) {
+    boundary = {};
+    {
+      MSWindowsKeyState baseline(map, desks);
+      baseline.KeyState::fakeKeyDown(kKeyAlt_L, KeyModifierAlt, 0x70, "en");
+      baseline.KeyState::fakeKeyDown(shortcut.id, KeyModifierAlt, 0x71, "en");
+      baseline.fakeKeyUp(0x71); baseline.fakeKeyUp(0x70);
+    }
+    const auto original = boundary.keys;
+    boundary = {};
+    {
+      MSWindowsKeyState scoped(map, desks);
+      scoped.fakeKeyDown(kKeyAlt_L, KeyModifierAlt, 0x70, "en");
+      scoped.fakeKeyDown(shortcut.id, KeyModifierAlt, 0x71, "en");
+      scoped.fakeKeyUp(0x71); scoped.fakeKeyUp(0x70);
+    }
+    check(boundary.keys == original, "Alt-Tab and Alt-F retain the exact original generated key sequence");
+    check(boundary.masks == 0, "a real held-Alt shortcut is not treated as an artificial Alt release");
+  }
+
+  boundary = {}; boundary.throwMask = true;
+  bool threw = false;
+  try {
+    MSWindowsKeyState interrupted(map, desks);
+    interrupted.fakeKeyDown(kKeyShift_L, KeyModifierAlt | KeyModifierShift, 0x70, "en");
+  } catch (const std::runtime_error &) { threw = true; }
+  check(threw && g_menuReleaseMaskDepth == 0, "an exception at the desktop boundary unwinds the temporary menu scope");
+  boundary = {};
+  MSWindowsKeyState afterException(map, desks);
+  afterException.fakeKeyDown(kKeyAlt_L, KeyModifierAlt, 0x70, "en");
+  afterException.fakeKeyUp(0x70);
+  check(boundary.masks == 0, "an earlier failed emulation cannot mask a later ordinary Alt tap");
+  unsigned otherThreadDepth = 99;
+  {
+    MenuReleaseMaskScope outer;
+    std::thread other([&] { otherThreadDepth = g_menuReleaseMaskDepth; });
+    other.join();
+    check(otherThreadDepth == 0 && g_menuReleaseMaskDepth == 1,
+          "menu emulation depth is isolated per thread");
+  }
+  check(g_menuReleaseMaskDepth == 0, "the outer test scope restores its original depth");
+  std::printf("PASS: %d receiver menu handoff checks with real KeyMap/KeyState; no desktop input injected.\n", checks);
+}
