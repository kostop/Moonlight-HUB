+  // 参数 virtualKey/button：本次物理按下；local：本次确实会放行本机；started：回调起始代数。
+  void capture(UINT virtualKey, uint16_t button, bool local, uint32_t started)
+  {
+    const int slot = index(virtualKey, button);
+    if (slot < 0) return;
+    auto old = keys[slot].load();
+    const uint64_t fresh = (static_cast<uint64_t>(started) << 3) | (local ? Local : Remote);
+    uint64_t next = old;
+    if (old == 0 || ((old & kResyncDown) != 0 && (GetAsyncKeyState(virtualKey) & 0x8000) == 0)) {
+      next = fresh;
+    } else {
+      next &= ~kResyncDown;
+      // 远端起源的重复按下返回本机后若被放行，须接管其 native up，但保留已经跨屏的代数。
+      if (local) next = (next & ~kOriginMask) | Local;
+    }
+    keys[slot].compare_exchange_strong(old, next);
+  }
+
+  // 参数 virtualKey/button：物理松开；奇数代数表示切换发布中，保守视作跨屏，不等待主线程。
+  Release release(UINT virtualKey, uint16_t button)
+  {
+    const int slot = index(virtualKey, button);
+    if (slot < 0) return {};
+    const auto held = keys[slot].exchange(0);
+    const auto started = static_cast<uint32_t>(held >> 3);
+    return {static_cast<Origin>(held & kOriginMask), (started & 1u) != 0 || started != epoch.load()};
+  }
