+    switch (virtualKey) {
+    case VK_MENU: return (button & 0x100u) ? 1 : 0;
+    case VK_LMENU: return 0;
+    case VK_RMENU: return 1;
+    case VK_LWIN: return 2;
+    case VK_RWIN: return 3;
