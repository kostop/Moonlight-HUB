--- /dev/null
+++ b/src/lib/platform/MSWindowsMenuMask.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception */
+#pragma once
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <Windows.h>
+
+namespace deskflow::win32 {
+
+inline constexpr WORD kMenuMaskVirtualKey = 0xe8;
+inline constexpr ULONG_PTR kMenuMaskTag = 0x4d484d4bu;
+
+// 参数 down：仅生成本核心的菜单抑制键，不使用 Ctrl、Esc 或普通字符。
+inline INPUT makeMenuMaskKey(bool down)
+{
+  INPUT input{};
+  input.type = INPUT_KEYBOARD;
+  input.ki.wVk = kMenuMaskVirtualKey;
+  input.ki.dwFlags = down ? 0 : KEYEVENTF_KEYUP;
+  input.ki.dwExtraInfo = kMenuMaskTag;
+  return input;
+}
+
+// 参数 event：低级钩子原始事件；只放行本核心带标签、无扫描码的 E8 注入。
+inline bool isTaggedMenuMask(const KBDLLHOOKSTRUCT &event)
+{
+  return event.vkCode == kMenuMaskVirtualKey && event.scanCode == 0 &&
+         event.dwExtraInfo == kMenuMaskTag && (event.flags & LLKHF_INJECTED) != 0;
+}
+
+} // namespace deskflow::win32
