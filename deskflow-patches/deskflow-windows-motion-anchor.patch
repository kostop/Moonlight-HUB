+// 参数 code/message/data：原始鼠标回调；只记录成功放行的位置，不覆盖重入回调更新的锚点。
+static LRESULT passMouseEvent(int code, WPARAM message, LPARAM data)
+{
+  if (code < 0 || !g_isPrimary || message != WM_MOUSEMOVE) {
+    return CallNextHookEx(g_mouseLL, code, message, data);
+  }
+  const POINT position = reinterpret_cast<const MSLLHOOKSTRUCT *>(data)->pt;
+  const DWORD thread = GetCurrentThreadId();
+  uint64_t version;
+  bool belongsToThread;
+  {
+    std::scoped_lock lock(g_mouseMotion.mutex);
+    version = g_mouseMotion.cursorVersion;
+    belongsToThread = g_mouseMotion.cursorThread == 0 || g_mouseMotion.cursorThread == thread;
+  }
+  const LRESULT result = CallNextHookEx(g_mouseLL, code, message, data);
+  if (result == 0 && belongsToThread) {
+    std::scoped_lock lock(g_mouseMotion.mutex);
+    if (version == g_mouseMotion.cursorVersion) {
+      g_mouseMotion.cursorAnchor = position;
+      g_mouseMotion.cursorValid = true;
+      ++g_mouseMotion.cursorVersion;
+    }
+  }
+  return result;
+}
