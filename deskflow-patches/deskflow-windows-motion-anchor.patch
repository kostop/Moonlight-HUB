+  const bool haveCursor = GetPhysicalCursorPos(&actual) != FALSE;
+  if (dpiContext != nullptr) {
+    SetThreadDpiAwarenessContext(dpiContext);
+  }
+  std::scoped_lock lock(g_mouseMotion.mutex);
+  if (g_mouseMotion.cursorThread != 0 && g_mouseMotion.cursorThread != thread) {
+    return false;
+  }
+  if (!g_mouseMotion.cursorValid && haveCursor && version == g_mouseMotion.cursorVersion) {
+    g_mouseMotion.cursorAnchor = actual;
+    g_mouseMotion.cursorValid = true;
+    ++g_mouseMotion.cursorVersion;
+  }
+  position = g_mouseMotion.cursorAnchor;
