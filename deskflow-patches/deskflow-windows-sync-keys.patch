diff --git a/src/lib/platform/MSWindowsKeySnapshot.h b/src/lib/platform/MSWindowsKeySnapshot.h
new file mode 100644
--- /dev/null
+++ b/src/lib/platform/MSWindowsKeySnapshot.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception */
+#pragma once
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <Windows.h>
+
+namespace deskflow::win32 {
+
+// 源端按键快照：主线程不接收键盘消息，GetKeyboardState 的同步状态会残留早已松开的
+// Alt/Ctrl/Win，每次离开本机重建记账时就变成“远端一直按着修饰键”。改按实时状态逐键查询。
+// 参数 isDown：查询某虚拟键当前是否按下；toButton：虚拟键到按钮的映射，0 表示无对应按钮；
+// insert：接收按下的按钮。
+template <typename IsDown, typename ToButton, typename Insert>
+void pollRealtimePressedKeys(IsDown isDown, ToButton toButton, Insert insert)
+{
+  for (UINT virtualKey = 1; virtualKey < 256; ++virtualKey) {
+    // 通用 Shift/Ctrl/Alt 由左右键分别查询，避免只按右键时把左键也记成按下。
+    if (virtualKey == VK_SHIFT || virtualKey == VK_CONTROL || virtualKey == VK_MENU) continue;
+    if (!isDown(virtualKey)) continue;
+    if (const auto button = toButton(virtualKey); button != 0) insert(button);
+  }
+}
+
+} // namespace deskflow::win32
