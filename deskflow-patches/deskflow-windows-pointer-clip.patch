+static POINT clipToMonitor(POINT position)
+{
+  MONITORINFO info{};
+  info.cbSize = sizeof(info);
+  const HMONITOR monitor = MonitorFromPoint(position, MONITOR_DEFAULTTONEAREST);
+  if (monitor != nullptr && GetMonitorInfo(monitor, &info)) {
+    position.x = std::clamp(position.x, info.rcMonitor.left, info.rcMonitor.right - 1);
+    position.y = std::clamp(position.y, info.rcMonitor.top, info.rcMonitor.bottom - 1);
+  }
+  return position;
+}
