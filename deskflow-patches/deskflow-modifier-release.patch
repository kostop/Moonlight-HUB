diff --git a/tools/test-desktop-focus.cpp b/tools/test-desktop-focus.cpp
new file mode 100644
--- /dev/null
+++ b/tools/test-desktop-focus.cpp
@@ -0,0 +1,166 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception */
+#define WIN32_LEAN_AND_MEAN
+#include <Windows.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+// 编译当前生产桌面交接方法体，只模拟 Win32 边界；不接触真实前台、输入队列或键盘。
+namespace {
+struct WindowPlacement {
+  HWND window;
+  HWND insertAfter;
+  int x, y, width, height;
+  UINT flags;
+};
+struct Fixture {
+  HWND application = reinterpret_cast<HWND>(1);
+  HWND foreground = application;
+  int activations = 0;
+  int foregroundChanges = 0;
+  int attachments = 0;
+  int threadQueries = 0;
+  int foregroundQueries = 0;
+  int enabled = 0;
+  int disabled = 0;
+  int capture = 0;
+  int releases = 0;
+  int moves = 0;
+  int layoutChanges = 0;
+  int sleeps = 0;
+  HKL layout = nullptr;
+  std::vector<bool> visibility;
+  std::vector<WindowPlacement> placements;
+} f;
+int checks = 0;
+
+// success/message：断言结果与对应行为说明。
+void check(bool success, const char *message)
+{
+  ++checks;
+  if (!success) { std::fprintf(stderr, "FAIL: %s\n", message); std::exit(1); }
+}
+
+// Win32 调用只记录参数，不调用 user32。
+BOOL WINAPI place(HWND window, HWND after, int x, int y, int width, int height, UINT flags)
+{
+  f.placements.push_back({window, after, x, y, width, height, flags});
+  return TRUE;
+}
+DWORD WINAPI threadOf(HWND window, LPDWORD)
+{
+  ++f.threadQueries;
+  return window == nullptr ? 0 : (window == f.application ? 11 : 12);
+}
+BOOL WINAPI attach(DWORD, DWORD, BOOL) { ++f.attachments; return TRUE; }
+BOOL WINAPI foreground(HWND window) { ++f.foregroundChanges; f.foreground = window; return TRUE; }
+HWND WINAPI active(HWND window) { ++f.activations; return window; }
+BOOL WINAPI enable(HWND, BOOL enabled) { enabled ? ++f.enabled : ++f.disabled; return TRUE; }
+HKL WINAPI layout(HKL value, UINT) { ++f.layoutChanges; f.layout = value; return value; }
+HWND WINAPI getForeground() { ++f.foregroundQueries; return f.foreground; }
+HWND WINAPI capture(HWND window) { ++f.capture; return window; }
+BOOL WINAPI release() { ++f.releases; return TRUE; }
+}
+
+#define LOG_DEBUG1(...) ((void)0)
+#define SetWindowPos place
+#define GetWindowThreadProcessId threadOf
+#define AttachThreadInput attach
+#define SetForegroundWindow foreground
+#define SetActiveWindow active
+#define EnableWindow enable
+#define ActivateKeyboardLayout layout
+#define GetForegroundWindow getForeground
+#define SetCapture capture
+#define ReleaseCapture release
+
+void setCursorVisibility(bool visible) { f.visibility.push_back(visible); }
+struct Arch { void sleep(double) { ++f.sleeps; } } arch;
+#define ARCH (&arch)
+
+class MSWindowsDesks {
+public:
+  struct Desk {
+    HWND m_window = reinterpret_cast<HWND>(2);
+    HWND m_foregroundWindow = nullptr;
+    bool m_lowLevel = true;
+  };
+  bool m_isPrimary = true;
+  bool m_leaveForegroundOption = true;
+  int m_xCenter = 960, m_yCenter = 540;
+  int m_x = -1280, m_y = 0, m_w = 3840, m_h = 1440;
+  void deskEnter(Desk *desk);
+  void deskLeave(Desk *desk, HKL keyLayout);
+  HWND getForegroundWindow() const;
+  void deskMouseMove(int, int) const { ++f.moves; }
+};
+
+// 由测试脚本从当前生产源提取，禁止手工维护待测方法的副本。
+#include "desktop-focus-production.inc"
+
+int main()
+{
+  MSWindowsDesks desks;
+  MSWindowsDesks::Desk desk;
+  const auto keyboardLayout = reinterpret_cast<HKL>(0x4090409);
+  desks.deskLeave(&desk, keyboardLayout);
+  check(f.placements.size() == 1 && f.placements[0].width == 1 && f.placements[0].height == 1,
+        "low-level handoff retains its one-pixel parking window");
+  check(f.placements[0].x == 960 && f.placements[0].y == 540 &&
+        (f.placements[0].flags & (SWP_NOACTIVATE | SWP_SHOWWINDOW)) == (SWP_NOACTIVATE | SWP_SHOWWINDOW),
+        "parking window remains at the cursor center and never requests activation");
+  check(f.foreground == f.application && desk.m_foregroundWindow == nullptr,
+        "the application that received the original key-down keeps keyboard focus");
+  check(f.layoutChanges == 1 && f.layout == keyboardLayout,
+        "keeping the foreground preserves hook-thread keyboard layout selection");
+  check(f.activations == 0 && f.foregroundChanges == 0 && f.attachments == 0 && f.threadQueries == 0,
+        "kept foreground does not activate a window or join input queues on leave");
+  check(f.foregroundQueries == 0 && f.enabled == 0,
+        "kept foreground leaves the disabled hider disabled without querying another application");
+  desks.deskEnter(&desk);
+  check(f.foreground == f.application && f.activations == 0 && f.foregroundChanges == 0,
+        "return does not restore a foreground window that was never taken");
+  check(f.attachments == 0 && f.threadQueries == 0,
+        "return with no saved window does not call AttachThreadInput with a zero thread");
+  check(f.disabled == 1 && (f.placements.back().flags & (SWP_NOACTIVATE | SWP_HIDEWINDOW)) ==
+        (SWP_NOACTIVATE | SWP_HIDEWINDOW), "return still hides and disables the one-pixel window");
+  check(f.visibility.empty() && f.moves == 0 && f.sleeps == 0,
+        "primary handoff does not change cursor visibility, inject movement, or wait");
+
+  f = {};
+  desks.m_leaveForegroundOption = false;
+  desks.deskLeave(&desk, keyboardLayout);
+  check(desk.m_foregroundWindow == f.application && f.foreground == desk.m_window,
+        "explicit legacy foreground-grab option still saves and activates the hider");
+  check(f.enabled == 1 && f.activations == 1 && f.attachments == 2 && f.foregroundChanges == 1,
+        "legacy foreground-grab handoff retains its established Win32 calls");
+  desks.deskEnter(&desk);
+  check(f.foreground == f.application && desk.m_foregroundWindow == nullptr,
+        "a genuinely saved foreground is restored and then forgotten");
+  check(f.attachments == 4 && f.foregroundChanges == 2 && f.disabled == 1,
+        "saved foreground restoration keeps the original input attachment pair");
+
+  f = {};
+  desk.m_lowLevel = false;
+  desks.deskLeave(&desk, keyboardLayout);
+  check(f.placements[0].x == -1280 && f.placements[0].width == 3840 && f.placements[0].height == 1440,
+        "non-low-level mode retains its desktop-sized parking window");
+  check(f.activations == 1 && f.layoutChanges == 1 && f.attachments == 0,
+        "non-low-level mode still activates its window and selects the keyboard layout");
+  desks.deskEnter(&desk);
+  check(f.enabled == 1 && f.attachments == 0 && f.foregroundChanges == 0,
+        "non-low-level return still enables its window without restoring an absent saved focus");
+
+  f = {};
+  desks.m_isPrimary = false;
+  desks.deskLeave(&desk, keyboardLayout);
+  check(f.visibility == std::vector<bool>{false} && f.capture == 1 && f.moves == 1 && f.sleeps == 1,
+        "secondary leave retains cursor hiding, capture, and its legacy parking wait");
+  desks.deskEnter(&desk);
+  check(f.visibility == std::vector<bool>({false, true}) && f.releases == 1,
+        "secondary enter still restores visibility and releases capture");
+  check(f.foregroundChanges == 0 && f.attachments == 0 && f.activations == 0,
+        "secondary screens with no saved foreground do not steal another application's focus");
+  std::printf("PASS: %d extracted desktop focus checks; no real foreground or input operation.\n", checks);
+}
