index 0000000..2ae51c0
--- /dev/null
+++ b/tools/build-pointer-core.ps1
@@ -0,0 +1,49 @@
+﻿[CmdletBinding()]
+param(
+    # QtRoot：Qt 6.7+ 的 MSVC x64 SDK 目录。
+    [Parameter(Mandatory = $true)][string]$QtRoot,
+    # OpenSslRoot：包含 include/openssl 和 lib/*.lib 的 OpenSSL SDK 目录。
+    [Parameter(Mandatory = $true)][string]$OpenSslRoot,
+    # BuildDir：独立的编译产物目录，不与 Sunshine 或 Hub 共用。
+    [Parameter(Mandatory = $true)][string]$BuildDir,
+    # CMake：CMake 可执行文件路径；需要 Ninja 已加入 PATH。
+    [string]$CMake = 'cmake',
+    # Jobs：并行编译数量。
+    [int]$Jobs = 6,
+    # TestRouting：编译并运行不接管键鼠的跨屏路由测试。
+    [switch]$TestRouting
+)
+
+$ErrorActionPreference = 'Stop'
+$sourceRoot = Split-Path -Parent $PSScriptRoot
+$vsRoot = 'C:\Program Files\Microsoft Visual Studio\2022\Community'
+$msvcRoot = (Get-ChildItem -LiteralPath "$vsRoot\VC\Tools\MSVC" -Directory |
+    Sort-Object Name -Descending | Select-Object -First 1).FullName
+$sdkRoot = 'C:\Program Files (x86)\Windows Kits\10'
+$sdkVersion = (Get-ChildItem -LiteralPath "$sdkRoot\Include" -Directory |
+    Where-Object { Test-Path -LiteralPath "$($_.FullName)\um\Windows.h" } |
+    Sort-Object Name -Descending | Select-Object -First 1).Name
+if (!$msvcRoot -or !$sdkVersion) { throw 'MSVC or Windows SDK is missing.' }
+$env:INCLUDE = "$msvcRoot\include;$sdkRoot\Include\$sdkVersion\ucrt;$sdkRoot\Include\$sdkVersion\shared;$sdkRoot\Include\$sdkVersion\um"
+$env:LIB = "$msvcRoot\lib\x64;$sdkRoot\Lib\$sdkVersion\ucrt\x64;$sdkRoot\Lib\$sdkVersion\um\x64"
+$env:PATH = "$msvcRoot\bin\Hostx64\x64;$sdkRoot\bin\$sdkVersion\x64;$QtRoot\bin;$env:PATH"
+$env:VSLANG = '1033'
+
+& $CMake -S $sourceRoot -B $BuildDir -G Ninja `
+    -DCMAKE_C_COMPILER=cl -DCMAKE_CXX_COMPILER=cl -DCMAKE_BUILD_TYPE=Release `
+    "-DCMAKE_PREFIX_PATH=$QtRoot" "-DOPENSSL_ROOT_DIR=$OpenSslRoot" `
+    -DCMAKE_NINJA_CMCLDEPS_RC=OFF `
+    -DBUILD_TESTS=OFF -DBUILD_INSTALLER=OFF -DBUILD_USER_DOCS=OFF
+if ($LASTEXITCODE -ne 0) { throw 'CMake configuration failed.' }
+# 完整重编译：部分中文 MSVC 的 /showIncludes 依赖识别失败，类布局变化不能混用旧对象文件。
+& $CMake --build $BuildDir --target deskflow-core --clean-first -j $Jobs
+if ($LASTEXITCODE -ne 0) { throw 'Deskflow core build failed.' }
+if ($TestRouting) {
+    & cl /nologo /utf-8 /EHsc /std:c++20 /Zc:__cplusplus /permissive- /MD `
+        "/I$sourceRoot\src\lib" "/I$QtRoot\include" "/I$QtRoot\include\QtCore" `
+        "$PSScriptRoot\test-monitor-routing.cpp" "/Fe:$BuildDir\test-monitor-routing.exe" "/Fo:$BuildDir\test-monitor-routing.obj" `
+        /link "/LIBPATH:$QtRoot\lib" Qt6Core.lib
+    if ($LASTEXITCODE -ne 0) { throw 'Monitor routing test build failed.' }
+    & "$BuildDir\test-monitor-routing.exe"
+    if ($LASTEXITCODE -ne 0) { throw 'Monitor routing tests failed.' }
+}
