diff --git a/src/lib/platform/MSWindowsLocalKeyRelease.h b/src/lib/platform/MSWindowsLocalKeyRelease.h
new file mode 100644
index 0000000..b2b16d3
--- /dev/null
+++ b/src/lib/platform/MSWindowsLocalKeyRelease.h
@@ -0,0 +1,96 @@
+/*
+ * Deskflow -- mouse and keyboard sharing utility
+ * SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception
+ */
+
+#pragma once
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <Windows.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+namespace deskflow::win32 {
+
+// 仅标记“本机按下、离开后物理松开”的补发释放，不能把全部注入输入放行。
+inline constexpr ULONG_PTR kLocalKeyReleaseTag = 0x4d484c55u;
+
+// 参数 virtualKey：左右独立的虚拟键；button：低 8 位扫描码，0x100 为扩展键。
+inline INPUT makeLocalKeyRelease(WORD virtualKey, uint16_t button)
+{
+  INPUT input{};
+  input.type = INPUT_KEYBOARD;
+  input.ki.wVk = virtualKey;
+  input.ki.wScan = static_cast<WORD>(button & 0xffu);
+  input.ki.dwFlags = KEYEVENTF_KEYUP | ((button & 0x100u) ? KEYEVENTF_EXTENDEDKEY : 0);
+  input.ki.dwExtraInfo = kLocalKeyReleaseTag;
+  return input;
+}
+
+// 参数 event：低级键盘钩子收到的原始事件；只接受本模块带标记的注入释放。
+inline bool isLocalKeyRelease(const KBDLLHOOKSTRUCT &event)
+{
+  return event.dwExtraInfo == kLocalKeyReleaseTag &&
+         (event.flags & (LLKHF_INJECTED | LLKHF_UP)) == (LLKHF_INJECTED | LLKHF_UP);
+}
+
+class LocalKeyReleaseState
+{
+public:
+  // 参数 button：离开主屏前已经在本机按下的扫描码；已有失败释放不能被覆盖。
+  void capture(uint16_t button)
+  {
+    if (find(button) == m_keys.end()) {
+      m_keys.push_back({button, false});
+    }
+  }
+
+  // 进入本机后真实松开会直接到达系统，仅保留已经失败的补发释放。
+  void forgetHeldKeys()
+  {
+    std::erase_if(m_keys, [](const auto &key) { return !key.released; });
+  }
+
+  // 参数 button/down：真实按键事件；send：精确补发释放，成功返回 true。
+  template <typename Send> bool onKey(uint16_t button, bool down, Send send)
+  {
+    auto key = find(button);
+    if (key == m_keys.end()) {
+      return false;
+    }
+    if (down) {
+      // 新按下暂停旧的失败释放，等这一次真实松开再补发，避免遗留本机按下状态。
+      key->released = false;
+      return false;
+    }
+    key->released = true;
+    if (send(button)) {
+      m_keys.erase(key);
+    }
+    return true;
+  }
+
+  // 参数 send：只重试已经收到真实 key-up 的记录；不扫描或释放其它按键。
+  template <typename Send> void retry(Send send)
+  {
+    std::erase_if(m_keys, [&](const auto &key) { return key.released && send(key.button); });
+  }
+
+private:
+  struct Key
+  {
+    uint16_t button;
+    bool released;
+  };
+  std::vector<Key>::iterator find(uint16_t button)
+  {
+    return std::find_if(m_keys.begin(), m_keys.end(), [button](const auto &key) { return key.button == button; });
+  }
+  std::vector<Key> m_keys;
+};
+
+} // namespace deskflow::win32
