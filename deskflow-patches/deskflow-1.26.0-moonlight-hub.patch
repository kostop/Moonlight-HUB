@@ -0,0 +1,377 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception */
+#include "platform/MSWindowsHook.h"
+#include "base/Event.h"
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <deque>
+#include <functional>
+#include <set>
+#include <vector>
+
+// 脚本抽取当前生产方法体；这里只替换它们依赖的桌面、消息队列和事件分发边界。
+// 不构造完整生产类，不验证 Windows 实际调度，不安装钩子或向桌面注入输入。
+namespace {
+struct Fixture {
+  POINT physical{960, 540};
+  POINT pending{-12, 7};
+  bool warpSuccess = true;
+  bool cursorAvailable = true;
+  bool returnSuccess = true;
+  bool released = false;
+  bool focusAfterRelease = false;
+  int peekCalls = 0;
+  int sleepCalls = 0;
+  int fakeMoves = 0;
+  int returnCalls = 0;
+  int deskCalls = 0;
+  int continueCalls = 0;
+  int events = 0;
+  int routes = 0;
+  int consumed = 0;
+  int checks = 0;
+  uint64_t lastToken = 0;
+  uint64_t absorbedThrough = 0;
+  POINT ack{};
+  POINT delivered{};
+  std::function<void()> onMotion;
+  std::vector<int> order;
+  std::vector<bool> buttonDestinations;
+  std::set<uint64_t> consumedTokens;
+  std::vector<MSG> queue;
+} f;
+
+// 参数 success：断言结果；message：失败时输出的行为说明。
+void check(bool success, const char *message)
+{
+  ++f.checks;
+  if (!success) {
+    std::fprintf(stderr, "FAIL: %s\n", message);
+    std::exit(1);
+  }
+}
+
+// 参数 message/first/last/remove：模拟当前线程的精确消息过滤及移除，不访问系统队列。
+BOOL WINAPI peek(LPMSG message, HWND, UINT first, UINT last, UINT remove)
+{
+  ++f.peekCalls;
+  auto match = std::find_if(f.queue.begin(), f.queue.end(), [&](const MSG &entry) {
+    return entry.message >= first && entry.message <= last;
+  });
+  if (match == f.queue.end()) return FALSE;
+  *message = *match;
+  if (remove & PM_REMOVE) f.queue.erase(match);
+  return TRUE;
+}
+
+// 参数 message/w/l：记录应用发出的消息，不投递真实线程消息。
+BOOL WINAPI post(DWORD, UINT message, WPARAM w, LPARAM l)
+{
+  MSG entry{};
+  entry.message = message; entry.wParam = w; entry.lParam = l;
+  f.queue.push_back(entry);
+  return TRUE;
+}
+
+// 参数 position：返回模拟物理光标位置。
+BOOL WINAPI readCursor(LPPOINT position) { *position = f.physical; return f.cursorAvailable; }
+void enqueue(UINT message) { MSG entry{}; entry.message = message; f.queue.push_back(entry); }
+bool contains(UINT message)
+{
+  return std::any_of(f.queue.begin(), f.queue.end(), [&](const MSG &entry) { return entry.message == message; });
+}
+}
+
+#define LOG_DEBUG(...) ((void)0)
+#define LOG_DEBUG1(...) ((void)0)
+#define LOG_DEBUG2(...) ((void)0)
+#define LOG_WARN(...) ((void)0)
+#undef PeekMessage
+#define PeekMessage peek
+#undef PostThreadMessage
+#define PostThreadMessage post
+#define GetCurrentThreadId() DWORD{1}
+#define GetPhysicalCursorPos readCursor
+
+struct IPlatformScreen {
+struct MotionInfo {
+  int32_t m_x, m_y;
+  uint64_t m_token;
+  static MotionInfo *alloc(int32_t x, int32_t y, uint64_t token = 0)
+  {
+    auto *motion = static_cast<MotionInfo *>(std::malloc(sizeof(MotionInfo)));
+    if (!motion) std::abort();
+    motion->m_x = x; motion->m_y = y; motion->m_token = token;
+    return motion;
+  }
+};
+struct ButtonInfo { int m_button; };
+};
+using MotionInfo = IPlatformScreen::MotionInfo;
+
+struct EventQueue {
+  std::deque<Event> queued;
+  void addEvent(Event event)
+  {
+    check((event.getFlags() & Event::EventFlags::DeliverImmediately) == 0, "input remains in its original asynchronous queue order");
+    if (event.getType() == EventTypes::PrimaryScreenMotionOnSecondary) ++f.events;
+    queued.push_back(std::move(event));
+  }
+};
+struct Arch { static void sleep(double) { ++f.sleepCalls; } };
+struct ArchMiscWindows { static void wakeupDisplay() {} };
+struct ScreenSaver { void deactivate() {} };
+struct KeyReleases { void forgetHeldKeys() {} };
+
+MSWindowsHook::~MSWindowsHook() = default;
+void MSWindowsHook::setMode(EHookMode) { f.order.push_back(5); }
+uint64_t MSWindowsHook::nextMouseMotionToken()
+{
+  return ++f.lastToken;
+}
+bool MSWindowsHook::consumeMouseMotion(uint64_t token, int32_t dx, int32_t dy)
+{
+  if (token <= f.absorbedThrough || f.consumedTokens.contains(token)) return false;
+  f.consumedTokens.insert(token); ++f.consumed;
+  f.ack = {dx, dy}; f.order.push_back(1);
+  f.pending.x -= dx; f.pending.y -= dy;
+  return true;
+}
+bool MSWindowsHook::returnMouseToPrimary(POINT &position)
+{
+  ++f.returnCalls; f.order.push_back(3);
+  position.x += f.pending.x; position.y += f.pending.y;
+  f.physical = position; f.pending = {}; f.released = true;
+  f.absorbedThrough = f.lastToken + std::count_if(f.queue.begin(), f.queue.end(), [](const MSG &entry) {
+    return entry.message == DESKFLOW_MSG_MOUSE_MOVE_DELTA;
+  });
+  // 模拟恢复本机移动后新产生的 ABS，必须不被主线程的 DELTA 清理删除。
+  enqueue(DESKFLOW_MSG_MOUSE_MOVE);
+  return f.returnSuccess;
+}
+bool MSWindowsHook::continueMouseReturn() { ++f.continueCalls; return true; }
+
+class MSWindowsDesks {
+public:
+  struct Desk {};
+  bool m_isPrimary = true;
+  bool m_isOnScreen = false;
+  void enter();
+  void enter(POINT &position);
+  void sendMessage(UINT message, WPARAM w, LPARAM l);
+  void deskEnter(Desk *)
+  {
+    ++f.deskCalls; f.order.push_back(4);
+    f.focusAfterRelease = f.released;
+    check(m_isOnScreen, "desk state is local before foreground work");
+  }
+};
+
+class MSWindowsScreen {
+public:
+  bool m_isPrimary = true;
+  bool m_isOnScreen = false;
+  int32_t m_xCursor = 2550, m_yCursor = 700;
+  bool m_screensaverActive = false;
+  unsigned m_mark = 4, m_markReceived = 3;
+  MSWindowsHook m_hook;
+  KeyReleases m_primaryKeyReleases;
+  ScreenSaver *m_screensaver = nullptr;
+  MSWindowsDesks *m_desks = nullptr;
+  EventQueue *m_events = nullptr;
+  void enter();
+  void warpCursor(int32_t x, int32_t y);
+  bool warpCursorNoFlush(int32_t x, int32_t y);
+  void saveMousePosition(int32_t x, int32_t y);
+  bool onMouseMoveDelta(int32_t dx, int32_t dy);
+  bool consumeMouseMotion(uint64_t token, int32_t dx, int32_t dy);
+  bool isPrimary() const { return m_isPrimary; }
+  bool ignore() const { return m_mark != m_markReceived; }
+  void *getEventTarget() { return this; }
+  void sendEvent(EventTypes type, void *data = nullptr);
+  void enableSpecialKeys(bool) {}
+  void setupMouseKeys() {}
+  void nextMark() { ++m_mark; }
+  bool setThisCursorPos(int32_t x, int32_t y)
+  {
+    if (f.warpSuccess) f.physical = {x, y};
+    return f.warpSuccess;
+  }
+  bool getThisCursorPos(POINT *position) { return readCursor(position) != FALSE; }
+  void fakeMouseMove(int32_t, int32_t) { ++f.fakeMoves; }
+};
+
+class Screen {
+public:
+  MSWindowsScreen *m_screen;
+  bool consumeMouseMotion(uint64_t token, int32_t dx, int32_t dy);
+};
+class PrimaryClient {
+public:
+  Screen *m_screen;
+  bool consumeMouseMotion(uint64_t token, int32_t dx, int32_t dy);
+};
+class Server {
+public:
+  PrimaryClient *m_primaryClient;
+  MSWindowsScreen *platform;
+  void handleMotionSecondaryEvent(const Event &event);
+  void handleButtonDownEvent(const Event &event);
+  void handleButtonUpEvent(const Event &event);
+  void onMouseMoveSecondary(int32_t dx, int32_t dy)
+  {
+    ++f.routes; f.delivered = {dx, dy}; f.order.push_back(2);
+    if (f.onMotion) f.onMotion();
+  }
+  void onMouseDown(int) { f.buttonDestinations.push_back(platform->m_isOnScreen); }
+  void onMouseUp(int) { f.buttonDestinations.push_back(platform->m_isOnScreen); }
+};
+
+// 此头由脚本从当前工作区源文件提取，禁止手工维护待测逻辑副本。
+#include "mouse-return-production.inc"
+
+// 参数 queue/server：按真实事件队列的 FIFO 顺序分发，生产 Server 回调决定是否消费和路由。
+void drain(EventQueue &queue, Server &server)
+{
+  while (!queue.queued.empty()) {
+    Event event = std::move(queue.queued.front()); queue.queued.pop_front();
+    switch (event.getType()) {
+    case EventTypes::PrimaryScreenMotionOnSecondary: server.handleMotionSecondaryEvent(event); break;
+    case EventTypes::PrimaryScreenButtonDown: server.handleButtonDownEvent(event); break;
+    case EventTypes::PrimaryScreenButtonUp: server.handleButtonUpEvent(event); break;
+    default: std::abort();
+    }
+    std::free(event.getData());
+  }
+}
+
+void button(EventQueue &queue, EventTypes type)
+{
+  auto *info = static_cast<IPlatformScreen::ButtonInfo *>(std::malloc(sizeof(IPlatformScreen::ButtonInfo)));
+  if (!info) std::abort();
+  info->m_button = 1;
+  queue.addEvent(Event(type, nullptr, info));
+}
+
+int main()
+{
+  EventQueue events;
+  MSWindowsDesks desks;
+  MSWindowsScreen screen;
+  screen.m_desks = &desks; screen.m_events = &events;
+  Screen routedScreen{&screen};
+  PrimaryClient primary{&routedScreen};
+  Server server{&primary, &screen};
+
+  for (bool success : {true, false}) {
+    f.queue.clear(); f.order.clear();
+    enqueue(DESKFLOW_MSG_KEY); enqueue(DESKFLOW_MSG_MOUSE_BUTTON); enqueue(DESKFLOW_MSG_MOUSE_MOVE);
+    enqueue(DESKFLOW_MSG_MOUSE_MOVE_DELTA); enqueue(DESKFLOW_MSG_SCREEN_SAVER); enqueue(DESKFLOW_MSG_DEBUG);
+    f.warpSuccess = success; f.physical = {100, 200};
+    const int peeks = f.peekCalls, sleeps = f.sleepCalls;
+    screen.warpCursor(2500, 800);
+    check(f.queue.size() == 6 && contains(DESKFLOW_MSG_MOUSE_MOVE_DELTA), "primary warp preserves every queued real input");
+    check(f.peekCalls == peeks && f.sleepCalls == sleeps, "primary warp neither scans queue nor yields the thread");
+    check(!contains(DESKFLOW_MSG_PRE_WARP) && !contains(DESKFLOW_MSG_POST_WARP), "primary warp sends no PRE or POST markers");
+    check(screen.m_xCursor == (success ? 2500 : 100) && screen.m_yCursor == (success ? 800 : 200),
+          "successful or failed primary warp saves the reached baseline");
+  }
+
+  f.order.clear(); f.queue.clear();
+  check(screen.ignore(), "fixture creates a pending mark boundary");
+  check(screen.onMouseMoveDelta(-21, 9), "delta handler consumes its message");
+  check(f.events == 1 && f.consumed == 0 && f.routes == 0 && events.queued.size() == 1,
+        "delta crosses a pending mark and remains pending until original-order server dispatch");
+  drain(events, server);
+  check(f.consumed == 1 && f.ack.x == -21 && f.ack.y == 9 && f.delivered.x == -21 && f.delivered.y == 9,
+        "server consumes the exact token and delta through PrimaryClient, Screen and Windows forwarding");
+  screen.m_isOnScreen = true;
+  f.order.clear();
+  screen.onMouseMoveDelta(8, -4);
+  check(f.events == 1 && f.consumed == 1 && f.lastToken == 2,
+        "late local delta advances its token without remote routing or duplicate consumption");
+  screen.m_isOnScreen = false;
+  f.order.clear();
+  screen.onMouseMoveDelta(0, 0);
+  check(f.events == 1 && f.consumed == 1 && f.lastToken == 3,
+        "zero movement advances its token without allocating a route event");
+
+  for (bool confirmed : {true, false}) {
+    f.returnSuccess = confirmed; f.queue.clear(); f.order.clear(); f.released = false;
+    f.pending = {-12, 7}; screen.m_xCursor = 2550; screen.m_yCursor = 700; screen.m_isOnScreen = false;
+    enqueue(DESKFLOW_MSG_KEY); enqueue(DESKFLOW_MSG_MOUSE_BUTTON); enqueue(DESKFLOW_MSG_MOUSE_WHEEL);
+    enqueue(DESKFLOW_MSG_MOUSE_MOVE); enqueue(DESKFLOW_MSG_MOUSE_MOVE_DELTA); enqueue(DESKFLOW_MSG_MOUSE_MOVE_DELTA);
+    enqueue(DESKFLOW_MSG_SCREEN_SAVER); enqueue(DESKFLOW_MSG_DEBUG);
+    const uint64_t beforeTokens = f.lastToken;
+    screen.enter();
+    check(f.focusAfterRelease && f.order.size() >= 3 && f.order[0] == 3 && f.order[1] == 4,
+          "hook thread transfers pending movement and releases before foreground work");
+    check(screen.m_isOnScreen && screen.m_xCursor == 2538 && screen.m_yCursor == 707,
+          "synchronous desktop return writes the final landing position back into the screen");
+    check(!contains(DESKFLOW_MSG_MOUSE_MOVE_DELTA) && f.queue.size() == 7,
+          "return clears only incorporated DELTA messages, preserving new ABS and other events");
+    check(f.lastToken == beforeTokens + 2, "each discarded raw delta advances its original-order token");
+    check(contains(DESKFLOW_MSG_KEY) && contains(DESKFLOW_MSG_MOUSE_BUTTON) && contains(DESKFLOW_MSG_MOUSE_WHEEL) &&
+          contains(DESKFLOW_MSG_MOUSE_MOVE) && contains(DESKFLOW_MSG_SCREEN_SAVER) && contains(DESKFLOW_MSG_DEBUG),
+          "keyboard, buttons, wheel, ABS, screensaver and debug messages survive return");
+  }
+
+  const int returns = f.returnCalls;
+  screen.enter();
+  check(f.returnCalls == returns, "already local enter avoids transferring pending movement twice");
+
+  f.order.clear(); f.queue.clear(); f.pending = {-16, 8}; f.warpSuccess = true;
+  screen.m_isOnScreen = false;
+  enqueue(DESKFLOW_MSG_MOUSE_MOVE_DELTA); enqueue(DESKFLOW_MSG_KEY);
+  button(events, EventTypes::PrimaryScreenButtonDown);
+  button(events, EventTypes::PrimaryScreenButtonUp);
+  f.onMotion = [&] {
+    // 模拟同步 Server 路由在当前位移内越过边界，使用生产定位和入屏方法完成交接。
+    screen.warpCursor(2541, 702);
+    screen.enter();
+  };
+  const int routes = f.routes, consumed = f.consumed;
+  screen.onMouseMoveDelta(-9, 2);
+  screen.onMouseMoveDelta(-4, 3);
+  check(!screen.m_isOnScreen && f.routes == routes && f.buttonDestinations.empty(),
+        "collecting raw motion cannot overtake buttons already in the high-level queue");
+  drain(events, server);
+  f.onMotion = {};
+  check(screen.m_isOnScreen && screen.m_xCursor == 2534 && screen.m_yCursor == 708,
+        "routing-triggered return incorporates only movement not yet acknowledged");
+  check(f.order.size() >= 5 && f.order[0] == 1 && f.order[1] == 2 && f.order[2] == 3 && f.order[3] == 4,
+        "ordered token consumption, route, pending transfer and foreground work occur in that order");
+  check(f.buttonDestinations.size() == 2 && !f.buttonDestinations[0] && !f.buttonDestinations[1],
+        "button press and release queued before the boundary motion both reach the remote computer");
+  check(f.routes == routes + 1 && f.consumed == consumed + 1 && f.pending.x == 0 && f.pending.y == 0,
+        "old high-level motion already absorbed into the landing point is never routed or subtracted again");
+  check(contains(DESKFLOW_MSG_KEY) && contains(DESKFLOW_MSG_MOUSE_MOVE) && !contains(DESKFLOW_MSG_MOUSE_MOVE_DELTA),
+        "reentrant return removes incorporated deltas while preserving local and keyboard messages");
+
+  events.addEvent(Event(EventTypes::PrimaryScreenMotionOnSecondary, nullptr, MotionInfo::alloc(1, 2)));
+  drain(events, server);
+  check(f.routes == routes + 2 && f.consumed == consumed + 1,
+        "untagged motion from unchanged platforms retains the legacy routing path");
+
+  const int desksBeforeContinue = f.deskCalls;
+  desks.sendMessage(DESKFLOW_MSG_MOUSE_RETURN, 0, 0);
+  check(f.continueCalls == 1 && f.deskCalls == desksBeforeContinue,
+        "deferred return messages continue hook compensation without repeating foreground work");
+  const int reentrantReturns = f.returnCalls;
+  screen.m_isPrimary = false; desks.m_isPrimary = false; screen.m_isOnScreen = false;
+  screen.enter();
+  check(f.returnCalls == reentrantReturns && screen.m_isOnScreen, "secondary enter retains the original no-position path");
+
+  f.queue.clear(); f.warpSuccess = true;
+  enqueue(DESKFLOW_MSG_KEY); enqueue(DESKFLOW_MSG_MOUSE_MOVE); enqueue(DESKFLOW_MSG_MOUSE_MOVE_DELTA);
+  enqueue(DESKFLOW_MSG_DEBUG);
+  const int sleeps = f.sleepCalls;
+  check(screen.warpCursorNoFlush(100, 200), "secondary no-flush warp still succeeds");
+  check(contains(DESKFLOW_MSG_PRE_WARP) && contains(DESKFLOW_MSG_POST_WARP) && f.sleepCalls == sleeps + 1,
+        "secondary legacy warp retains markers and yielding");
+  screen.warpCursor(110, 210);
+  check(!contains(DESKFLOW_MSG_KEY) && !contains(DESKFLOW_MSG_MOUSE_MOVE) && contains(DESKFLOW_MSG_DEBUG),
+        "secondary full warp retains the legacy input-range cleanup");
+
+  std::printf("PASS: %d extracted production screen/desktop/server return checks; no desktop input injected.\n", f.checks);
+}
