@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception */
+#pragma once
+
+#include "deskflow/KeyTypes.h"
+
+namespace deskflow {
+
+// 参数 id：明确收到释放的按键；只处理非锁定修饰键，普通键与锁定键返回 0。
+inline KeyModifierMask releasedModifierMask(KeyID id)
+{
+  switch (id) {
+  case kKeyShift_L:
+  case kKeyShift_R: return KeyModifierShift;
+  case kKeyControl_L:
+  case kKeyControl_R: return KeyModifierControl;
+  case kKeyAlt_L: return KeyModifierAlt;
+  case kKeyAlt_R: return KeyModifierAlt | KeyModifierAltGr;
+  case kKeyAltGr: return KeyModifierAltGr;
+  case kKeyMeta_L:
+  case kKeyMeta_R: return KeyModifierMeta;
+  case kKeySuper_L:
+  case kKeySuper_R: return KeyModifierSuper;
+  default: return 0;
+  }
+}
+
+// 参数 id/mask：来源释放事件及释放后的修饰状态；generated：当前合成键产生的修饰位；
+// locked：是否锁定键；owned：是否由接力合成且未被真实物理事件接管。
+inline bool shouldReleaseImplicitModifier(
+    KeyID id, KeyModifierMask mask, KeyModifierMask generated, bool locked, bool owned
+)
+{
+  return owned && !locked && generated != 0 &&
+      (generated & releasedModifierMask(id) & ~mask) == generated;
+}
+
+} // namespace deskflow
