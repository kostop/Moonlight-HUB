new file mode 100644
index 0000000..17e8303
--- /dev/null
+++ b/src/lib/platform/MSWindowsCursorWarp.h
@@ -0,0 +1,62 @@
+/*
+ * Deskflow -- mouse and keyboard sharing utility
+ * SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception
+ */
+
+#pragma once
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <Windows.h>
+
+#include <algorithm>
+#include <cstdint>
+
+namespace deskflow::win32 {
+
+// 仅标记本核心的光标回位；不能与触摸提升签名或键盘补发标记混用。
+inline constexpr ULONG_PTR kCursorWarpTag = 0x4d484357u;
+
+struct CursorDesktopBounds
+{
+  int32_t x;
+  int32_t y;
+  int32_t width;
+  int32_t height;
+};
+
+// 参数 position/origin：物理像素坐标和桌面原点；extent：该轴像素数。
+// 定位到像素区间中央，避免直接用 65535/(extent-1) 在边界取到相邻像素。
+inline LONG normalizeCursorCoordinate(int32_t position, int32_t origin, int32_t extent)
+{
+  if (extent <= 0) {
+    return 0;
+  }
+  const int64_t offset = std::clamp<int64_t>(static_cast<int64_t>(position) - origin, 0, extent - 1);
+  return static_cast<LONG>(std::clamp<int64_t>((offset * 65536 + 32768) / extent, 0, 65535));
+}
+
+// 参数 x/y：目标物理像素；bounds：物理桌面范围；input：完整清零后写入的回位事件。
+inline bool makeCursorWarp(int32_t x, int32_t y, const CursorDesktopBounds &bounds, INPUT &input)
+{
+  input = {};
+  if (bounds.width <= 0 || bounds.height <= 0) {
+    return false;
+  }
+  input.type = INPUT_MOUSE;
+  input.mi.dx = normalizeCursorCoordinate(x, bounds.x, bounds.width);
+  input.mi.dy = normalizeCursorCoordinate(y, bounds.y, bounds.height);
+  input.mi.dwFlags = MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_VIRTUALDESK;
+  input.mi.dwExtraInfo = kCursorWarpTag;
+  return true;
+}
+
+// 参数 message/event：低级鼠标钩子的消息及原始数据；不放行其它注入或鼠标按键。
+inline bool isCursorWarp(WPARAM message, const MSLLHOOKSTRUCT &event)
+{
+  return message == WM_MOUSEMOVE && event.dwExtraInfo == kCursorWarpTag &&
+         (event.flags & LLMHF_INJECTED) != 0;
+}
+
+} // namespace deskflow::win32
