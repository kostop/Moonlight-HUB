+bool MSWindowsHook::consumeMouseMotion(uint64_t token, int32_t dx, int32_t dy)
+{
+  std::scoped_lock lock(g_mouseMotion.mutex);
+  if (token <= g_mouseMotion.absorbedThrough) {
