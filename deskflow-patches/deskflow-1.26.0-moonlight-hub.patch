diff --git a/tools/test-local-key-release.cpp b/tools/test-local-key-release.cpp
new file mode 100644
index 0000000..049bcbb
--- /dev/null
+++ b/tools/test-local-key-release.cpp
@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception */
+
+#include "platform/MSWindowsLocalKeyRelease.h"
+
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+using namespace deskflow::win32;
+
+static int checks = 0;
+
+// 参数 success：断言结果；message：失败时输出的行为说明。
+static void check(bool success, const char *message)
+{
+  ++checks;
+  if (!success) {
+    std::fprintf(stderr, "FAIL: %s\n", message);
+    std::exit(1);
+  }
+}
+
+int main()
+{
+  struct Modifier
+  {
+    WORD vk;
+    uint16_t scan;
+    bool extended;
+  };
+  const std::array<Modifier, 8> modifiers{{
+      {VK_LMENU, 0x038, false}, {VK_RMENU, 0x138, true},
+      {VK_LCONTROL, 0x01d, false}, {VK_RCONTROL, 0x11d, true},
+      {VK_LSHIFT, 0x02a, false}, {VK_RSHIFT, 0x036, false},
+      {VK_LWIN, 0x15b, true}, {VK_RWIN, 0x15c, true},
+  }};
+  for (const auto &key : modifiers) {
+    auto input = makeLocalKeyRelease(key.vk, key.scan);
+    check(input.type == INPUT_KEYBOARD && input.ki.wVk == key.vk, "preserve left/right virtual key");
+    check(input.ki.wScan == (key.scan & 0xff), "initialize scan code");
+    check(input.ki.dwFlags == static_cast<DWORD>(KEYEVENTF_KEYUP | (key.extended ? KEYEVENTF_EXTENDEDKEY : 0)),
+          "right Alt/Ctrl/Win release carries extended flag; right Shift does not");
+    check(input.ki.time == 0 && input.ki.dwExtraInfo == kLocalKeyReleaseTag, "zero initialized and tagged release");
+    KBDLLHOOKSTRUCT event{};
+    event.vkCode = key.vk;
+    event.scanCode = input.ki.wScan;
+    event.dwExtraInfo = input.ki.dwExtraInfo;
+    event.flags = LLKHF_INJECTED | LLKHF_UP | (key.extended ? LLKHF_EXTENDED : 0);
+    check(isLocalKeyRelease(event), "allow precisely tagged injected key-up");
+    event.flags &= ~LLKHF_UP;
+    check(!isLocalKeyRelease(event), "never bypass injected key-down");
+    event.flags = LLKHF_UP;
+    check(!isLocalKeyRelease(event), "never bypass real physical input");
+    event.flags |= LLKHF_INJECTED;
+    event.dwExtraInfo ^= 1;
+    check(!isLocalKeyRelease(event), "never bypass arbitrary injected key-up");
+  }
+
+  LocalKeyReleaseState state;
+  std::vector<uint16_t> sent;
+  auto accept = [&](uint16_t button) { sent.push_back(button); return true; };
+  auto reject = [&](uint16_t button) { sent.push_back(button); return false; };
+  state.capture(0x38);
+  state.retry(accept);
+  check(sent.empty(), "do not release a modifier still physically held across screens");
+  check(!state.onKey(0x38, true, accept), "held-key autorepeat does not release it");
+  check(sent.empty(), "autorepeat emits no synthetic release");
+  check(state.onKey(0x38, false, accept), "physical key-up repairs the original machine");
+  state.retry(accept);
+  check(sent == std::vector<uint16_t>{0x38}, "successful key-up is sent only once");
+  check(!state.onKey(0x138, false, accept), "no release for an unrelated key or other side");
+
+  state.capture(0x138);
+  state.onKey(0x138, false, reject);
+  state.forgetHeldKeys();
+  state.capture(0x138);
+  state.retry(accept);
+  check(sent == std::vector<uint16_t>({0x38, 0x138, 0x138}),
+        "failed release survives enter/leave and succeeds on an exact retry");
+  state.retry(accept);
+  check(sent.size() == 3, "successful retry is removed");
+
+  state.capture(0x1d);
+  state.onKey(0x1d, false, reject);
+  state.onKey(0x1d, true, accept);
+  state.retry(accept);
+  check(sent.size() == 4, "new physical key-down cancels pending repair before hotkey handling");
+  check(state.onKey(0x1d, false, accept), "later real key-up repairs the still held original machine key");
+  check(sent.size() == 5 && sent.back() == 0x1d, "repair resumes only once the new press is physically released");
+
+  state.capture(0x138);
+  state.capture(0x1d);
+  state.onKey(0x138, false, accept);
+  check(sent.back() == 0x138, "releasing right Alt does not release still held left Ctrl/AltGr companion");
+  state.retry(accept);
+  check(sent.size() == 6, "AltGr companion remains held until its own real key-up");
+  state.onKey(0x1d, false, accept);
+  check(sent.size() == 7 && sent.back() == 0x1d, "release AltGr companion on its own key-up");
+
+  state.capture(0x1e);
+  state.onKey(0x1e, false, accept);
+  check(sent.size() == 8 && sent.back() == 0x1e, "ordinary keys held before leave also receive exact cleanup");
+  state.capture(0x2a);
+  state.forgetHeldKeys();
+  state.onKey(0x2a, false, accept);
+  check(sent.size() == 8, "a still held key returned to primary follows normal physical release");
+
+  std::printf("PASS: %d local key release checks; no desktop input injected\n", checks);
+}
