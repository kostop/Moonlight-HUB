diff --git a/src/lib/server/MonitorTopologyRouter.h b/src/lib/server/MonitorTopologyRouter.h
new file mode 100644
index 0000000..95803a8
--- /dev/null
+++ b/src/lib/server/MonitorTopologyRouter.h
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception
+#pragma once
+
+#include <QDateTime>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <functional>
+#include <limits>
+#include <optional>
+#include <string>
+#include <vector>
+
+class MonitorTopologyRouter
+{
+public:
+  struct Motion {
+    std::string owner;
+    int32_t oldX, oldY, nextX, nextY;
+  };
+  struct Destination {
+    std::string owner;
+    int32_t x, y;
+  };
+
+  // motion：当前电脑及原始像素移动；available：该电脑是否仍连接到服务端。
+  std::optional<Destination> route(const Motion &motion, const std::function<bool(const std::string &)> &available)
+  {
+    refresh();
+    const Monitor *current = findCurrent(motion.owner, motion.oldX, motion.oldY);
+    if (current == nullptr) return std::nullopt;
+    // Windows 会把移动裁到最后一个像素；到达边缘且继续向外时仍需要跨屏。
+    auto nextX = motion.nextX;
+    auto nextY = motion.nextY;
+    if (nextX == current->nativeX && nextX < motion.oldX) --nextX;
+    else if (nextX == current->nativeX + current->w - 1 && nextX > motion.oldX) ++nextX;
+    if (nextY == current->nativeY && nextY < motion.oldY) --nextY;
+    else if (nextY == current->nativeY + current->h - 1 && nextY > motion.oldY) ++nextY;
+    if (current->contains(nextX, nextY)) return std::nullopt;
+    const auto &from = *current;
+    const double gx = from.x + (motion.oldX - from.nativeX) * from.canvasW / from.w;
+    const double gy = from.y + (motion.oldY - from.nativeY) * from.canvasH / from.h;
+    const double dx = (nextX - motion.oldX) * from.canvasW / from.w;
+    const double dy = (nextY - motion.oldY) * from.canvasH / from.h;
+    const bool exitsX = (dx < 0 && nextX < from.nativeX) || (dx > 0 && nextX >= from.nativeX + from.w);
+    const bool exitsY = (dy < 0 && nextY < from.nativeY) || (dy > 0 && nextY >= from.nativeY + from.h);
+    if (!exitsX && !exitsY) return std::nullopt;
+    // 同时越出两条边时按最先经过的边切屏，不能固定优先左右边。
+    const double timeX = exitsX ? ((dx > 0 ? from.x + from.canvasW : from.x) - gx) / dx
+                               : std::numeric_limits<double>::max();
+    const double timeY = exitsY ? ((dy > 0 ? from.y + from.canvasH : from.y) - gy) / dy
+                               : std::numeric_limits<double>::max();
+    bool horizontal = exitsX && (!exitsY || timeX <= timeY);
+    const double exitTime = std::clamp(horizontal ? timeX : timeY, 0.0, 1.0);
+    // horizontal：检查左右边或上下边；只沿最先穿过的边寻找最近且对齐的屏幕。
+    const auto findTarget = [&](bool horizontal) {
+      const bool positive = horizontal ? dx > 0 : dy > 0;
+      const double crossing = horizontal ? gy + dy * exitTime : gx + dx * exitTime;
+      const Monitor *target = nullptr;
+      double best = std::numeric_limits<double>::max();
+      for (const auto &candidate : m_monitors) {
+        if (&candidate == current || !available(candidate.owner)) continue;
+        const double along = horizontal
+            ? (positive ? candidate.x - (from.x + from.canvasW) : from.x - (candidate.x + candidate.canvasW))
+            : (positive ? candidate.y - (from.y + from.canvasH) : from.y - (candidate.y + candidate.canvasH));
+        if (along < -1.0) continue;
+        // 用实际过边交点选目标，半开区间让接缝点只属于一块屏，避免快速斜移时选中旧行。
+        const double acrossStart = horizontal ? candidate.y : candidate.x;
+        const double acrossEnd = acrossStart + (horizontal ? candidate.canvasH : candidate.canvasW);
+        if (crossing < acrossStart || crossing >= acrossEnd) continue;
+        const double score = std::max(0.0, along);
+        if (score < best) { best = score; target = &candidate; }
+      }
+      return target;
+    };
+    const Monitor *target = findTarget(horizontal);
+    // 正好穿过角点时两条边同样早；第一条边未连通，才允许检查另一条。
+    if (target == nullptr && exitsX && exitsY && std::abs(timeX - timeY) <= 1e-9) {
+      horizontal = !horizontal;
+      target = findTarget(horizontal);
+    }
+    if (target == nullptr) return std::nullopt;
+    const bool positive = horizontal ? dx > 0 : dy > 0;
+    double tx = std::clamp(gx + dx, target->x, target->x + target->canvasW - 1);
+    double ty = std::clamp(gy + dy, target->y, target->y + target->canvasH - 1);
+    if (horizontal) {
+      const double overshoot = std::max(0.0, positive ? gx + dx - from.x - from.canvasW : from.x - gx - dx);
+      tx = positive ? target->x + overshoot : target->x + target->canvasW - 1 - overshoot;
+    } else {
+      const double overshoot = std::max(0.0, positive ? gy + dy - from.y - from.canvasH : from.y - gy - dy);
+      ty = positive ? target->y + overshoot : target->y + target->canvasH - 1 - overshoot;
+    }
+    return Destination {target->owner,
+        static_cast<int32_t>(target->nativeX + std::clamp((tx - target->x) * target->w / target->canvasW, 0.0, target->w - 1)),
+        static_cast<int32_t>(target->nativeY + std::clamp((ty - target->y) * target->h / target->canvasH, 0.0, target->h - 1))};
+  }
+
+  // motion：用当前单块显示器限制移动；有独立屏幕拓扑时不再使用整台电脑的大矩形切屏。
+  std::optional<Destination> clamp(const Motion &motion)
+  {
+    refresh();
+    const Monitor *current = findCurrent(motion.owner, motion.oldX, motion.oldY);
+    if (current != nullptr)
+      return Destination {motion.owner,
+          static_cast<int32_t>(std::clamp(static_cast<double>(motion.nextX), current->nativeX, current->nativeX + current->w - 1)),
+          static_cast<int32_t>(std::clamp(static_cast<double>(motion.nextY), current->nativeY, current->nativeY + current->h - 1))};
+    return std::nullopt;
+  }
+
+private:
+  struct Monitor {
+    std::string owner;
+    double x, y, nativeX, nativeY, w, h, canvasW, canvasH;
+    // px/py：真实桌面的像素坐标。
+    bool contains(double px, double py) const { return px >= nativeX && py >= nativeY && px < nativeX + w && py < nativeY + h; }
+    // Windows 可能把边界位置裁到显示器外 1px；只在查找“当前显示器”时容忍这个误差。
+    bool touches(double px, double py) const
+    {
+      constexpr double kEdge = 1.5;
+      return px >= nativeX - kEdge && px < nativeX + w + kEdge &&
+             py >= nativeY - kEdge && py < nativeY + h + kEdge;
+    }
+  };
+
+  // owner/px/py：当前电脑名和真实桌面坐标；优先精确命中，再按边界容差命中。
+  const Monitor *findCurrent(const std::string &owner, int32_t px, int32_t py) const
+  {
+    for (const auto &monitor : m_monitors)
+      if (monitor.owner == owner && monitor.contains(px, py)) return &monitor;
+    for (const auto &monitor : m_monitors)
+      if (monitor.owner == owner && monitor.touches(px, py)) return &monitor;
+    return nullptr;
+  }
+  std::vector<Monitor> m_monitors;
+  qint64 m_nextCheck = 0;
+  QDateTime m_modified;
+
+  void refresh()
+  {
+    const auto now = QDateTime::currentMSecsSinceEpoch();
+    if (now < m_nextCheck) return;
+    m_nextCheck = now + 300;
+    const char *path = std::getenv("DESKFLOW_MONITOR_TOPOLOGY");
+    if (path == nullptr) return;
+    const QString filePath = QString::fromUtf8(path);
+    const QFileInfo info(filePath);
+    if (!info.exists() || info.lastModified() == m_modified) return;
+    QFile file(filePath);
+    if (!file.open(QIODevice::ReadOnly)) return;
+    QJsonParseError error;
+    const auto json = QJsonDocument::fromJson(file.readAll(), &error);
+    if (error.error != QJsonParseError::NoError || !json.isObject()) return;
+    std::vector<Monitor> updated;
+    for (const auto &value : json.object().value("monitors").toArray()) {
+      const auto item = value.toObject();
+      if (!item.value("active").toBool()) continue;
+      Monitor monitor {item.value("owner").toString().toStdString(), item.value("x").toDouble(), item.value("y").toDouble(),
+          item.value("nativeX").toDouble(), item.value("nativeY").toDouble(), item.value("width").toDouble(), item.value("height").toDouble(),
+          item.value("canvasWidth").toDouble(), item.value("canvasHeight").toDouble()};
+      if (monitor.w <= 0 || monitor.h <= 0 || monitor.canvasW <= 0 || monitor.canvasH <= 0 || monitor.owner.empty()) continue;
+      updated.push_back(std::move(monitor));
+    }
+    if (updated.empty()) return;
+    m_monitors = std::move(updated);
+    m_modified = info.lastModified();
+  }
+};
