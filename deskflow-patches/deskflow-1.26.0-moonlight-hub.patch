+void KeyState::reconcileKeyRelease(KeyID id, KeyModifierMask mask)
+{
+  if (deskflow::releasedModifierMask(id) == 0) {
+    return;
+  }
+
+  Keystrokes keys;
+  KeyButtonSet released;
+  for (const auto &[generated, key] : m_activeModifiers) {
+    const KeyButton button = key.m_button & kButtonMask;
+    if (button != 0 && m_syntheticKeys[button] > 0 &&
+        deskflow::shouldReleaseImplicitModifier(id, mask, generated, key.m_lock, m_relayOwnedKeys[button]) &&
+        released.insert(button).second) {
+      keys.emplace_back(button, false, false, m_keyClientData[button]);
+      m_keys[button] = 0;
+      m_syntheticKeys[button] = 0;
+      m_relayOwnedKeys[button] = false;
+    }
+  }
+  if (keys.empty()) {
+    return;
