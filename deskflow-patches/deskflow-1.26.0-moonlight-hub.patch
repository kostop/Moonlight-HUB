diff --git a/tools/test-modifier-reconcile.cpp b/tools/test-modifier-reconcile.cpp
new file mode 100644
index 0000000..5e896a6
--- /dev/null
+++ b/tools/test-modifier-reconcile.cpp
@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception */
+#include "deskflow/KeyState.h"
+#include "deskflow/ModifierKeyRelease.h"
+#include "base/Log.h"
+
+#include <cstdio>
+#include <cstdlib>
+
+static int checks = 0;
+static void check(bool success, const char *message)
+{
+  ++checks;
+  if (!success) {
+    std::fprintf(stderr, "FAIL: %s\n", message);
+    std::exit(1);
+  }
+}
+
+// 只提供键盘映射数据；实际状态更新和释放均调用生产 KeyState，绝不调用桌面注入。
+class FixtureMap : public deskflow::KeyMap
+{
+public:
+  const KeyItem *mapKey(
+      Keystrokes &, KeyID id, int32_t, ModifierToKeys &active, KeyModifierMask &current,
+      KeyModifierMask desired, bool, const std::string &
+  ) const override
+  {
+    if (desired & KeyModifierAlt) active.emplace(KeyModifierAlt, modifier(kKeyAlt_L, 0x38, KeyModifierAlt));
+    if (desired & KeyModifierControl) active.emplace(KeyModifierControl, modifier(kKeyControl_L, 0x1d, KeyModifierControl));
+    if (desired & KeyModifierAltGr) active.emplace(KeyModifierAltGr, modifier(kKeyAltGr, 0x138, KeyModifierAltGr));
+    current = desired;
+    m_key = modifier(id, 0x1e, 0);
+    return &m_key;
+  }
+  static KeyItem modifier(KeyID id, KeyButton button, KeyModifierMask generated)
+  {
+    KeyItem key{};
+    key.m_id = id;
+    key.m_button = button;
+    key.m_generates = generated;
+    key.m_client = button;
+    return key;
+  }
+private:
+  mutable KeyItem m_key;
+};
+
+class FixtureState : public KeyState
+{
+public:
+  explicit FixtureState(FixtureMap &map) : KeyState(nullptr, map, {"en"}, false) {}
+  int32_t pollActiveGroup() const override { return 0; }
+  KeyModifierMask pollActiveModifiers() const override { return getActiveModifiers(); }
+  bool fakeCtrlAltDel() override { return false; }
+  void pollPressedKeys(KeyButtonSet &) const override {}
+  std::vector<KeyButton> released;
+protected:
+  void getKeyMap(deskflow::KeyMap &) override {}
+  void fakeKey(const Keystroke &key) override
+  {
+    if (key.m_type == Keystroke::KeyType::Button && !key.m_data.m_button.m_press) {
+      released.push_back(key.m_data.m_button.m_button);
+    }
+  }
+};
+
+int main()
+{
+  Log log;
+  FixtureMap map;
+  FixtureState state(map);
+  state.fakeKeyDown('a', KeyModifierAlt | KeyModifierControl, 0x1e, "en");
+  check(state.isKeyDown(0x38) && state.isKeyDown(0x1d), "fixture retains synthetic Alt and Ctrl for reconciliation checks");
+  check(!state.fakeKeyUp(0x38), "fixture synthetic Alt has no server-key mapping");
+  state.reconcileKeyRelease(kKeyAlt_L, KeyModifierControl);
+  check(state.released == std::vector<KeyButton>{0x38}, "explicit Alt up releases the implicit Alt immediately");
+  check(!state.isKeyDown(0x38) && state.isKeyDown(0x1d), "Alt cleanup preserves still held Ctrl companion");
+  check(state.getActiveModifiers() == KeyModifierControl, "shadow mask clears only released modifier class");
+  state.reconcileKeyRelease(kKeyAlt_L, 0);
+  check(state.released.size() == 1, "duplicate Alt up emits no duplicate release");
+  state.reconcileKeyRelease(kKeyControl_L, 0);
+  check(state.released.size() == 2 && state.released.back() == 0x1d, "Ctrl releases on its own explicit up");
+
+  FixtureState sides(map);
+  sides.fakeKeyDown('a', KeyModifierAlt, 0x1e, "en");
+  sides.reconcileKeyRelease(kKeyAlt_R, KeyModifierAlt);
+  check(sides.released.empty() && sides.isKeyDown(0x38), "other-side Alt still held in source mask is preserved");
+  sides.onKey(0x38, true, KeyModifierAlt);
+  sides.reconcileKeyRelease(kKeyAlt_L, 0);
+  check(sides.released.empty() && sides.isKeyDown(0x38), "real client keyboard press takes ownership and is never released");
+
+  FixtureState alreadyPhysical(map);
+  alreadyPhysical.onKey(0x38, true, KeyModifierAlt);
+  alreadyPhysical.fakeKeyDown('a', KeyModifierAlt, 0x1e, "en");
+  alreadyPhysical.reconcileKeyRelease(kKeyAlt_L, 0);
+  check(alreadyPhysical.released.empty() && alreadyPhysical.isKeyDown(0x38), "a later remote shortcut cannot take ownership of an already physically held Alt");
+
+  FixtureState physical(map);
+  physical.fakeKeyDown('a', KeyModifierAlt, 0x1e, "en");
+  physical.reconcileKeyRelease(kKeyAlt_L, 0);
+  physical.onKey(0x38, true, KeyModifierAlt);
+  physical.reconcileKeyRelease(kKeyAlt_L, 0);
+  check(physical.released.size() == 1, "stale client data after an earlier remote release cannot release a later physical press");
+
+  FixtureState altgr(map);
+  altgr.fakeKeyDown('a', KeyModifierControl | KeyModifierAltGr, 0x1e, "en");
+  altgr.reconcileKeyRelease(kKeyAlt_R, KeyModifierControl);
+  check(altgr.released == std::vector<KeyButton>{0x138} && altgr.isKeyDown(0x1d), "right Alt releases AltGr without releasing Ctrl");
+  altgr.reconcileKeyRelease(kKeyControl_R, KeyModifierControl);
+  check(altgr.released.size() == 1, "other-side Ctrl still held is preserved");
+  altgr.reconcileKeyRelease('a', 0);
+  altgr.reconcileKeyRelease(kKeyCapsLock, 0);
+  altgr.reconcileKeyRelease(kKeyNumLock, 0);
+  altgr.reconcileKeyRelease(kKeyScrollLock, 0);
+  check(altgr.released.size() == 1 && altgr.isKeyDown(0x1d), "ordinary and lock-key releases never clear unrelated modifiers");
+  check(!deskflow::shouldReleaseImplicitModifier(kKeyAlt_L, 0, KeyModifierAlt, true, true), "locking key is excluded even with matching generated bit");
+
+  std::printf("PASS: %d real KeyState reconciliation checks; no desktop input injected\n", checks);
+}
