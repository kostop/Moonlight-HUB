+bool MSWindowsHook::returnMouseToPrimary(POINT &position)
+{
+  if (!g_isPrimary || g_mouseLL == nullptr || GetCurrentThreadId() != g_hookThread) {
+    POINT actual{};
+    if (GetPhysicalCursorPos(&actual)) {
+      position = actual;
+    }
+    return false;
+  }
+  {
+    std::scoped_lock lock(g_mouseMotion.mutex);
+    g_mouseMotion.targetX = position.x;
+    g_mouseMotion.targetY = position.y;
