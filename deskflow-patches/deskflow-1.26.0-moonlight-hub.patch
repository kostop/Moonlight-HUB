+static int checks = 0;
+
+// 参数 success：断言结果；message：失败时输出的行为说明。
+static void check(bool success, const char *message)
+{
+  ++checks;
+  if (!success) {
+    std::fprintf(stderr, "FAIL: %s\n", message);
+    std::exit(1);
+  }
+}
+
+// 参数 normalized：SendInput 绝对坐标；origin/extent：物理桌面范围；模拟像素区间映射。
+static int64_t physicalPixel(LONG normalized, int32_t origin, int32_t extent)
+{
+  return origin + static_cast<int64_t>(normalized) * extent / 65536;
+}
+
+// 参数 position/origin/extent：物理像素及该轴范围；验证规范化后仍落在原像素。
+static void checkPixel(int32_t position, int32_t origin, int32_t extent)
+{
+  const auto normalized = normalizeCursorCoordinate(position, origin, extent);
+  check(normalized >= 0 && normalized <= 65535, "normalized absolute coordinate is in range");
+  check(physicalPixel(normalized, origin, extent) == position, "pixel center maps to the original physical pixel");
+}
+
+int main()
+{
+  const std::array<CursorDesktopBounds, 5> desktops{{
+      {0, 0, 1920, 1080}, {-2560, -1200, 6480, 2640},
+      {-2736, 0, 4656, 1920}, {800, -2400, 3840, 4560},
+      {0, 0, 65536, 1},
+  }};
+  for (const auto &bounds : desktops) {
+    for (int32_t offset = 0; offset < bounds.width; ++offset) {
+      checkPixel(bounds.x + offset, bounds.x, bounds.width);
+    }
+    for (int32_t offset = 0; offset < bounds.height; ++offset) {
+      checkPixel(bounds.y + offset, bounds.y, bounds.height);
+    }
+    INPUT input{};
+    check(makeCursorWarp(bounds.x + bounds.width - 1, bounds.y, bounds, input), "construct physical desktop corner warp");
+    check(input.type == INPUT_MOUSE, "warp is a mouse input");
+    check(input.mi.dwFlags == static_cast<DWORD>(MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_VIRTUALDESK),
+          "warp maps the entire virtual desktop without acceleration");
+    check(input.mi.mouseData == 0 && input.mi.time == 0, "unused input fields are zero initialized");
+    check(input.mi.dwExtraInfo == kCursorWarpTag, "warp carries the dedicated core tag");
+    check(physicalPixel(input.mi.dx, bounds.x, bounds.width) == bounds.x + bounds.width - 1 &&
+          physicalPixel(input.mi.dy, bounds.y, bounds.height) == bounds.y, "negative desktop origin and corners retain target");
+  }
+
+  const CursorDesktopBounds bounds{-2560, -1200, 6480, 2640};
+  INPUT input{};
+  check(makeCursorWarp(1918, 721, bounds, input), "construct reentry warp far from the source center");
+  check(physicalPixel(input.mi.dx, bounds.x, bounds.width) == 1918 &&
+        physicalPixel(input.mi.dy, bounds.y, bounds.height) == 721, "reentry uses mapped target, not the hidden center anchor");
+  check(normalizeCursorCoordinate(-10000, bounds.x, bounds.width) == normalizeCursorCoordinate(bounds.x, bounds.x, bounds.width),
+        "out-of-desktop low coordinate clamps to the first pixel");
+  check(normalizeCursorCoordinate(10000, bounds.x, bounds.width) == normalizeCursorCoordinate(bounds.x + bounds.width - 1, bounds.x, bounds.width),
+        "out-of-desktop high coordinate clamps to the final pixel");
+  check(normalizeCursorCoordinate((std::numeric_limits<int32_t>::max)(), (std::numeric_limits<int32_t>::min)(),
+                                  (std::numeric_limits<int32_t>::max)()) <= 65535,
+        "wide signed coordinate subtraction cannot overflow");
+  checkPixel(-123, -123, 1);
+  check(!makeCursorWarp(0, 0, {0, 0, 0, 1080}, input), "reject empty desktop width");
+  check(!makeCursorWarp(0, 0, {0, 0, 1920, -1}, input), "reject invalid desktop height");
+  check(input.mi.dx == 0 && input.mi.dy == 0 && input.mi.dwFlags == 0 && input.mi.dwExtraInfo == 0,
+        "invalid desktop returns a zero initialized input");
+
+  MSLLHOOKSTRUCT event{};
+  event.dwExtraInfo = kCursorWarpTag;
+  event.flags = LLMHF_INJECTED;
+  check(isCursorWarp(WM_MOUSEMOVE, event), "recognize only the program's tagged injected move");
+  check(!isCursorWarp(WM_LBUTTONDOWN, event), "tag never bypasses a mouse press");
+  check(!isCursorWarp(WM_MOUSEWHEEL, event), "tag never bypasses a mouse wheel");
+  event.flags = 0;
+  check(!isCursorWarp(WM_MOUSEMOVE, event), "tag without injected flag cannot bypass physical motion");
+  event.flags = LLMHF_INJECTED;
+  for (const ULONG_PTR otherTag : {ULONG_PTR{0}, ULONG_PTR{0xff515780u}, ULONG_PTR{0x4d484c55u}, kCursorWarpTag ^ ULONG_PTR{1}}) {
+    event.dwExtraInfo = otherTag;
+    check(!isCursorWarp(WM_MOUSEMOVE, event), "ordinary injection, touch, and key-release tags are not cursor warps");
+  }
+  event.dwExtraInfo = kCursorWarpTag;
+  event.flags = LLMHF_INJECTED | LLMHF_LOWER_IL_INJECTED;
+  check(isCursorWarp(WM_MOUSEMOVE, event), "core tag remains recognizable with additional injected metadata");
+
+  // 延迟的中心/入屏回位即使跨过模式切换也不转发，紧随其后的真实运动必须保留。
+  for (const auto mode : {kHOOK_DISABLE, kHOOK_WATCH_JUMP_ZONE, kHOOK_RELAY_EVENTS}) {
+    std::vector<POINT> relayed;
+    for (const POINT point : {POINT{960, 540}, POINT{1918, 721}, POINT{1917, 723}}) {
+      event.pt = point;
+      event.dwExtraInfo = point.x == 1917 ? 0 : kCursorWarpTag;
+      event.flags = point.x == 1917 ? 0 : LLMHF_INJECTED;
+      if (!isCursorWarp(WM_MOUSEMOVE, event) && mode != kHOOK_DISABLE) {
+        relayed.push_back(point);
+      }
+    }
+    if (mode == kHOOK_DISABLE) {
+      check(relayed.empty(), "disabled hook forwards no motion to the server");
+    } else {
+      check(relayed.size() == 1 && relayed.front().x == 1917 && relayed.front().y == 723,
+            "delayed warp is ignored across hook modes while real motion is retained");
+    }
+  }
+
+  std::printf("PASS: %d cursor warp checks; no hooks installed and no desktop input injected.\n", checks);
+}
