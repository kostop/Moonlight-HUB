+  const auto dpiContext = SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+  const deskflow::win32::CursorDesktopBounds bounds{
+      GetSystemMetrics(SM_XVIRTUALSCREEN), GetSystemMetrics(SM_YVIRTUALSCREEN),
+      GetSystemMetrics(SM_CXVIRTUALSCREEN), GetSystemMetrics(SM_CYVIRTUALSCREEN)};
+  if (hadCursor) {
+    position = actual;
+  }
+  bool complete = false;
+  // SendInput 可能重入真实硬件回调；每轮只合入新增量，最多四轮后把余量交还消息循环。
+  for (int attempt = 0; attempt < 4 && g_mouseMotion.returning.load(); ++attempt) {
+    INPUT input{};
+    bool valid = false;
+    {
+      std::scoped_lock lock(g_mouseMotion.mutex);
+      g_mouseMotion.targetX += g_mouseMotion.pendingX;
+      g_mouseMotion.targetY += g_mouseMotion.pendingY;
+      g_mouseMotion.pendingX = 0;
+      g_mouseMotion.pendingY = 0;
+      if (bounds.width > 0 && bounds.height > 0) {
+        const auto x = std::clamp<int64_t>(g_mouseMotion.targetX, bounds.x,
+                                         static_cast<int64_t>(bounds.x) + bounds.width - 1);
+        const auto y = std::clamp<int64_t>(g_mouseMotion.targetY, bounds.y,
+                                         static_cast<int64_t>(bounds.y) + bounds.height - 1);
+        valid = deskflow::win32::makeCursorWarp(static_cast<int32_t>(x), static_cast<int32_t>(y), bounds, input);
+      }
+    }
+    // 不持锁调用 SendInput：系统可能在此调用本线程的低级钩子。
+    const bool moved = valid && SendInput(1, &input, sizeof(input)) == 1;
+    POINT latest{};
+    const bool haveCursor = GetPhysicalCursorPos(&latest) != FALSE;
+    if (haveCursor) {
+      position = latest;
+    }
+    std::scoped_lock lock(g_mouseMotion.mutex);
+    if (!moved || !haveCursor) {
+      g_mouseMotion.local = true;
+      g_mouseMotion.returning = false;
+      break;
+    }
+    // 桌面边缘或显示器间隙可能裁剪目标；下一轮应从实际落点继续，避免反向移动被越界余量吞掉。
+    g_mouseMotion.targetX = position.x;
+    g_mouseMotion.targetY = position.y;
+    if (g_mouseMotion.pendingX == 0 && g_mouseMotion.pendingY == 0) {
