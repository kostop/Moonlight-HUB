+++ b/tools/test-monitor-routing.cpp
@@ -0,0 +1,149 @@
+#include "server/MonitorTopologyRouter.h"
+#include <QCoreApplication>
+#include <QTemporaryFile>
+#include <iostream>
+#include <stdexcept>
+
+// owner：所属电脑；id：显示器标识；native/global：真实像素位置和逻辑布局位置。
+QJsonObject monitor(const char *owner, const char *id, int nx, int ny, int gx, int gy, int width, int height, int logicalWidth, int logicalHeight)
+{
+  return {{"owner", owner}, {"id", id}, {"nativeX", nx}, {"nativeY", ny}, {"x", gx}, {"y", gy},
+      {"width", width}, {"height", height}, {"canvasWidth", logicalWidth}, {"canvasHeight", logicalHeight}, {"active", true}};
+}
+
+int main(int argc, char **argv)
+{
+  QCoreApplication app(argc, argv);
+  try {
+  QTemporaryFile file;
+  if (!file.open()) return 1;
+  QJsonArray monitors {
+      monitor("laptop", "local", 0, 0, 0, 0, 1000, 800, 1000, 800),
+      monitor("remote", "real", 0, 0, 1300, 0, 1920, 1080, 1920, 1080),
+      monitor("remote", "virtual", 3000, 0, 3800, 0, 1824, 840, 912, 420)};
+  file.write(QJsonDocument(QJsonObject {{"monitors", monitors}}).toJson()); file.flush();
+  qputenv("DESKFLOW_MONITOR_TOPOLOGY", file.fileName().toUtf8());
+  MonitorTopologyRouter router;
+  const auto available = [](const auto &) { return true; };
+  auto cross = router.route({"laptop", 999, 300, 1003, 300}, available);
+  if (!cross || cross->owner != "remote" || cross->x != 3 || cross->y != 300) throw std::runtime_error("Cross-device gap lost motion");
+  auto physicalToVirtual = router.route({"remote", 1919, 200, 1923, 200}, available);
+  if (!physicalToVirtual || physicalToVirtual->x != 3006 || physicalToVirtual->y != 400) throw std::runtime_error("DPI/gap conversion failed");
+  auto reverse = router.route({"remote", 3000, 400, 2996, 400}, available);
+  if (!reverse || reverse->x != 1917 || reverse->y != 200) throw std::runtime_error("Reverse DPI/gap conversion failed");
+  if (router.route({"laptop", 999, 300, 1003, 300}, [](const auto &owner) { return owner == "laptop"; })) throw std::runtime_error("Offline host accepted");
+  if (router.route({"remote", 3100, 300, 3105, 302}, available)) throw std::runtime_error("Motion inside one monitor was changed");
+  QTemporaryFile currentLayout;
+  if (!currentLayout.open()) return 1;
+  QJsonArray currentMonitors {
+      monitor("qingxian", "main", 0, 0, 47, -1080, 1920, 1080, 1920, 1080),
+      monitor("qingxian", "phone", 1920, -364, 1967, -924, 4096, 2160, 1170, 617),
+      monitor("Desktop-Lin", "tablet", 0, 0, 21, 0, 2000, 1200, 1143, 686)};
+  currentLayout.write(QJsonDocument(QJsonObject {{"monitors", currentMonitors}}).toJson()); currentLayout.flush();
+  qputenv("DESKFLOW_MONITOR_TOPOLOGY", currentLayout.fileName().toUtf8());
+  MonitorTopologyRouter currentRouter;
+  auto direct = currentRouter.route({"qingxian", 500, 1079, 500, 1084}, available);
+  if (!direct || direct->owner != "Desktop-Lin" || direct->x < 900 || direct->x > 950 || direct->y > 10)
+    throw std::runtime_error("Qingxian main did not go directly to Lin virtual display");
+  auto back = currentRouter.route({"Desktop-Lin", 920, 0, 920, -5}, available);
+  if (!back || back->owner != "qingxian" || back->x > 1920 || back->y < 1070 || back->y >= 1080)
+    throw std::runtime_error("Lin virtual display did not return directly to Qingxian main");
+  auto phone = currentRouter.route({"qingxian", 1919, 600, 1924, 600}, available);
+  if (!phone || phone->owner != "qingxian" || phone->x < 1920)
+    throw std::runtime_error("Qingxian main could not enter its virtual display");
+  auto clipped = currentRouter.route({"Desktop-Lin", 920, 5, 920, 0}, available);
+  if (!clipped || clipped->owner != "qingxian" || clipped->y >= 1080)
+    throw std::runtime_error("Windows-clipped border did not enter Qingxian main directly");
+  auto interior = currentRouter.clamp({"Desktop-Lin", 920, 5, 920, 2});
+  if (!interior || interior->y != 2) throw std::runtime_error("Legacy whole-desktop switching was not suppressed");
+
+  QTemporaryFile actualLayout;
+  if (!actualLayout.open()) return 1;
+  QJsonArray actualMonitors {
+      monitor("Desktop-Lin", "dell", 0, 0, -380, -14, 2560, 1440, 2560, 1440),
+      monitor("Desktop-Lin", "laptop", 2560, 1292, 2180, 1278, 1920, 1080, 1536, 864),
+      monitor("qingxian", "main", 0, 0, 2180, 198, 1920, 1080, 1920, 1080),
+      monitor("qingxian", "virtual", 1536, 1080, 3716, 1278, 2000, 1200, 1000, 600)};
+  actualLayout.write(QJsonDocument(QJsonObject {{"monitors", actualMonitors}}).toJson()); actualLayout.flush();
+  qputenv("DESKFLOW_MONITOR_TOPOLOGY", actualLayout.fileName().toUtf8());
+  MonitorTopologyRouter actualRouter;
+  auto local = actualRouter.route({"Desktop-Lin", 2559, 1300, 2560, 1300}, available);
+  if (!local || local->owner != "Desktop-Lin" || local->x != 2560 || local->y != 1302)
+    throw std::runtime_error("Local monitor transition was not routed");
+  auto remote = actualRouter.route({"Desktop-Lin", 2559, 500, 2560, 500}, available);
+  if (!remote || remote->owner != "qingxian" || remote->x != 0 || remote->y != 288)
+    throw std::runtime_error("Remote monitor transition was not routed");
+  if (actualRouter.route({"Desktop-Lin", 2559, 150, 2560, 150}, available))
+    throw std::runtime_error("Non-overlapping screen was accepted");
+  auto clippedGap = actualRouter.clamp({"Desktop-Lin", 2559, 150, 2560, 150});
+  if (!clippedGap || clippedGap->owner != "Desktop-Lin" || clippedGap->x != 2559 || clippedGap->y != 150)
+    throw std::runtime_error("Boundary clamp did not stay on the current monitor");
+  if (actualRouter.route({"Desktop-Lin", 3715, 2200, 3716, 2200}, available))
+    throw std::runtime_error("Non-overlapping virtual display was accepted");
+
+  QTemporaryFile diagonalLayout;
+  if (!diagonalLayout.open()) return 1;
+  QJsonArray diagonalMonitors {
+      monitor("source", "main", 0, 0, 0, 0, 1000, 1000, 1000, 1000),
+      monitor("upper", "right", 0, 0, 1000, 0, 1000, 500, 1000, 500),
+      monitor("lower", "right", 0, 0, 1000, 500, 2000, 1000, 1000, 500),
+      monitor("bottom", "wide", 0, 0, 0, 1000, 2000, 1000, 2000, 1000)};
+  diagonalLayout.write(QJsonDocument(QJsonObject {{"monitors", diagonalMonitors}}).toJson()); diagonalLayout.flush();
+  qputenv("DESKFLOW_MONITOR_TOPOLOGY", diagonalLayout.fileName().toUtf8());
+  MonitorTopologyRouter diagonalRouter;
+  auto slope = diagonalRouter.route({"source", 990, 490, 1010, 530}, available);
+  if (!slope || slope->owner != "lower" || slope->x != 20 || slope->y != 60)
+    throw std::runtime_error("Diagonal crossing used the old row instead of the edge intersection");
+  auto seam = diagonalRouter.route({"source", 990, 490, 1010, 510}, available);
+  if (!seam || seam->owner != "lower" || seam->y != 20)
+    throw std::runtime_error("Exact shared seam selected both rows");
+  auto fast = diagonalRouter.route({"source", 900, 400, 1100, 700}, available);
+  if (!fast || fast->owner != "lower" || fast->x != 200 || fast->y != 400)
+    throw std::runtime_error("Fast diagonal crossing selected the wrong monitor");
+  auto firstEdge = diagonalRouter.route({"source", 990, 980, 1010, 1030}, available);
+  if (!firstEdge || firstEdge->owner != "bottom" || firstEdge->x != 1010 || firstEdge->y != 30)
+    throw std::runtime_error("Diagonal corner ignored the first crossed edge");
+  if (diagonalRouter.route({"source", 990, 980, 1010, 1030}, [](const auto &owner) { return owner != "bottom"; }))
+    throw std::runtime_error("Disconnected first edge was skipped in favor of a later edge");
+  auto reverseDiagonal = diagonalRouter.route({"lower", 0, 20, -20, -20}, available);
+  if (!reverseDiagonal || reverseDiagonal->owner != "source" || reverseDiagonal->x != 989 || reverseDiagonal->y != 490)
+    throw std::runtime_error("Reverse diagonal crossing lost DPI mapping");
+
+  QTemporaryFile liveLayout;
+  if (!liveLayout.open()) return 1;
+  QJsonArray liveMonitors {
+      monitor("Desktop-Lin", "dell", -2560, -1440, 8362, 1050, 2560, 1440, 2560, 1440),
+      monitor("Desktop-Lin", "laptop", 0, 0, 10702, 2490, 1920, 1080, 1536, 864),
+      monitor("qingxian", "main", 0, 0, 10922, 1234, 1920, 1080, 1920, 1080)};
+  liveLayout.write(QJsonDocument(QJsonObject {{"monitors", liveMonitors}}).toJson()); liveLayout.flush();
+  qputenv("DESKFLOW_MONITOR_TOPOLOGY", liveLayout.fileName().toUtf8());
+  MonitorTopologyRouter liveRouter;
+  auto dellToLaptop = liveRouter.route({"Desktop-Lin", -100, -1, -100, 4}, available);
+  if (!dellToLaptop || dellToLaptop->owner != "Desktop-Lin" || dellToLaptop->x != 150 || dellToLaptop->y != 5)
+    throw std::runtime_error("Dell bottom overlap did not map to the scaled laptop");
+  auto laptopToDell = liveRouter.route({"Desktop-Lin", 150, 0, 150, -5}, available);
+  if (!laptopToDell || laptopToDell->owner != "Desktop-Lin" || laptopToDell->x != -100 || laptopToDell->y != -5)
+    throw std::runtime_error("Scaled laptop did not return to the Dell bottom overlap");
+  auto laptopGap = liveRouter.route({"Desktop-Lin", 500, 0, 500, -5}, available);
+  if (!laptopGap || laptopGap->owner != "qingxian" || laptopGap->x != 180 || laptopGap->y != 1075)
+    throw std::runtime_error("Laptop did not cross the 176 logical pixel gap to Qingxian");
+  auto dellToQingxian = liveRouter.route({"Desktop-Lin", -1, -800, 4, -800}, available);
+  if (!dellToQingxian || dellToQingxian->owner != "qingxian" || dellToQingxian->x != 4 || dellToQingxian->y != 456)
+    throw std::runtime_error("Dell side crossing lost the shared logical position");
+  auto dellCorner = liveRouter.route({"Desktop-Lin", -1, -1, 1, 1}, available);
+  if (!dellCorner || dellCorner->owner != "Desktop-Lin" || dellCorner->x != 276 || dellCorner->y != 1)
+    throw std::runtime_error("Exact Dell corner did not use its only connected edge");
+  if (liveRouter.route({"Desktop-Lin", -300, -1, -300, 4}, available))
+    throw std::runtime_error("Dell bottom outside the 220 pixel overlap switched monitors");
+  auto primaryClamp = liveRouter.clamp({"Desktop-Lin", -300, -1, 0, 4});
+  if (!primaryClamp || primaryClamp->x != -1 || primaryClamp->y != -1)
+    throw std::runtime_error("Native Windows crossing did not supply the current-monitor warp position");
+  auto stableInterior = liveRouter.clamp({"Desktop-Lin", -300, -100, -290, -95});
+  if (!stableInterior || stableInterior->x != -290 || stableInterior->y != -95)
+    throw std::runtime_error("Interior primary motion requested an unnecessary warp");
+  std::cout << "PASS monitor routing: gaps, DPI, offline targets, edge overlap, diagonal intersection, first crossed edge, exact seams, fast motion, live Dell/laptop/Qingxian layout and primary clamp positions\n";
+  } catch (const std::exception &e) {
+    std::cerr << "FAIL: " << e.what() << '\n';
+    return 2;
+  }
+}
diff --git a/tools/test-mouse-handoff.cpp b/tools/test-mouse-handoff.cpp
new file mode 100644
index 0000000..cf3536f
--- /dev/null
+++ b/tools/test-mouse-handoff.cpp
@@ -0,0 +1,295 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception */
+#include "platform/MSWindowsHook.h"
+#include "platform/MSWindowsCursorWarp.h"
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+namespace {
+struct Posted { UINT message; WPARAM w; LPARAM l; };
+POINT physical{960, 540};
+bool cursorAvailable = true;
+bool postAvailable = true;
+bool sendAvailable = true;
+bool validBounds = true;
+DWORD currentThread = 7;
+int reentrantMoves = 0;
+POINT reentrantDelta{7, -3};
+int passed = 0;
+int checks = 0;
+std::vector<Posted> posted;
+std::vector<INPUT> sentInputs;
+LRESULT deliverWarp(const INPUT &input);
+void deliverHardwareBeforeWarp();
+BOOL WINAPI readCursor(LPPOINT p) { *p = physical; return cursorAvailable; }
+DPI_AWARENESS_CONTEXT WINAPI dpiScope(DPI_AWARENESS_CONTEXT) { return nullptr; }
+BOOL WINAPI post(DWORD, UINT message, WPARAM w, LPARAM l) {
+  if (!postAvailable) { return FALSE; }
+  posted.push_back({message, w, l});
+  return TRUE;
+}
+DWORD WINAPI threadId() { return currentThread; }
+int WINAPI metrics(int index) {
+  if (index == SM_CXVIRTUALSCREEN) { return validBounds ? 8192 : 0; }
+  if (index == SM_CYVIRTUALSCREEN) { return 4096; }
+  return 0;
+}
+UINT WINAPI sendInputs(UINT count, LPINPUT inputs, int size) {
+  if (!sendAvailable || count != 1 || size != sizeof(INPUT)) { return 0; }
+  sentInputs.push_back(*inputs);
+  if (reentrantMoves > 0) {
+    --reentrantMoves;
+    deliverHardwareBeforeWarp();
+  }
+  deliverWarp(*inputs);
+  physical.x = inputs->mi.dx * 8192 / 65536;
+  physical.y = inputs->mi.dy * 4096 / 65536;
+  return 1;
+}
+LRESULT WINAPI pass(HHOOK, int, WPARAM, LPARAM) { ++passed; return 0; }
+SHORT WINAPI keyState(int) { return 0; }
+int WINAPI translate(UINT, UINT, const BYTE *, LPWSTR, int, UINT) { return 0; }
+BOOL WINAPI unhook(HHOOK) { return TRUE; }
+void check(bool success, const char *message) {
+  ++checks;
+  if (!success) { std::fprintf(stderr, "FAIL: %s\n", message); std::exit(1); }
+}
+}
+
+// 编译实际生产回调；仅替换与桌面交互的 Win32 API，不安装钩子或注入输入。
+#define GetPhysicalCursorPos readCursor
+#define SetThreadDpiAwarenessContext dpiScope
+#undef PostThreadMessage
+#define PostThreadMessage post
+#define CallNextHookEx pass
+#define GetAsyncKeyState keyState
+#define ToUnicode translate
+#define UnhookWindowsHookEx unhook
+#define GetCurrentThreadId threadId
+#define GetSystemMetrics metrics
+#define SendInput sendInputs
+#pragma warning(push)
+#pragma warning(disable: 4457) // 原键盘回调内的同名参数不属于本次修改。
+#include "../src/lib/platform/MSWindowsHook.cpp"
+#pragma warning(pop)
+
+namespace {
+LRESULT deliverWarp(const INPUT &input) {
+  MSLLHOOKSTRUCT warp{};
+  warp.dwExtraInfo = input.mi.dwExtraInfo;
+  warp.flags = LLMHF_INJECTED;
+  return mouseLLHook(HC_ACTION, WM_MOUSEMOVE, reinterpret_cast<LPARAM>(&warp));
+}
+void deliverHardwareBeforeWarp() {
+  MSLLHOOKSTRUCT hardware{};
+  hardware.pt = {physical.x + reentrantDelta.x, physical.y + reentrantDelta.y};
+  mouseLLHook(HC_ACTION, WM_MOUSEMOVE, reinterpret_cast<LPARAM>(&hardware));
+}
+}
+
+// 未调用的初始化错误路径仍需链接；触发即失败，不伪造待测回调行为。
+Log *Log::getInstance() { std::abort(); }
+void Log::print(const char *, int, const char *, ...) { std::abort(); }
+BaseException::BaseException() : std::runtime_error("") {}
+const char *BaseException::what() const noexcept { std::abort(); }
+std::string BaseException::format(const char *, const char *, ...) const noexcept { std::abort(); }
+std::string ScreenOpenFailureException::getWhat() const noexcept { std::abort(); }
+
+int main() {
+  MSWindowsHook hook;
+  g_mouseLL = reinterpret_cast<HHOOK>(1);
+  g_isPrimary = TRUE;
+  g_hookThread = currentThread;
+  _putenv_s("DESKFLOW_MONITOR_TOPOLOGY", "fixture-only");
+  hook.setMode(kHOOK_WATCH_JUMP_ZONE);
+  MSLLHOOKSTRUCT mouse{};
+  mouse.pt = {969, 548};
+  const auto move = [&] { return mouseLLHook(HC_ACTION, WM_MOUSEMOVE, reinterpret_cast<LPARAM>(&mouse)); };
+  check(move() == 0 && passed == 1, "normal local motion still reaches Windows");
+  hook.beginMouseHandoff();
+  posted.clear();
+  check(move() == 1 && passed == 1, "handoff consumes real movement before the parking warp");
+  check(posted.size() == 1 && posted[0].message == DESKFLOW_MSG_MOUSE_MOVE_DELTA &&
+        posted[0].w == 9 && posted[0].l == 8, "handoff keeps the actual hardware delta");
+  KBDLLHOOKSTRUCT key{};
+  key.vkCode = VK_LMENU; key.scanCode = 0x38; key.flags = LLKHF_UP;
+  check(keyboardLLHook(HC_ACTION, WM_SYSKEYUP, reinterpret_cast<LPARAM>(&key)) == 0,
+        "Alt release during handoff still reaches the source OS before input-queue flushing");
+  mouse.dwExtraInfo = deskflow::win32::kCursorWarpTag; mouse.flags = LLMHF_INJECTED;
+  const auto count = posted.size();
+  check(move() == 0 && posted.size() == count, "own tagged warp passes without adding a relayed delta");
+  mouse.dwExtraInfo = 0; mouse.flags = 0;
+  cursorAvailable = false;
+  check(move() == 1, "failed cursor query cannot reopen the handoff movement gap");
+  cursorAvailable = true;
+  hook.setMode(kHOOK_RELAY_EVENTS);
+  check(!g_mouseHandoff.load() && move() == 1, "formal remote mode ends the temporary gate and keeps motion relayed");
+  check(keyboardLLHook(HC_ACTION, WM_SYSKEYUP, reinterpret_cast<LPARAM>(&key)) == 1,
+        "formal remote mode still relays keyboard events using the original keyboard transition");
+  hook.setMode(kHOOK_WATCH_JUMP_ZONE);
+  check(!g_mouseHandoff.load() && move() == 0, "return to the source restores normal local motion");
+  hook.beginMouseHandoff(); hook.setMode(kHOOK_WATCH_JUMP_ZONE);
+  check(!g_mouseHandoff.load(), "same-mode reset also clears handoff");
+  hook.beginMouseHandoff(); hook.cleanup();
+  check(!g_mouseHandoff.load(), "cleanup clears handoff");
+  hook.beginMouseHandoff(); hook.uninstall();
+  check(!g_mouseHandoff.load(), "uninstall clears handoff without real hooks");
+  g_mouseLL = reinterpret_cast<HHOOK>(1); g_isPrimary = FALSE;
+  hook.beginMouseHandoff();
+  check(!g_mouseHandoff.load(), "secondary screen cannot start a source handoff");
+
+  g_isPrimary = TRUE;
+  hook.setMode(kHOOK_RELAY_EVENTS);
+  physical = {960, 540};
+  posted.clear();
+  sentInputs.clear();
+  for (int i = 0; i < 200; ++i) {
+    mouse.pt = {963, 542};
+    check(move() == 1, "queued remote motion stays consumed while returning");
+  }
+  const auto firstToken = MSWindowsHook::nextMouseMotionToken();
+  check(MSWindowsHook::consumeMouseMotion(firstToken, 3, 2), "the active motion token consumes its pending delta");
+  POINT destination{100, 200};
+  check(MSWindowsHook::returnMouseToPrimary(destination), "return succeeds on the hook thread");
+  check(destination.x == 697 && destination.y == 598 && physical.x == 697 && physical.y == 598,
+        "200 queued deltas are conserved exactly and the acknowledged delta is not replayed");
+  check(sentInputs.size() == 1 && sentInputs[0].mi.dwExtraInfo == deskflow::win32::kCursorWarpTag,
+        "pending motion is applied with exactly one tagged warp");
+  check(posted.size() == 201 && posted.back().message == DESKFLOW_MSG_MOUSE_MOVE &&
+        g_mouseMotion.pendingX == 0 && g_mouseMotion.pendingY == 0,
+        "own reentrant warp callback does not add a delta and transferred pending motion is empty");
+  for (int i = 1; i < 200; ++i) {
+    check(!MSWindowsHook::consumeMouseMotion(MSWindowsHook::nextMouseMotionToken(), 3, 2),
+          "delayed tokens already absorbed into the return position cannot replay their movement");
+  }
+  check(g_mouseMotion.pendingX == 0 && g_mouseMotion.pendingY == 0,
+        "draining absorbed raw messages does not create negative pending movement");
+  posted.clear();
+  mouse.pt = {703, 604};
+  check(move() == 0 && posted.size() == 1 && posted[0].message == DESKFLOW_MSG_MOUSE_MOVE &&
+        posted[0].w == 703 && posted[0].l == 604,
+        "new local absolute motion passes immediately before formal keyboard mode changes");
+  _putenv_s("DESKFLOW_MONITOR_TOPOLOGY", "");
+  hook.setZone(0, 0, 8192, 4096, 1);
+  hook.setSides(0);
+  posted.clear();
+  check(move() == 0 && posted.size() == 1 && posted[0].message == DESKFLOW_MSG_MOUSE_MOVE,
+        "local movement override also bypasses relay without the logical monitor router");
+  _putenv_s("DESKFLOW_MONITOR_TOPOLOGY", "fixture-only");
+  check(keyboardLLHook(HC_ACTION, WM_SYSKEYUP, reinterpret_cast<LPARAM>(&key)) == 1,
+        "early mouse return preserves the existing keyboard relay timing");
+  check(mouseLLHook(HC_ACTION, WM_LBUTTONDOWN, reinterpret_cast<LPARAM>(&mouse)) == 1,
+        "early mouse return preserves the existing mouse button relay timing");
+
+  hook.setMode(kHOOK_RELAY_EVENTS);
+  check(!g_mouseMotion.local.load(), "formal mode changes clear the temporary local movement override");
+  physical = {960, 540};
+  mouse.pt = {965, 538};
+  postAvailable = false;
+  check(move() == 1 && g_mouseMotion.pendingX == 0 && g_mouseMotion.pendingY == 0,
+        "a failed delta post does not create phantom pending movement");
+  postAvailable = true;
+  check(move() == 1, "remote motion resumes after a failed post");
+  destination = {100, 200};
+  sendAvailable = false;
+  check(!MSWindowsHook::returnMouseToPrimary(destination) && destination.x == 960 && destination.y == 540,
+        "failed return injection reports the actual cursor position instead of the requested target");
+  check(g_mouseMotion.local.load(), "injection failure still releases local mouse movement");
+  sendAvailable = true;
+
+  hook.setMode(kHOOK_RELAY_EVENTS);
+  destination = {100, 200};
+  ++currentThread;
+  const auto beforeWrongThread = sentInputs.size();
+  check(!MSWindowsHook::returnMouseToPrimary(destination) && sentInputs.size() == beforeWrongThread &&
+        !g_mouseMotion.local.load(), "wrong-thread return cannot inject or change movement ownership");
+  --currentThread;
+
+  destination = {100, 200};
+  validBounds = false;
+  check(!MSWindowsHook::returnMouseToPrimary(destination) && destination.x == 960 && destination.y == 540,
+        "invalid desktop bounds do not inject or fabricate a cursor position");
+  validBounds = true;
+  cursorAvailable = false;
+  sendAvailable = false;
+  destination = {100, 200};
+  check(!MSWindowsHook::returnMouseToPrimary(destination) && destination.x == 100 && destination.y == 200,
+        "unavailable position and failed injection return failure without inventing a measured position");
+  cursorAvailable = true;
+  sendAvailable = true;
+
+  hook.setMode(kHOOK_RELAY_EVENTS);
+  check(move() == 1 && g_mouseMotion.pendingX == 5 && g_mouseMotion.pendingY == -2,
+        "fresh remote motion starts a new pending accumulator");
+  hook.setMode(kHOOK_RELAY_EVENTS);
+  check(g_mouseMotion.pendingX == 5 && g_mouseMotion.pendingY == -2,
+        "same-mode transitions retain unconsumed remote movement");
+  hook.cleanup();
+  check(g_mouseMotion.pendingX == 0 && g_mouseMotion.pendingY == 0 && !g_mouseMotion.local.load(),
+        "cleanup resets pending movement and temporary movement ownership");
+  hook.setMode(kHOOK_RELAY_EVENTS);
+  move();
+  hook.uninstall();
+  check(g_mouseMotion.pendingX == 5 && g_mouseMotion.pendingY == -2 && !g_mouseMotion.local.load(),
+        "uninstall retains pending movement for messages already in the main queue");
+  check(MSWindowsHook::consumeMouseMotion(MSWindowsHook::nextMouseMotionToken(), 5, -2) &&
+        g_mouseMotion.pendingX == 0 && g_mouseMotion.pendingY == 0,
+        "a queued pre-uninstall message acknowledges correctly without creating a negative accumulator");
+  g_mouseLL = reinterpret_cast<HHOOK>(1);
+  destination = {100, 200};
+  check(MSWindowsHook::returnMouseToPrimary(destination) && destination.x == 100 && destination.y == 200,
+        "return after hook reinstall does not invent reverse movement from an old acknowledgement");
+
+  hook.cleanup();
+  hook.setMode(kHOOK_RELAY_EVENTS);
+  physical = {960, 540};
+  posted.clear();
+  sentInputs.clear();
+  reentrantMoves = 1;
+  destination = {100, 200};
+  check(MSWindowsHook::returnMouseToPrimary(destination) && destination.x == 107 && destination.y == 197 &&
+        sentInputs.size() == 2, "a hardware callback reentering before the tagged warp is conserved exactly once");
+  check(posted.size() == 1 && posted[0].message == DESKFLOW_MSG_MOUSE_MOVE &&
+        g_mouseMotion.capturedCount == 0 && g_mouseMotion.pendingX == 0 && g_mouseMotion.pendingY == 0,
+        "return-only reentrant motion does not produce stale ordinary delta messages");
+
+  hook.setMode(kHOOK_RELAY_EVENTS);
+  physical = {960, 540};
+  posted.clear();
+  sentInputs.clear();
+  reentrantMoves = 9;
+  destination = {100, 200};
+  check(!MSWindowsHook::returnMouseToPrimary(destination) && sentInputs.size() == 4 &&
+        g_mouseMotion.returning.load() && !g_mouseMotion.local.load() &&
+        posted.size() == 1 && posted[0].message == DESKFLOW_MSG_MOUSE_RETURN,
+        "four reentrant corrections yield to the hook queue with ownership and remaining movement retained");
+  hook.setMode(kHOOK_WATCH_JUMP_ZONE);
+  check(g_mouseMotion.returning.load(), "formal keyboard mode changes cannot cancel an unfinished mouse return");
+  check(!MSWindowsHook::continueMouseReturn() && sentInputs.size() == 8 &&
+        g_mouseMotion.returning.load() && posted.size() == 2 &&
+        posted[1].message == DESKFLOW_MSG_MOUSE_RETURN,
+        "a continuation performs at most four further corrections before yielding again");
+  check(MSWindowsHook::continueMouseReturn() && sentInputs.size() == 10 && !g_mouseMotion.returning.load() &&
+        g_mouseMotion.local.load() && physical.x == 163 && physical.y == 173,
+        "multiple continuations conserve all nine reentrant hardware moves without unbounded synchronous work");
+  check(posted.size() == 3 && posted[2].message == DESKFLOW_MSG_MOUSE_MOVE &&
+        posted[2].w == 163 && posted[2].l == 173 &&
+        g_mouseMotion.pendingX == 0 && g_mouseMotion.pendingY == 0,
+        "asynchronous return publishes its final actual position before releasing native movement");
+  const auto sentBeforeNoop = sentInputs.size();
+  check(MSWindowsHook::continueMouseReturn() && sentInputs.size() == sentBeforeNoop,
+        "a stale continuation after completion cannot inject or duplicate motion");
+
+  hook.cleanup();
+  hook.setMode(kHOOK_RELAY_EVENTS);
+  physical = {960, 540};
+  mouse.pt = {950, 540};
+  move();
+  reentrantDelta = {3, 0};
+  reentrantMoves = 1;
+  destination = {1, 100};
+  check(MSWindowsHook::returnMouseToPrimary(destination) && destination.x == 3 && destination.y == 100,
+        "reverse hardware movement after an edge clamp starts at the actual cursor position");
+  reentrantDelta = {7, -3};
+  std::printf("PASS: %d production mouse-handoff callback checks; no hooks or input injected.\n", checks);
+}
