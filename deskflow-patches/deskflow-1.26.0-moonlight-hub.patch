+$vsRoot = 'C:\Program Files\Microsoft Visual Studio\2022\Community'
+$msvcRoot = (Get-ChildItem -LiteralPath "$vsRoot\VC\Tools\MSVC" -Directory |
+    Sort-Object Name -Descending | Select-Object -First 1).FullName
+$sdkRoot = 'C:\Program Files (x86)\Windows Kits\10'
+$sdkVersion = (Get-ChildItem -LiteralPath "$sdkRoot\Include" -Directory |
+    Where-Object { Test-Path -LiteralPath "$($_.FullName)\um\Windows.h" } |
+    Sort-Object Name -Descending | Select-Object -First 1).Name
+if (!$msvcRoot -or !$sdkVersion) { throw 'MSVC or Windows SDK is missing.' }
+$env:INCLUDE = "$msvcRoot\include;$sdkRoot\Include\$sdkVersion\ucrt;$sdkRoot\Include\$sdkVersion\shared;$sdkRoot\Include\$sdkVersion\um"
+$env:LIB = "$msvcRoot\lib\x64;$sdkRoot\Lib\$sdkVersion\ucrt\x64;$sdkRoot\Lib\$sdkVersion\um\x64"
+New-Item -ItemType Directory -Force -Path $BuildDir | Out-Null
+
+# 参数 Text：当前生产源代码；Signature：精确函数声明。提取整个方法体，不维护逻辑副本。
+function Get-ProductionMethod([string]$Text, [string]$Signature) {
+    $offset = $Text.IndexOf($Signature + "`n{", [StringComparison]::Ordinal)
+    if ($offset -lt 0) { throw "Production method not found: $Signature" }
+    $brace = $Text.IndexOf('{', $offset)
+    $depth = 0
+    for ($i = $brace; $i -lt $Text.Length; ++$i) {
+        if ($Text[$i] -eq '{') { ++$depth }
+        elseif ($Text[$i] -eq '}') {
+            --$depth
+            if ($depth -eq 0) { return $Text.Substring($offset, $i - $offset + 1) }
+        }
+    }
+    throw "Unclosed production method: $Signature"
+}
+$screen = [IO.File]::ReadAllText((Join-Path $sourceRoot 'src\lib\platform\MSWindowsScreen.cpp')).Replace("`r`n", "`n")
+$desks = [IO.File]::ReadAllText((Join-Path $sourceRoot 'src\lib\platform\MSWindowsDesks.cpp')).Replace("`r`n", "`n")
+$server = [IO.File]::ReadAllText((Join-Path $sourceRoot 'src\lib\server\Server.cpp')).Replace("`r`n", "`n")
+$primary = [IO.File]::ReadAllText((Join-Path $sourceRoot 'src\lib\server\PrimaryClient.cpp')).Replace("`r`n", "`n")
+$screenWrapper = [IO.File]::ReadAllText((Join-Path $sourceRoot 'src\lib\deskflow\Screen.cpp')).Replace("`r`n", "`n")
+$methods = @(
+    Get-ProductionMethod $screen 'void MSWindowsScreen::enter()'
+    Get-ProductionMethod $screen 'void MSWindowsScreen::warpCursor(int32_t x, int32_t y)'
+    Get-ProductionMethod $screen 'bool MSWindowsScreen::warpCursorNoFlush(int32_t x, int32_t y)'
+    Get-ProductionMethod $screen 'void MSWindowsScreen::saveMousePosition(int32_t x, int32_t y)'
+    Get-ProductionMethod $screen 'bool MSWindowsScreen::onMouseMoveDelta(int32_t dx, int32_t dy)'
+    Get-ProductionMethod $screen 'bool MSWindowsScreen::consumeMouseMotion(uint64_t token, int32_t dx, int32_t dy)'
+    Get-ProductionMethod $screen 'void MSWindowsScreen::sendEvent(EventTypes type, void *data)'
+    Get-ProductionMethod $desks 'void MSWindowsDesks::enter()'
+    Get-ProductionMethod $desks 'void MSWindowsDesks::enter(POINT &position)'
+    Get-ProductionMethod $screenWrapper 'bool Screen::consumeMouseMotion(uint64_t token, int32_t dx, int32_t dy)'
+    Get-ProductionMethod $primary 'bool PrimaryClient::consumeMouseMotion(uint64_t token, int32_t dx, int32_t dy)'
+    Get-ProductionMethod $server 'void Server::handleMotionSecondaryEvent(const Event &event)'
+    Get-ProductionMethod $server 'void Server::handleButtonDownEvent(const Event &event)'
+    Get-ProductionMethod $server 'void Server::handleButtonUpEvent(const Event &event)'
+)
+$case = [regex]::Match($desks, '(?s)    case DESKFLOW_MSG_ENTER:.*?(?=    case DESKFLOW_MSG_LEAVE:)')
+if (!$case.Success) { throw 'Production desktop ENTER dispatch case not found.' }
+$methods += @"
+void MSWindowsDesks::sendMessage(UINT message, WPARAM w, LPARAM l)
+{
+  MSG msg{}; msg.message = message; msg.wParam = w; msg.lParam = l;
+  Desk instance; Desk *desk = &instance;
+  bool dispatch = true;
+  while (dispatch) {
+    dispatch = false;
+    switch (message) {
+$($case.Value)
+    default: std::abort();
+    }
+  }
+}
+"@
+$define = [regex]::Match($desks, '(?m)^#define DESKFLOW_MSG_ENTER .+$').Value
+if (!$define) { throw 'Production ENTER message constant not found.' }
+[IO.File]::WriteAllText((Join-Path $BuildDir 'mouse-return-production.inc'), ($define + "`n" + ($methods -join "`n`n")), [Text.UTF8Encoding]::new($false))
+
+& "$msvcRoot\bin\Hostx64\x64\cl.exe" /nologo /utf-8 /W4 /WX /EHsc /std:c++20 /permissive- /MD `
+    "/I$sourceRoot\src\lib" "/I$BuildDir" "$PSScriptRoot\test-mouse-return.cpp" `
+    "/Fe:$BuildDir\test-mouse-return.exe" "/Fo:$BuildDir\test-mouse-return.obj"
+if ($LASTEXITCODE -ne 0) { throw 'Mouse return tests did not compile.' }
+& "$BuildDir\test-mouse-return.exe"
+if ($LASTEXITCODE -ne 0) { throw 'Mouse return tests failed.' }
