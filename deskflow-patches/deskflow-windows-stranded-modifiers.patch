+namespace deskflow::win32 {
+
+// 接收端修饰键兜底：只记账本核心注入的修饰键最后一次是按下还是松开，与 KeyState 的记账互相独立。
+class InjectedModifiers
+{
+public:
+  struct Key
+  {
+    WORD virtualKey;
+    uint16_t button; // 低 8 位扫描码，0x100 为扩展键
+  };
+  // 槽位依次为左右 Shift、Ctrl、Alt、Win。
+  static constexpr std::array<Key, 8> kKeys{{{VK_LSHIFT, 0x2a}, {VK_RSHIFT, 0x36}, {VK_LCONTROL, 0x1d},
+                                             {VK_RCONTROL, 0x11d}, {VK_LMENU, 0x38}, {VK_RMENU, 0x138},
+                                             {VK_LWIN, 0x15b}, {VK_RWIN, 0x15c}}};
+
+  // 参数 virtualKey/scan/flags：一次注入的键盘事件；返回修饰键槽位，非修饰键为 -1。
+  static int slot(WORD virtualKey, WORD scan, DWORD flags)
+  {
+    switch (virtualKey) {
+    case VK_LSHIFT: return 0;
+    case VK_RSHIFT: return 1;
+    case VK_LCONTROL: return 2;
+    case VK_RCONTROL: return 3;
+    case VK_LMENU: return 4;
+    case VK_RMENU: return 5;
+    case VK_LWIN: return 6;
+    case VK_RWIN: return 7;
+    default: break;
+    }
+    const bool extended = (flags & KEYEVENTF_EXTENDEDKEY) != 0 || (scan & 0x100u) != 0;
+    switch (scan & 0xffu) {
+    case 0x2a: return 0;
+    case 0x36: return 1;
+    case 0x1d: return extended ? 3 : 2;
+    case 0x38: return extended ? 5 : 4;
+    case 0x5b: return 6;
+    case 0x5c: return 7;
+    default: return -1;
+    }
+  }
+
+  // 参数 virtualKey/scan/flags：系统已接受的一次注入；Unicode 字符注入不是修饰键。
+  void record(WORD virtualKey, WORD scan, DWORD flags)
+  {
+    if ((flags & KEYEVENTF_UNICODE) != 0) return;
+    if (const int index = slot(virtualKey, scan, flags); index >= 0) {
+      m_down[index] = (flags & KEYEVENTF_KEYUP) == 0;
+    }
+  }
+
+  // 参数 osDown：查询系统是否仍按着某个左右独立虚拟键。
+  // 返回“最后注入的是按下且系统仍按着”的槽位位图，并清空全部记账。
+  template <typename Query> uint32_t takeStranded(Query osDown)
+  {
+    uint32_t stranded = 0;
+    for (size_t index = 0; index < kKeys.size(); ++index) {
+      if (m_down[index] && osDown(kKeys[index].virtualKey)) stranded |= 1u << index;
+      m_down[index] = false;
+    }
+    return stranded;
+  }
+
+private:
+  std::array<bool, 8> m_down{};
+};
+
+} // namespace deskflow::win32
