+  bool send_wechat_click(HWND window, POINT point) {
+    if (!window || !IsWindow(window)) {
+      return false;
+    }
+
+    const auto root_window = GetAncestor(window, GA_ROOT);
+    const auto titlebar_action = get_wechat_titlebar_action(root_window, point);
+    if (titlebar_action != wechat_titlebar_action_e::none) {
+      return send_wechat_titlebar_action(root_window, titlebar_action);
+    }
+
+    POINT client_point = point;
+    if (!ScreenToClient(window, &client_point)) {
+      return false;
+    }
+
+    const auto screen_message_point = MAKELPARAM(point.x, point.y);
+    LRESULT hit_test = HTNOWHERE;
+    if (query_window_message(root_window, WM_NCHITTEST, 0, screen_message_point, hit_test) &&
+        (hit_test == HTMINBUTTON || hit_test == HTMAXBUTTON || hit_test == HTCLOSE ||
+         hit_test == HTSYSMENU || hit_test == HTCAPTION)) {
+      const auto down_sent = send_wechat_window_message(root_window, WM_NCLBUTTONDOWN, hit_test, screen_message_point);
+      const auto up_sent = down_sent && send_wechat_window_message(root_window, WM_NCLBUTTONUP, hit_test, screen_message_point);
+      if (down_sent && !up_sent) {
+        send_wechat_window_message(root_window, WM_NCLBUTTONUP, hit_test, screen_message_point);
+      }
+      return down_sent && up_sent;
+    }
+
+    const auto message_point = MAKELPARAM(client_point.x, client_point.y);
+    const auto move_sent = send_wechat_window_message(window, WM_MOUSEMOVE, 0, message_point);
+    const auto down_sent = send_wechat_window_message(window, WM_LBUTTONDOWN, MK_LBUTTON, message_point);
+    const auto up_sent = down_sent && send_wechat_window_message(window, WM_LBUTTONUP, 0, message_point);
+    if (down_sent && !up_sent) {
+      send_wechat_window_message(window, WM_LBUTTONUP, 0, message_point);
+    }
+    return move_sent && down_sent && up_sent;
+  }
+
+  bool send_wechat_right_click(HWND window, POINT point) {
+    if (!window || !IsWindow(window)) {
+      return false;
+    }
+
+    POINT client_point = point;
+    if (!ScreenToClient(window, &client_point)) {
+      return false;
+    }
+
+    const auto message_point = MAKELPARAM(client_point.x, client_point.y);
+    const auto screen_point = MAKELPARAM(point.x, point.y);
+    const auto move_sent = send_wechat_window_message(window, WM_MOUSEMOVE, 0, message_point);
+    const auto down_sent = move_sent &&
+                           send_wechat_window_message(window, WM_RBUTTONDOWN, MK_RBUTTON, message_point);
+    const auto up_sent = down_sent &&
+                         send_wechat_window_message(window, WM_RBUTTONUP, 0, message_point);
+    const auto context_sent = up_sent && send_wechat_window_message(
+      window,
+      WM_CONTEXTMENU,
+      reinterpret_cast<WPARAM>(window),
+      screen_point
+    );
+    return move_sent && down_sent && up_sent && context_sent;
+  }
