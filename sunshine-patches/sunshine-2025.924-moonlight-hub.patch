+  bool is_wechat_process(DWORD process_id) {
+    HANDLE process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, process_id);
+    if (!process) {
+      return false;
+    }
+
+    wchar_t image_path[1024] {};
+    DWORD image_path_size = ARRAYSIZE(image_path);
+    bool is_wechat = false;
+    if (QueryFullProcessImageNameW(process, 0, image_path, &image_path_size)) {
+      const auto file_name_separator = std::wcsrchr(image_path, L'\\');
+      const auto file_name = file_name_separator ? file_name_separator + 1 : image_path;
+      is_wechat =
+        _wcsicmp(file_name, L"Weixin.exe") == 0 ||
+        _wcsicmp(file_name, L"WeChat.exe") == 0 ||
+        _wcsicmp(file_name, L"WeChatApp.exe") == 0 ||
+        _wcsicmp(file_name, L"WeChatAppEx.exe") == 0;
+    }
+
+    CloseHandle(process);
+    return is_wechat;
+  }
+
+  bool is_wechat_window_at_point(POINT point, DWORD &process_id, HWND &target_window) {
+    auto window = WindowFromPoint(point);
+    while (window) {
+      GetWindowThreadProcessId(window, &process_id);
+      if (is_wechat_process(process_id)) {
+        target_window = window;
+        return true;
+      }
+      window = GetParent(window);
+    }
+
+    process_id = 0;
+    target_window = nullptr;
+    return false;
+  }
