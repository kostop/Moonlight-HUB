+  POINT touch_to_screen_point(const touch_port_t &touch_port, float x, float y) {
+    // 合成指针使用零起点虚拟桌面坐标，窗口消息需要 Windows 屏幕坐标。
+    return {
+      static_cast<LONG>(std::lround(x * touch_port.width + touch_port.offset_x)) +
+        GetSystemMetrics(SM_XVIRTUALSCREEN),
+      static_cast<LONG>(std::lround(y * touch_port.height + touch_port.offset_y)) +
+        GetSystemMetrics(SM_YVIRTUALSCREEN),
+    };
+  }
+
+  constexpr wchar_t TOUCH_ROUTE_MAPPING_NAME[] = L"Local\\MoonlightTouchInjection.Route";
+  constexpr DWORD TOUCH_ROUTE_VERSION = 1;
+
+  struct alignas(8) touch_route_state_t {
+    DWORD version;
+    volatile LONG sequence;
+    volatile LONG screen_x;
+    volatile LONG screen_y;
+    volatile LONG64 update_tick;
+  };
+
+  touch_route_state_t *get_touch_route_state() {
+    static HANDLE mapping = nullptr;
+    static touch_route_state_t *state = nullptr;
+    if (state != nullptr) {
+      return state;
+    }
+
+    mapping = OpenFileMappingW(FILE_MAP_WRITE, FALSE, TOUCH_ROUTE_MAPPING_NAME);
+    if (mapping == nullptr) {
+      return nullptr;
+    }
+    state = static_cast<touch_route_state_t *>(MapViewOfFile(
+      mapping,
+      FILE_MAP_WRITE,
+      0,
+      0,
+      sizeof(touch_route_state_t)
+    ));
+    if (state == nullptr || state->version != TOUCH_ROUTE_VERSION) {
+      if (state != nullptr) {
+        UnmapViewOfFile(state);
+        state = nullptr;
+      }
+      CloseHandle(mapping);
+      mapping = nullptr;
+    }
+    return state;
+  }
+
+  void publish_touch_route(const touch_port_t &touch_port, const touch_input_t &touch) {
+    auto state = get_touch_route_state();
+    if (state == nullptr) {
+      return;
+    }
+
+    const auto point = touch_to_screen_point(touch_port, touch.x, touch.y);
+    InterlockedExchange(&state->screen_x, point.x);
+    InterlockedExchange(&state->screen_y, point.y);
+    InterlockedIncrement(&state->sequence);
+    InterlockedExchange64(&state->update_tick, static_cast<LONG64>(GetTickCount64()));
+  }
