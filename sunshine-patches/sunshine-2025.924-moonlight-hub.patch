+
+  constexpr int WECHAT_TITLEBAR_BUTTON_WIDTH_DIP = 44;
+  constexpr int WECHAT_TITLEBAR_HEIGHT_DIP = 36;
+
+  bool get_wechat_visible_window_rect(HWND root_window, RECT &window_rect) {
+    if (SUCCEEDED(DwmGetWindowAttribute(
+          root_window,
+          DWMWA_EXTENDED_FRAME_BOUNDS,
+          &window_rect,
+          sizeof(window_rect)
+        )) &&
+        window_rect.right > window_rect.left && window_rect.bottom > window_rect.top) {
+      return true;
+    }
+    return GetWindowRect(root_window, &window_rect) != FALSE;
+  }
+
+  wechat_titlebar_action_e get_wechat_titlebar_action(HWND root_window, POINT point) {
+    RECT window_rect {};
+    if (!root_window || !get_wechat_visible_window_rect(root_window, window_rect)) {
+      return wechat_titlebar_action_e::none;
+    }
+
+    const auto dpi = GetDpiForWindow(root_window);
+    const auto button_width = MulDiv(WECHAT_TITLEBAR_BUTTON_WIDTH_DIP, dpi ? dpi : 96, 96);
+    const auto titlebar_height = MulDiv(WECHAT_TITLEBAR_HEIGHT_DIP, dpi ? dpi : 96, 96);
+    if (button_width <= 0 ||
+        point.x < window_rect.left || point.x >= window_rect.right ||
+        point.y < window_rect.top || point.y >= window_rect.top + titlebar_height) {
+      return wechat_titlebar_action_e::none;
+    }
+
+    const auto button_from_right = (window_rect.right - 1 - point.x) / button_width;
+    switch (button_from_right) {
+      case 0:
+        return wechat_titlebar_action_e::close;
+      case 1:
+        return wechat_titlebar_action_e::maximize_or_restore;
+      case 2:
+        return wechat_titlebar_action_e::minimize;
+      default:
+        return wechat_titlebar_action_e::none;
+    }
+  }
+
+  /**
+   * @brief 判断微信自绘标题栏中的可拖动区域。
+   * @param root_window 微信顶层窗口。
+   * @param point Windows 虚拟桌面屏幕坐标。
+   * @return 触点位于标题栏且不在窗口按钮区域时返回 true。
+   */
+  bool is_wechat_titlebar_drag_area(HWND root_window, POINT point) {
+    RECT window_rect {};
+    if (!root_window || !get_wechat_visible_window_rect(root_window, window_rect)) {
+      return false;
+    }
+
+    const auto dpi = GetDpiForWindow(root_window);
+    const auto button_width = MulDiv(WECHAT_TITLEBAR_BUTTON_WIDTH_DIP, dpi ? dpi : 96, 96);
+    const auto titlebar_height = MulDiv(WECHAT_TITLEBAR_HEIGHT_DIP, dpi ? dpi : 96, 96);
+    const auto button_area_left = window_rect.right - button_width * 3;
+    return button_width > 0 && titlebar_height > 0 &&
+           point.x >= window_rect.left && point.x < button_area_left &&
+           point.y >= window_rect.top && point.y < window_rect.top + titlebar_height;
+  }
+
+  bool send_wechat_titlebar_action(HWND root_window, wechat_titlebar_action_e action) {
+    switch (action) {
+      case wechat_titlebar_action_e::minimize:
+        return ShowWindowAsync(root_window, SW_MINIMIZE) != FALSE;
+      case wechat_titlebar_action_e::maximize_or_restore:
+        return ShowWindowAsync(root_window, IsZoomed(root_window) ? SW_RESTORE : SW_MAXIMIZE) != FALSE;
+      case wechat_titlebar_action_e::close:
+        return PostMessageW(root_window, WM_CLOSE, 0, 0) != FALSE;
+      case wechat_titlebar_action_e::none:
+        return false;
+    }
+    return false;
+  }
