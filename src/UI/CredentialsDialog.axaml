<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoonlightHub.UI.CredentialsDialog"
        Title="Sunshine Web 凭据" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        CanResize="False" Icon="/Assets/app.ico">
    <StackPanel Margin="22">
        <TextBlock x:Name="HeaderText" Classes="h2" />
        <TextBlock Classes="muted" Margin="0,6,0,12"
                   Text="配对、读取客户端列表等操作需要通过 Sunshine 的 Web 接口认证。可以输入已有的用户名/密码（本机 DPAPI 加密保存），也可以让 Hub 直接在 Sunshine 里重置一组新凭据（会短暂重启该实例）。" />
        <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto">
            <TextBlock Text="用户名" Classes="muted" VerticalAlignment="Center" />
            <TextBox x:Name="UserBox" Grid.Column="1" Margin="0,3" />
            <TextBlock Grid.Row="1" Text="密码" Classes="muted" VerticalAlignment="Center" />
            <TextBox x:Name="PassBox" Grid.Row="1" Grid.Column="1" Margin="0,3" PasswordChar="●" />
        </Grid>
        <CheckBox x:Name="ResetBox" Content="在 Sunshine 中重置为以上凭据（sunshine --creds）" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Click="Cancel_Click" Classes="ghost" />
            <Button Content="保存" Click="Ok_Click" Classes="primary" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
