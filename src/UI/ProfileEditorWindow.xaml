<Window x:Class="MoonlightHub.UI.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑方案" Width="760" Height="640" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}" ResizeMode="CanResize">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Click="Cancel_Click" Style="{StaticResource GhostButton}" />
            <Button Content="保存方案" Click="Save_Click" Style="{StaticResource PrimaryButton}" Margin="0" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="名称" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,3" />
                    <TextBlock Grid.Row="1" Text="说明" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBox x:Name="DescBox" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                    <TextBlock Grid.Row="2" Text="模式" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ModeBox" Grid.Row="2" Grid.Column="1" Margin="0,3" SelectionChanged="Mode_Changed" />
                    <TextBlock Grid.Row="3" Text="合成刷新率" Style="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="0 = 与虚拟屏刷新率相同；填 120 可让虚拟屏以 120Hz 合成而串流仍按客户端帧率，降低画面陈旧度" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                        <TextBox x:Name="ComposeBox" Width="80" />
                        <TextBlock Text="Hz（0 = 跟随虚拟屏刷新率；例如 120 可减少约 4ms 平均采样延迟）" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="KeepMainBox" Content="「仅主屏」模式下保留实例 1 串流主屏" Margin="0,10,0,0" />
                <CheckBox x:Name="MatchFpsBox" Content="自动把虚拟屏刷新率切换为客户端请求的帧率（需存在对应模式，例如 2000×1200@90）" Margin="0,4,0,0" />
                <CheckBox x:Name="RememberPosBox" Content="记住在 Windows 显示设置里手动摆放的虚拟屏位置" Margin="0,4,0,0" />
                <CheckBox x:Name="MatchResBox" Content="自动把虚拟屏分辨率设为客户端请求的分辨率（竖屏请求在开启预旋转时自动转为横屏，如 1200×2000 → 2000×1200）" Margin="0,4,0,0" />
                <CheckBox x:Name="IdleOffBox" Content="没有 Moonlight 连接时自动关闭副屏（保持已连接但停用；客户端连接时由 Sunshine 自动启用，断开 3 秒后还原）" Margin="0,4,0,0" />
                <TextBlock x:Name="ModeHint" Style="{StaticResource Muted}" Margin="0,8,0,0" />

                <DockPanel Margin="0,18,0,8">
                    <Button DockPanel.Dock="Right" Content="添加虚拟屏" Click="AddVd_Click" Style="{StaticResource GhostButton}" Margin="0" />
                    <TextBlock Text="虚拟屏" Style="{StaticResource H2}" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel x:Name="VdPanel" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
