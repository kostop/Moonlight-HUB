<Window x:Class="MoonlightHub.UI.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sunshine Web 凭据" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}" ResizeMode="NoResize">
    <StackPanel Margin="22">
        <TextBlock x:Name="HeaderText" Style="{StaticResource H2}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,12"
                   Text="配对、读取客户端列表等操作需要通过 Sunshine 的 Web 接口认证。可以输入已有的用户名/密码（本机 DPAPI 加密保存），也可以让 Hub 直接在 Sunshine 里重置一组新凭据（会短暂重启该实例）。" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="用户名" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <TextBox x:Name="UserBox" Grid.Column="1" Margin="0,3" />
            <TextBlock Grid.Row="1" Text="密码" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <PasswordBox x:Name="PassBox" Grid.Row="1" Grid.Column="1" Margin="0,3" />
        </Grid>
        <CheckBox x:Name="ResetBox" Content="在 Sunshine 中重置为以上凭据（sunshine --creds）" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Click="Cancel_Click" Style="{StaticResource GhostButton}" />
            <Button Content="保存" Click="Ok_Click" Style="{StaticResource PrimaryButton}" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
