<Window x:Class="MoonlightHub.UI.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moonlight 配对" Width="480" SizeToContent="Height" WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}" ResizeMode="NoResize" ShowInTaskbar="True">
    <Border Padding="24">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                    <TextBlock Text="&#xE8AF;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Text="有新的 Moonlight 客户端请求配对" Style="{StaticResource H2}" />
                    <TextBlock x:Name="DetailText" Style="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="请输入平板/手机 Moonlight 上显示的 4 位 PIN：" Margin="0,18,0,8" />
            <TextBox x:Name="PinBox" MaxLength="4" FontSize="34" FontWeight="SemiBold" HorizontalContentAlignment="Center" Padding="10" KeyDown="PinBox_KeyDown" TextChanged="PinBox_TextChanged" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="客户端名称" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox x:Name="NameBox" Width="240" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,14,0,0" Text="" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Click="Cancel_Click" Style="{StaticResource GhostButton}" />
                <Button x:Name="PairButton" Content="配对" Click="Pair_Click" Style="{StaticResource PrimaryButton}" Margin="0" MinWidth="110" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
