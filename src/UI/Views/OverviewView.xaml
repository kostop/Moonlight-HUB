<UserControl x:Class="MoonlightHub.UI.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MoonlightHub.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="显示方案" Style="{StaticResource H2}" Margin="0,4,0,10" />
            <WrapPanel x:Name="ProfilesPanel" Margin="0,0,0,8" />

            <UniformGrid Columns="4" Margin="-7,0,-7,14">
                <Border Style="{StaticResource Card}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="虚拟副屏" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="TileVdd" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,2" />
                        <TextBlock x:Name="TileVddSub" Text="" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="Sunshine 实例" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="TileInstances" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,2" />
                        <TextBlock x:Name="TileInstancesSub" Text="" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="客户端连接" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="TileClients" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,2" />
                        <TextBlock x:Name="TileClientsSub" Text="" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="守护状态" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="TileWatchdog" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,2" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TileWatchdogSub" Text="" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="显示布局详情" Style="{StaticResource GhostButton}" Click="GoDisplays_Click" Margin="0" />
                            <TextBlock Text="当前桌面布局" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ui:DisplayCanvas x:Name="LayoutCanvas" Height="260" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="全部日志" Style="{StaticResource GhostButton}" Click="GoLogs_Click" Margin="0" />
                            <TextBlock Text="最近动态" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl x:Name="Activity" Height="260">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Muted}" Width="60" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding Message}" FontSize="12" Width="330" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Message}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
