<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MoonlightHub.UI.Views.ClientsView">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Text="在 Moonlight 里添加这台电脑" Classes="h2" />
                    <TextBlock Classes="muted" Margin="0,4,0,8" TextWrapping="Wrap"
                               Text="每块虚拟副屏对应一个独立的 Sunshine 实例（不同端口）。实例 1 使用默认端口，直接输入 IP 即可；其他实例要在 Moonlight「手动添加电脑」里输入 IP:端口。每台平板/手机配对到自己的实例后，就能同时连接、各自显示一块副屏。" />
                    <StackPanel x:Name="AddressPanel" />
                </StackPanel>
            </Border>
            <TextBlock Text="Sunshine 实例" Classes="h2" Margin="0,4,0,10" />
            <StackPanel x:Name="InstancePanel" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
