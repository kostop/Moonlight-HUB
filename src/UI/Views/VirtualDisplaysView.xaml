<UserControl x:Class="MoonlightHub.UI.Views.VirtualDisplaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="RestartAdapterBtn" Content="重启适配器 (需管理员)" Style="{StaticResource GhostButton}" Click="RestartAdapter_Click" ToolTip="当驱动进入错误状态（设备管理器里 Parsec Virtual Display Adapter 带感叹号）时用这个恢复" />
                        <Button x:Name="OpenBtn" Content="连接驱动" Style="{StaticResource GhostButton}" Click="Open_Click" />
                        <Button Content="添加虚拟屏" Style="{StaticResource PrimaryButton}" Click="Add_Click" />
                        <Button Content="全部移除" Style="{StaticResource DangerButton}" Click="RemoveAll_Click" Margin="0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Parsec Virtual Display Driver" Style="{StaticResource H2}" />
                        <TextBlock x:Name="DriverText" Style="{StaticResource Muted}" Margin="0,4,0,0" Text="—" />
                        <TextBlock x:Name="PingText" Style="{StaticResource Muted}" Text="" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Text="驱动要求每 100ms 内收到一次 keep-alive，否则会自动移除所有虚拟屏（这就是旧脚本里副屏几秒后消失的原因）。只要本程序在运行，虚拟屏就会一直保持。" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="当前虚拟屏" Style="{StaticResource H2}" Margin="0,4,0,10" />
            <StackPanel x:Name="List" />

            <Border Style="{StaticResource Card}" Margin="0,6,0,14">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox x:Name="ModeW" Width="70" Text="2000" ToolTip="宽度" />
                            <TextBlock Text="×" VerticalAlignment="Center" Margin="6,0" />
                            <TextBox x:Name="ModeH" Width="70" Text="1200" ToolTip="高度" />
                            <TextBlock Text="@" VerticalAlignment="Center" Margin="6,0" />
                            <TextBox x:Name="ModeHz" Width="60" Text="120" ToolTip="刷新率" />
                            <Button Content="注册模式 (需管理员)" Style="{StaticResource GhostButton}" Click="AddMode_Click" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="自定义分辨率 / 刷新率" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,8"
                               Text="Parsec 驱动内置 1920×1080 等常见模式；平板的 2000×1200 需要作为自定义模式写入注册表 HKLM\SOFTWARE\Parsec\vdd。应用方案时如果缺少模式会自动请求注册。驱动只在虚拟屏重新插拔时读取这张表：注册或删除模式后，Hub 会自动重新插拔空闲的虚拟屏；正在串流的虚拟屏等客户端断开后再处理。" />
                    <StackPanel x:Name="ModesPanel" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="降低虚拟屏延迟的建议" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="• 虚拟屏刷新率与 Moonlight 串流帧率保持一致（60 fps ↔ 60 Hz），避免 90 Hz 屏配 60 fps 造成的采样抖动；方案编辑器里的「合成刷新率」可以把虚拟屏提高到 120 Hz，让 DWM 每 8ms 合成一次，Sunshine 抓到的画面更新鲜（GPU 负载略增）。" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="• 每个实例的 dd_configuration_option 已固定为 disabled：显示拓扑由本程序在连接前准备好，Sunshine 不再在每次连接时切换显示器，连接更快也更稳。" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="• 虚拟屏分辨率与平板一致 (2000×1200) 可避免缩放；「仅副屏」方案只保留虚拟屏，DWM 无需同时合成物理屏。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
