<UserControl x:Class="MoonlightHub.UI.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="平板 / USB 网络" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10" Text="调用文件夹里原有的 PowerShell 脚本（需要 ADB 连接平板）。" />
                    <WrapPanel>
                        <Button x:Name="UsbToggleBtn" Content="切换 USB 网络 / Wi-Fi 模式" Click="UsbToggle_Click" />
                        <Button x:Name="UsbRepairBtn" Content="修复当前模式并重连 Moonlight" Click="UsbRepair_Click" />
                        <Button x:Name="UsbCheckBtn" Content="检查当前模式" Click="UsbCheck_Click" Style="{StaticResource GhostButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="触摸 / Deskflow" Style="{StaticResource H2}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="TouchOnBtn" Content="启用触摸隔离" Click="TouchOn_Click" />
                        <Button x:Name="TouchOffBtn" Content="停用触摸隔离" Click="TouchOff_Click" Style="{StaticResource GhostButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="旧的自启动任务" Style="{StaticResource H2}" />
                    <TextBlock x:Name="LegacyText" Style="{StaticResource Muted}" Margin="0,4,0,10" Text="—" />
                    <WrapPanel>
                        <Button Content="接管：禁用旧任务并停止旧 Sunshine" Click="TakeOver_Click" Style="{StaticResource PrimaryButton}" />
                        <Button Content="恢复旧任务（回退）" Click="Restore_Click" Style="{StaticResource DangerButton}" />
                        <Button Content="查看任务状态" Click="Tasks_Click" Style="{StaticResource GhostButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="快捷打开" Style="{StaticResource H2}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="脚本目录" Click="OpenScripts_Click" Style="{StaticResource GhostButton}" />
                        <Button Content="Sunshine 目录" Click="OpenSunshine_Click" Style="{StaticResource GhostButton}" />
                        <Button Content="Sunshine 实例 1 Web 界面" Click="OpenWeb_Click" Style="{StaticResource GhostButton}" />
                        <Button Content="ParsecVDisplay 应用" Click="OpenParsec_Click" Style="{StaticResource GhostButton}" />
                        <Button Content="Hub 数据目录" Click="OpenData_Click" Style="{StaticResource GhostButton}" />
                        <Button Content="Windows 显示设置" Click="OpenDisplaySettings_Click" Style="{StaticResource GhostButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="诊断" Style="{StaticResource H2}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="导出诊断报告" Click="Diag_Click" Style="{StaticResource GhostButton}" />
                    </WrapPanel>
                    <TextBox x:Name="Output" Margin="0,10,0,0" Height="220" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
