<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MoonlightHub.UI.Views.ToolsView">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Text="平板 / USB 网络" Classes="h2" />
                    <TextBlock Classes="muted" Margin="0,4,0,10" TextWrapping="Wrap" Text="调用文件夹里原有的 PowerShell 脚本（需要 ADB 连接平板）。" />
                    <WrapPanel>
                        <Button x:Name="UsbToggleBtn" Content="切换 USB 网络 / Wi-Fi 模式" Click="UsbToggle_Click" />
                        <Button x:Name="UsbRepairBtn" Content="修复当前模式并重连 Moonlight" Click="UsbRepair_Click" />
                        <Button x:Name="UsbCheckBtn" Content="检查当前模式" Click="UsbCheck_Click" Classes="ghost" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Text="触摸 / Deskflow" Classes="h2" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="TouchOnBtn" Content="启用触摸隔离" Click="TouchOn_Click" />
                        <Button x:Name="TouchOffBtn" Content="停用触摸隔离" Click="TouchOff_Click" Classes="ghost" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Text="旧的自启动任务" Classes="h2" />
                    <TextBlock x:Name="LegacyText" Classes="muted" Margin="0,4,0,10" TextWrapping="Wrap" Text="—" />
                    <WrapPanel>
                        <Button Content="接管：禁用旧任务并停止旧 Sunshine" Click="TakeOver_Click" Classes="primary" />
                        <Button Content="恢复旧任务（回退）" Click="Restore_Click" Classes="danger" />
                        <Button Content="查看任务状态" Click="Tasks_Click" Classes="ghost" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Text="系统" Classes="h2" />
                    <TextBlock x:Name="FastStartupText" Classes="muted" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="Windows「快速启动」会在关机时把内核休眠：Parsec 适配器如果在关机前已经异常，下次开机后仍然异常（Hub 启动时会自动重启它）。关闭快速启动后每次开机都是干净的驱动状态，代价是开机慢几秒。" />
                    <WrapPanel>
                        <Button x:Name="FastStartupBtn" Content="关闭快速启动" Click="FastStartup_Click" Classes="ghost" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Text="快捷打开" Classes="h2" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="脚本目录" Click="OpenScripts_Click" Classes="ghost" />
                        <Button Content="Sunshine 目录" Click="OpenSunshine_Click" Classes="ghost" />
                        <Button Content="Sunshine 实例 1 Web 界面" Click="OpenWeb_Click" Classes="ghost" />
                        <Button Content="ParsecVDisplay 应用" Click="OpenParsec_Click" Classes="ghost" />
                        <Button Content="Hub 数据目录" Click="OpenData_Click" Classes="ghost" />
                        <Button Content="Windows 显示设置" Click="OpenDisplaySettings_Click" Classes="ghost" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Text="诊断" Classes="h2" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="导出诊断报告" Click="Diag_Click" Classes="ghost" />
                    </WrapPanel>
                    <TextBox x:Name="Output" Classes="mono" Margin="0,10,0,0" Height="220" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
