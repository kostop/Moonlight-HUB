<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:MoonlightHub.UI"
             x:Class="MoonlightHub.UI.Views.OverviewView">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="OverviewRoot" RowDefinitions="Auto,14,*,14,Auto" Height="760">
            <UniformGrid x:Name="StatusTiles" Columns="4" Margin="-6,0,-6,-8">
                <Border Classes="card" Margin="6,0,6,8" Padding="18" MinHeight="112">
                    <StackPanel>
                        <TextBlock Text="虚拟副屏" Classes="muted" />
                        <TextBlock x:Name="TileVdd" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,4" />
                        <TextBlock x:Name="TileVddSub" Text="" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="6,0,6,8" Padding="18" MinHeight="112">
                    <StackPanel>
                        <TextBlock Text="Sunshine 实例" Classes="muted" />
                        <TextBlock x:Name="TileInstances" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,4" />
                        <TextBlock x:Name="TileInstancesSub" Text="" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="6,0,6,8" Padding="18" MinHeight="112">
                    <StackPanel>
                        <TextBlock Text="客户端连接" Classes="muted" />
                        <TextBlock x:Name="TileClients" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,4" />
                        <TextBlock x:Name="TileClientsSub" Text="" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="6,0,6,8" Padding="18" MinHeight="112">
                    <StackPanel>
                        <TextBlock Text="守护状态" Classes="muted" />
                        <TextBlock x:Name="TileWatchdog" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,4" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TileWatchdogSub" Text="" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Classes="card" Margin="0" Padding="18">
                <Grid RowDefinitions="Auto,*">
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="调整布局" Classes="ghost" Click="GoDisplays_Click" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="当前桌面布局" Classes="h2" VerticalAlignment="Center" />
                            <TextBlock x:Name="LayoutSummary" Text="正在读取屏幕布局…" Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ui:DisplayCanvas Grid.Row="1" x:Name="LayoutCanvas" MinHeight="220" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Classes="card" Margin="0" Padding="18">
                <Grid RowDefinitions="Auto,Auto">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="全部日志" Classes="ghost" Click="GoLogs_Click" Margin="12,0,0,0" />
                        <TextBlock Text="最近动态" Classes="h2" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" MaxHeight="174" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Activity" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="64,50,*" Margin="0,0,0,9">
                                        <TextBlock Text="{Binding TimeText}" Classes="muted" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding LevelText}" Classes="muted" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" x:Name="ActivityEmpty" Text="暂无最近动态" Classes="muted" Margin="0,12,0,4" IsVisible="False" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
