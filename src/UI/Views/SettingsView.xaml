<UserControl x:Class="MoonlightHub.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="方案管理" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10" Text="每个方案定义虚拟屏数量、分辨率/刷新率、摆放位置以及由哪个 Sunshine 实例串流。" />
                    <StackPanel x:Name="ProfilesPanel" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="新建方案" Click="NewProfile_Click" Style="{StaticResource PrimaryButton}" />
                        <Button Content="恢复默认方案" Click="ResetProfiles_Click" Style="{StaticResource GhostButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Sunshine 实例" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10" Text="实例 1 沿用原来的配置目录和已配对客户端；其他实例在 instances 目录下各自保存配置、证书和日志。修改端口后需要在 Moonlight 里重新添加。" />
                    <StackPanel x:Name="InstancesPanel" />
                    <Button Content="添加实例" Click="AddInstance_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="路径" Style="{StaticResource H2}" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="sunshine.exe" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBox x:Name="SunshineExe" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Row="1" Text="实例 1 配置目录" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBox x:Name="Instance1Dir" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Row="2" Text="其他实例根目录" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBox x:Name="InstancesRoot" Grid.Row="2" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Row="3" Text="脚本目录" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBox x:Name="ScriptsDir" Grid.Row="3" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Row="4" Text="ParsecVDisplay.exe" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBox x:Name="ParsecExe" Grid.Row="4" Grid.Column="1" Margin="0,3" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="运行行为" Style="{StaticResource H2}" Margin="0,0,0,8" />
                    <CheckBox x:Name="AutoApply" Content="启动时自动应用上次的方案" />
                    <CheckBox x:Name="WatchdogEnabled" Content="启用守护（自动恢复消失的虚拟屏 / 重启异常的 Sunshine / 睡眠唤醒后复核）" />
                    <CheckBox x:Name="HighPriority" Content="以高优先级运行 Sunshine 进程" />
                    <CheckBox x:Name="CloseToTray" Content="点击关闭按钮时隐藏到托盘" />
                    <CheckBox x:Name="AutoCreds" Content="自动管理 Sunshine Web 凭据（配对不再需要打开 Sunshine 网页；密码可在“客户端”页查看）" />
                    <CheckBox x:Name="AutoPairPrompt" Content="客户端发起配对时自动弹出 PIN 输入框" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="keep-alive 间隔 (ms)" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="PingMs" Width="70" />
                        <TextBlock Text="守护检查间隔 (s)" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,8,0" />
                        <TextBox x:Name="WatchdogSec" Width="70" />
                        <TextBlock Text="启动延迟 (s)" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,8,0" />
                        <TextBox x:Name="StartupDelay" Width="70" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox x:Name="AutoStartBox" Content="开机自动启动 Moonlight Hub（登录后 5 秒最小化到托盘，并自动应用上次方案）" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />
                    </StackPanel>
                    <TextBlock x:Name="AutostartText" Text="开机自启：—" Style="{StaticResource Muted}" Margin="50,2,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="保存设置" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
                <TextBlock x:Name="SaveState" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
