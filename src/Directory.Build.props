<Project>
  <!-- Keep compiler outputs out of the Desktop folder (it is synced by Syncthing); dist/ is the only artifact kept here. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(LOCALAPPDATA)\MoonlightHub\build-worktrees\virtual-scale\src\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(LOCALAPPDATA)\MoonlightHub\build-worktrees\virtual-scale\src\bin\</BaseOutputPath>
  </PropertyGroup>
</Project>
